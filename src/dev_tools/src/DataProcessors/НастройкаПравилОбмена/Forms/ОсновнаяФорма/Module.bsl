#Область ОбработчикиСобытийФормы

&НаСервере
Процедура dev_tools_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Признак заполнил штатный обработчик, отработавший до этого. Форма сохранения
	// работает только с XML-правилами — та же видимость, что у штатной кнопки
	// «Выгрузка конвертации XML».
	Элементы.dev_tools_СохранитьПравилаОбмена.Видимость = Не ЭтоКонвертацияXDTO;
	Элементы.dev_tools_СинхронизироватьПравила.Видимость = Не ЭтоКонвертацияXDTO;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура dev_tools_СохранитьПравилаОбмена(Команда)

	// Штатная проверка базовой формы: сообщает «Не указана конвертация».
	Если Не ПроверитьЗаполненаКонвертация() Тогда
		Возврат;
	КонецЕсли;

	// Без владельца, как штатная кнопка выгрузки XML: окно сохранения живёт
	// независимо от окна настройки правил.
	ОткрытьФорму("Обработка.dev_tools_СохранениеПравилОбмена.Форма",
		Новый Структура("Конвертация", Объект.Конвертация));

КонецПроцедуры

&НаКлиенте
Процедура dev_tools_СинхронизироватьПравила(Команда)

	Если Не ПроверитьЗаполненаКонвертация() Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("Конвертация", Объект.Конвертация);
	Репозитории = dev_tools_СинхронизацияПравилВызовСервера.РепозиторииЕдиницы(Объект.Конвертация);
	Если Репозитории.Количество() = 1 Тогда
		ПараметрыОткрытия.Вставить("Репозиторий", Репозитории[0]);
	КонецЕсли;

	ОткрытьФорму("Обработка.dev_tools_СинхронизацияПравил.Форма", ПараметрыОткрытия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
