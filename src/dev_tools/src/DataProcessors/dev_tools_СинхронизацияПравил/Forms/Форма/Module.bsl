#Область ОбработчикиСобытийЭлементовТаблицыФормыСверка

&НаКлиенте
Процедура СверкаОтметкаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Сверка.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьОтметкуПотомкам(ТекущиеДанные, ТекущиеДанные.Отметка);
	ПересчитатьОтметкиРодителей();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСообщения

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)

	// Ветку могли сменить в git при открытой форме: точка запишет ветку на момент команды.
	ЗаполнитьКаталогПравил();
	Если Не ПараметрыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	Сообщения.Очистить();

	// Каталоги читаются на клиенте до фона: по ним фон решает, нужен ли вопрос, а после
	// подтверждения они же сравниваются с записываемым — второй раз сотни файлов не читаются.
	Подготовленные = Новый Массив;
	Задания = Новый Массив;
	Для Каждого Единица Из ОтмеченныеЕдиницы() Цикл
		// Строка «только в файлах»: единицы в базе нет, снимок базы строить не из чего.
		Если Не ЗначениеЗаполнено(Единица.Ссылка) Тогда
			ДобавитьСообщение("Предупреждение", ПредставлениеЕдиницы(Единица),
				НСтр("ru = 'В базе единицы нет, выгружать нечего'"));
			Продолжить;
		КонецЕсли;
		Существующий = dev_tools_СнимокПравилКлиент.ПрочитатьСнимок(
			КаталогЕдиницы(Единица), Единица.Вид, Единица.Наименование);
		Задания.Добавить(Новый Структура(
			"Репозиторий, Вид, Единица, ИмяКаталога, СнимокДиска, Представление",
			Репозиторий, Единица.Вид, Единица.Ссылка, Единица.ИмяКаталога, Существующий,
			ПредставлениеЕдиницы(Единица)));
		Подготовленные.Добавить(Новый Структура("Единица, Существующий, Снимок, Хеши", Единица, Существующий));
	КонецЦикла;
	Если Задания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = dev_tools_СинхронизацияПравилВызовСервера.НачатьФоновуюОперацию(
		"dev_tools_СинхронизацияПравилФон.ПодготовитьВыгрузку", Задания,
		НСтр("ru = 'Подготовка выгрузки правил в каталог'"), УникальныйИдентификатор);
	ОжидатьФоновуюОперацию(ДлительнаяОперация, "ВыгрузитьПодготовлено", НСтр("ru = 'Подготовка выгрузки…'"),
		Подготовленные);

КонецПроцедуры

&НаКлиенте
Процедура Сверить(Команда)

	// Ветку могли сменить в git при открытой форме: точка запишет ветку на момент команды.
	ЗаполнитьКаталогПравил();
	Если Не ПараметрыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	СброситьСверку();
	Сообщения.Очистить();

	// Каталоги читаются на клиенте: рабочая копия у разработчика, сервер её может не видеть.
	// Снимки уходят заданию значениями: хранилище сеанса формы сеансу задания недоступно.
	Задания = Новый Массив;
	Для Каждого Единица Из ОтмеченныеЕдиницы() Цикл
		Представление = ПредставлениеЕдиницы(Единица);
		Каталог = КаталогЕдиницы(Единица);
		Снимок = dev_tools_СнимокПравилКлиент.ПрочитатьСнимок(Каталог, Единица.Вид, Единица.Наименование);

		// Пустой снимок — каталога на диске нет. Все строки такой единицы получат статус
		// «НетВФайлах», а он по умолчанию не отмечается, поэтому случайная загрузка
		// ничего не удалит.
		Если Снимок.Файлы.Количество() = 0 Тогда
			ДобавитьСообщение("Предупреждение", Представление,
				СтрШаблон(НСтр("ru = 'Каталог единицы не найден: %1'"), Каталог));
		КонецЕсли;

		Задания.Добавить(Новый Структура(
			"Репозиторий, Вид, Единица, ИмяКаталога, СнимокДиска, Ветка, Представление",
			Репозиторий, Единица.Вид, Единица.Ссылка, Единица.ИмяКаталога, Снимок, ТекущаяВетка, Представление));
	КонецЦикла;

	ДлительнаяОперация = dev_tools_СинхронизацияПравилВызовСервера.НачатьФоновуюОперацию(
		"dev_tools_СинхронизацияПравилФон.Сверить", Задания,
		НСтр("ru = 'Сверка правил с каталогом'"), УникальныйИдентификатор);
	ОжидатьФоновуюОперацию(ДлительнаяОперация, "СверитьЗавершение", НСтр("ru = 'Сверка правил…'"), Задания);

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	// Ветку могли сменить в git при открытой форме: точка запишет ветку на момент команды.
	ЗаполнитьКаталогПравил();
	Если Не ПараметрыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	Если ХешиСверки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Сначала выполните сверку'"));
		Возврат;
	КонецЕсли;

	// До вопроса — только дешёвые проверки по уже посчитанным отметкам дерева.
	// Перечитывание снимков и барьер по хешам ждут подтверждения: на реальной
	// конвертации это чтение сотен файлов, и делать его ради отменённого диалога нечего.
	Сводка = dev_tools_СверкаПравил.СводкаЗагрузки(ЗначенияОтмеченных("Статус"));
	Если Сводка.Создать + Сводка.Обновить + Сводка.Пометить = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не отмечено ни одной строки сверки'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ЗагрузитьПодтверждение", ЭтотОбъект);
	Откатов = dev_tools_СверкаПравил.СводкаОткатов(ЗначенияОтмеченных("Происхождение"));
	ПоказатьВопрос(Оповещение, ТекстПодтвержденияЗагрузки(Сводка, Откатов), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПодтверждение(Ответ, ДополнительныеПараметры) Экспорт

	// Отказ сверку не сбрасывает: пользователь поправит отметки и повторит загрузку.
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьЗагрузку();

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПодготовлено(Результат, Подготовленные) Экспорт

	// Отмена или ошибка: на диск ничего не записано — запись идёт после фона.
	Результаты = РезультатФоновойОперации(Результат);
	Если Результаты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НеЗагруженные = Новый Массив;
	Для Индекс = 0 По Результаты.ВГраница() Цикл
		Подготовленная = Подготовленные[Индекс];
		Подготовленная.Снимок = Результаты[Индекс].Снимок;
		Подготовленная.Хеши = Результаты[Индекс].Хеши;
		Если Результаты[Индекс].Пути.Количество() > 0 Тогда
			НеЗагруженные.Добавить(Новый Структура("Единица, Пути",
				ПредставлениеЕдиницы(Подготовленная.Единица), Результаты[Индекс].Пути));
		КонецЕсли;
	КонецЦикла;

	Если НеЗагруженные.Количество() = 0 Тогда
		ВыполнитьВыгрузку(Подготовленные);
		Возврат;
	КонецЕсли;

	// Один вопрос на все единицы: «Отмена» не выгружает ни одну (спека 2026-10-31, §3.4).
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Выгрузить'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьПодтверждение", ЭтотОбъект, Подготовленные);
	ПоказатьВопрос(Оповещение, dev_tools_СверкаПравил.ТекстВопросаВыгрузки(НеЗагруженные), Кнопки, ,
		КодВозвратаДиалога.Отмена);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПодтверждение(Ответ, Подготовленные) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьВыгрузку(Подготовленные);

КонецПроцедуры

&НаКлиенте
Процедура СверитьЗавершение(Результат, Задания) Экспорт

	Ответы = РезультатФоновойОперации(Результат);
	// Отмена или ошибка: дерево не строится; точки единиц, сверенных до отмены, могли
	// обновиться — колонка «Точка» перечитывается.
	Если Ответы = Неопределено Тогда
		ОбновитьТочкиЕдиниц();
		Возврат;
	КонецЕсли;

	// Строки всех единиц собираются в один массив: дерево строится один раз, после
	// обхода, потому что порядок единиц в нём задаёт порядок корневых узлов.
	ВсеСтроки = Новый Массив;
	Для Индекс = 0 По Ответы.ВГраница() Цикл
		Ответ = Ответы[Индекс];
		Представление = Задания[Индекс].Представление;
		СтрокаХеша = ХешиСверки.Добавить();
		СтрокаХеша.Единица = Представление;
		СтрокаХеша.Хеш = Ответ.Хеш;
		Для Каждого СтрокаОтвета Из Ответ.Строки Цикл
			ВсеСтроки.Добавить(Новый Структура("Единица, Путь, Вид, Статус, Файлы, Происхождение",
				Представление, СтрокаОтвета.Путь, СтрокаОтвета.Вид, СтрокаОтвета.Статус,
				СтрСоединить(СтрокаОтвета.Файлы, ", "), СтрокаОтвета.Происхождение));
		КонецЦикла;
		Для Каждого Сообщение Из Ответ.Сообщения Цикл
			ДобавитьСообщение(Сообщение.Уровень, Представление + " " + Сообщение.Объект, Сообщение.Текст);
		КонецЦикла;
	КонецЦикла;

	ЗаполнитьДеревоСверки(ВсеСтроки);

	// Базовая спека §3.6: строки отмечены по умолчанию — но только применяемые.
	// «НетВФайлах» означает пометку правила на удаление, её пользователь отмечает сам.
	// «Применяемые» берут только пришедшее из файлов.
	УстановитьОтметкиСверки("Применяемые");

	// Загрузке без различий нечего применять: доступная кнопка обещала бы действие,
	// которое закончилось бы сообщением «не отмечено ни одной строки».
	Элементы.Загрузить.Доступность = Сверка.ПолучитьЭлементы().Количество() > 0;

	Если Сверка.ПолучитьЭлементы().Количество() = 0 Тогда
		ДобавитьСообщение("Информация", "", НСтр("ru = 'Различий между каталогом и базой нет'"));
	Иначе
		Сводка = dev_tools_СверкаПравил.СводкаЗагрузки(СтатусыВсехСтрок(ВсеСтроки));
		ДобавитьСообщение("Информация", "", СтрШаблон(
			НСтр("ru = 'Новых %1, изменённых %2, нет в файлах %3'"),
			Сводка.Создать, Сводка.Обновить, Сводка.Пометить));
		ДобавитьСообщение("Информация", "", НСтр(
			"ru = '«Выгрузить» пишет базу в файлы и отметок сверки не использует;
			      |«Загрузить» применяет к базе отмеченные строки'"));
	КонецЕсли;
	Если ЕстьНеизвестноеПроисхождение(ВсеСтроки) Тогда
		ДобавитьСообщение("Предупреждение", "", НСтр(
			"ru = 'Для части различий неизвестно, какая сторона изменилась, — отметьте их вручную;
			      |после загрузки или выгрузки они станут известны'"));
	КонецЕсли;

	ОбновитьТочкиЕдиниц();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗавершение(РезультатОперации, ДополнительныеПараметры) Экспорт

	Результаты = РезультатФоновойОперации(РезультатОперации);
	Если Результаты = Неопределено Тогда
		// Каждая единица — своя транзакция: загруженные до отмены или ошибки задания остаются
		// загруженными, прерванная откатывается целиком (спека 2026-10-31-background-operations, §2.3).
		// Текст ошибки задания уже в списке сообщений — его пишет РезультатФоновойОперации.
		Если РезультатОперации = Неопределено Тогда
			ДобавитьСообщение("Предупреждение", "",
				НСтр("ru = 'Загрузка отменена; часть единиц могла загрузиться — выполните сверку'"));
		Иначе
			ДобавитьСообщение("Предупреждение", "",
				НСтр("ru = 'Загрузка прервана ошибкой; часть единиц могла загрузиться — выполните сверку'"));
		КонецЕсли;
		ОбновитьСписокЕдиниц();
		СброситьСверку();
		ОбновитьТочкиЕдиниц();
		Возврат;
	КонецЕсли;

	ЗакрепленыЕдиницы = Ложь;
	Для Индекс = 0 По Результаты.ВГраница() Цикл
		Результат = Результаты[Индекс];
		Единица = ДополнительныеПараметры.Отмеченные[Индекс];
		Представление = ДополнительныеПараметры.Задания[Индекс].Представление;
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			ДобавитьСообщение(Сообщение.Уровень, Представление + " " + Сообщение.Объект, Сообщение.Текст);
		КонецЦикла;
		Если Результат.Успешно Тогда
			ДобавитьСообщение("Информация", Представление,
				СтрШаблон(НСтр("ru = 'Загружено: создано %1, обновлено %2, удалено %3'"),
					Результат.Создано, Результат.Обновлено, Результат.Удалено));
			// Незакреплённая единица — созданная из каталога или найденная по наименованию —
			// закрепляется под каталогом, из которого загружена (спека 2026-10-21, §3.2):
			// иначе после переименования в базе она потеряла бы связь с каталогом.
			Если Не Единица.Закреплена Тогда
				ПричинаОтказа = dev_tools_СинхронизацияПравилВызовСервера.ЗакрепитьЕдиницу(
					Репозиторий, Результат.Единица, Единица.ИмяКаталога);
				Если Не ПустаяСтрока(ПричинаОтказа) Тогда
					ДобавитьСообщение("Предупреждение", Представление, ПричинаОтказа);
				КонецЕсли;
				ЗакрепленыЕдиницы = Истина;
			КонецЕсли;
		Иначе
			// Каждая единица грузится своей транзакцией: отказ одной не откатывает уже загруженные.
			ДобавитьСообщение("Ошибка", Представление, НСтр("ru = 'Загрузка единицы отменена, её данные не изменены'"));
		КонецЕсли;
	КонецЦикла;

	// Строки «только в файлах» стали единицами базы, незакреплённые — закреплёнными:
	// таблица иначе показывала бы их без ссылки и без закрепления.
	Если ЗакрепленыЕдиницы Тогда
		ОбновитьСписокЕдиниц();
	КонецЕсли;
	СброситьСверку();
	ОбновитьТочкиЕдиниц();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	// Явное обновление снимает одноразовую отметку по параметру открытия: иначе команда
	// молча возвращала бы отметки к конвертации параметра, затирая выбор пользователя.
	// Сбрасывается до заполнения, чтобы оно отметило всё.
	КонвертацияПараметра = ПредопределенноеЗначение("Справочник.Конвертации.ПустаяСсылка");
	// Ветку могли сменить в git при открытой форме: без перечитывания смена не будет замечена.
	ЗаполнитьКаталогПравил();
	ОбновитьСписокЕдиниц();
	СброситьСверку();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонвертацию(Команда)

	// Только XML-конвертации: XDTO вне рамок инструмента.
	ПараметрыВыбораКонвертации = Новый Структура;
	ПараметрыВыбораКонвертации.Вставить("Отбор", Новый Структура("ТипКонвертации",
		ПредопределенноеЗначение("Перечисление.ТипыКонвертаций.XML")));
	ВыбратьЕдиницу("Справочник.Конвертации.ФормаВыбора", ПараметрыВыбораКонвертации);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРегистрацию(Команда)

	ВыбратьЕдиницу("Справочник.Регистрации.ФормаВыбора", Новый Структура);

КонецПроцедуры

&НаКлиенте
Процедура ВыборЕдиницыЗавершение(Единица, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Единица) Тогда
		Возврат;
	КонецЕсли;

	// Фасад отвечает отказом и на то, что форма выбора пропустить не должна была:
	// проверки у него свои, потому что ту же табличную часть правят и мимо этой формы.
	ПричинаОтказа = dev_tools_СинхронизацияПравилВызовСервера.ЗакрепитьЕдиницу(Репозиторий, Единица);
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ПричинаОтказа);
		Возврат;
	КонецЕсли;

	ОбновитьСписокЕдиниц();
	СброситьСверку();

КонецПроцедуры

&НаКлиенте
Процедура УбратьИзРепозитория(Команда)

	ТекущиеДанные = Элементы.Единицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ТекущиеДанные.Закреплена Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выберите строку, закреплённую за репозиторием'"));
		Возврат;
	КонецЕсли;

	dev_tools_СинхронизацияПравилВызовСервера.ОткрепитьЕдиницу(Репозиторий, ТекущиеДанные.Ссылка);
	ОбновитьСписокЕдиниц();
	СброситьСверку();

КонецПроцедуры

&НаКлиенте
Процедура Связать(Команда)

	СтрокаБазы = Неопределено;
	СтрокаФайлов = Неопределено;
	Если Не ВыделеныСтрокиДляСвязи(СтрокаБазы, СтрокаФайлов) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выделите две строки одного вида: единицу «Только в базе» и каталог «Только в файлах»'"));
		Возврат;
	КонецЕсли;

	ПричинаОтказа = dev_tools_СинхронизацияПравилВызовСервера.СвязатьЕдиницу(
		Репозиторий, СтрокаБазы.Ссылка, СтрокаФайлов.Вид, СтрокаФайлов.ИмяКаталога);
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ПричинаОтказа);
		Возврат;
	КонецЕсли;

	ОбновитьСписокЕдиниц();
	СброситьСверку();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьОтметки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьОтметки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьПрименяемые(Команда)

	УстановитьОтметкиСверки("Применяемые");

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеРазличия(Команда)

	УстановитьОтметкиСверки("Все");

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеРазличия(Команда)

