#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РепозиторийПараметра = Неопределено;
	Если Параметры.Свойство("Репозиторий", РепозиторийПараметра)
		И ЗначениеЗаполнено(РепозиторийПараметра) Тогда
		Репозиторий = РепозиторийПараметра;
	КонецЕсли;

	КонвертацияИзПараметров = Неопределено;
	Если Параметры.Свойство("Конвертация", КонвертацияИзПараметров) Тогда
		КонвертацияПараметра = КонвертацияИзПараметров;
	КонецЕсли;

	// Спека §3.5: за конвертацией закреплено ноль или больше одного репозитория — настройка
	// правил обмена репозиторий не передаёт, и форма открывается на сохранённом в настройках.
	// Без сообщения это выглядит так, будто кнопка открыла не ту конвертацию.
	Если ЗначениеЗаполнено(КонвертацияПараметра) И Не ЗначениеЗаполнено(Репозиторий) Тогда
		Сообщение = Сообщения.Добавить();
		Сообщение.Уровень = "Информация";
		Сообщение.Текст = СтрШаблон(
			НСтр("ru = 'Выберите репозиторий для конвертации «%1»'"), КонвертацияПараметра);
	КонецЕсли;

	Элементы.Загрузить.Доступность = Ложь;
	Элементы.УбратьИзРепозитория.Доступность = Ложь;

	// Смена ветки после точки подсвечивает колонку «Точка» (спека 2026-10-31, §3.4).
	Оформление = УсловноеОформление.Элементы.Добавить();
	ПолеОформления = Оформление.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЕдиницыТочка.Имя);
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Единицы.ВеткаСменилась");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	// Репозиторий из параметра открытия имеет приоритет над сохранённым в настройках:
	// настройки применяются после ПриСозданииНаСервере и иначе затёрли бы параметр.
	Если ЗначениеЗаполнено(Репозиторий) Тогда
		Настройки.Удалить("Репозиторий");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьКаталогПравил();
	ОбновитьСписокЕдиниц();

КонецПроцедуры

#КонецОбласти

