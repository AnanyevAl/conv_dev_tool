КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКаталог(Команда)

	Если Не РепозиторийГотов() Тогда
		Возврат;
	КонецЕсли;
	НачатьЗапускПриложения(Неопределено, КаталогПравил);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПараметрыЗаполнены()

	Если Не РепозиторийГотов() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОтмеченныеЕдиницы().Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отметьте хотя бы одну единицу'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Репозиторий выбран и у него заполнен каталог рабочей копии. Без каталога собранный
// путь правил получился бы корнеотносительным ("\src") — такой путь указывает
// на текущий диск, и ни сканировать его, ни писать в него нельзя.
&НаКлиенте
Функция РепозиторийГотов()

	Если Не ЗначениеЗаполнено(Репозиторий) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите репозиторий'"));
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(КаталогПравил) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'У репозитория не заполнен каталог рабочей копии'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Только отмеченные строки таблицы единиц — по ним работают все три команды.
// У строки «только в файлах» Ссылка не заполнена (Неопределено).
&НаКлиенте
Функция ОтмеченныеЕдиницы()

	Отмеченные = Новый Массив;
	Для Каждого СтрокаЕдиницы Из Единицы Цикл
		Если Не СтрокаЕдиницы.Отметка Тогда
			Продолжить;
		КонецЕсли;
		Отмеченные.Добавить(Новый Структура("Вид, Ссылка, Наименование, ИмяКаталога, Закреплена",
			СтрокаЕдиницы.Вид, СтрокаЕдиницы.Ссылка, СтрокаЕдиницы.Наименование,
			СтрокаЕдиницы.ИмяКаталога, СтрокаЕдиницы.Закреплена));
	КонецЦикла;

	Возврат Отмеченные;

КонецФункции

&НаКлиенте
Процедура ВыполнитьВыгрузку(Подготовленные)

	ЗакрепленыЕдиницы = Ложь;
	Для Каждого Подготовленная Из Подготовленные Цикл
		Единица = Подготовленная.Единица;
		Итог = dev_tools_СнимокПравилКлиент.ЗаписатьСнимок(КаталогЕдиницы(Единица), Подготовленная.Снимок,
			Подготовленная.Существующий);
		ДобавитьСообщение("Информация", ПредставлениеЕдиницы(Единица),
			СтрШаблон(НСтр("ru = 'Выгружено: записано файлов %1, удалено %2, без изменений %3'"),
				Итог.Записано, Итог.Удалено, Итог.БезИзменений));

		ПричинаОтказа = dev_tools_СинхронизацияПравилВызовСервера.ЗафиксироватьВыгрузку(
			Репозиторий, Единица.Ссылка, Единица.ИмяКаталога, Подготовленная.Хеши, ТекущаяВетка);
		Если Не ПустаяСтрока(ПричинаОтказа) Тогда
			ДобавитьСообщение("Предупреждение", ПредставлениеЕдиницы(Единица), ПричинаОтказа);
		КонецЕсли;

		// Спека 2026-10-21, §3.2: строке, закреплённой до появления ИмяКаталога, имя
		// записывается первой выгрузкой (у остальных вызов ничего не пишет); незакреплённая
		// единица, найденная по наименованию, закрепляется под каталогом, в который выгружена.
		Если Единица.Закреплена Тогда
			ПричинаОтказа = dev_tools_СинхронизацияПравилВызовСервера.СвязатьЕдиницу(
				Репозиторий, Единица.Ссылка, Единица.Вид, Единица.ИмяКаталога);
		Иначе
			ПричинаОтказа = dev_tools_СинхронизацияПравилВызовСервера.ЗакрепитьЕдиницу(
				Репозиторий, Единица.Ссылка, Единица.ИмяКаталога);
			ЗакрепленыЕдиницы = Истина;
		КонецЕсли;
		Если Не ПустаяСтрока(ПричинаОтказа) Тогда
			ДобавитьСообщение("Предупреждение", ПредставлениеЕдиницы(Единица), ПричинаОтказа);
		КонецЕсли;
	КонецЦикла;

	// Закреплённые строки иначе показывались бы незакреплёнными до ручного обновления списка.
	Если ЗакрепленыЕдиницы Тогда
		ОбновитьСписокЕдиниц();
	КонецЕсли;
	СброситьСверку();
	ОбновитьТочкиЕдиниц();

КонецПроцедуры

// Дорогая часть загрузки: перечитывание снимков, барьер по хешам и запись в базу.
// Выполняется после подтверждения пользователя — логика та же, что была в команде.
&НаКлиенте
Процедура ВыполнитьЗагрузку()

	Отмеченные = ОтмеченныеЕдиницы();
	Снимки = ПроверенныеСнимки(Отмеченные);
	Если Снимки = Неопределено Тогда
		СброситьСверку();
		Возврат;
	КонецЕсли;

	Задания = Новый Массив;
	Для Индекс = 0 По Отмеченные.ВГраница() Цикл
		Единица = Отмеченные[Индекс];
		Представление = ПредставлениеЕдиницы(Единица);
		Задание = Новый Структура(
			"Репозиторий, Вид, Единица, ИмяКаталога, СнимокДиска, Ветка, Представление, ОтмеченныеПути",
			Репозиторий, Единица.Вид, Единица.Ссылка, Единица.ИмяКаталога, Снимки[Индекс], ТекущаяВетка,
			Представление, ОтмеченныеПути(Представление));
		Задания.Добавить(Задание);
	КонецЦикла;

	ДлительнаяОперация = dev_tools_СинхронизацияПравилВызовСервера.НачатьФоновуюОперацию(
		"dev_tools_СинхронизацияПравилФон.Загрузить", Задания,
		НСтр("ru = 'Загрузка правил из каталога'"), УникальныйИдентификатор);
	ОжидатьФоновуюОперацию(ДлительнаяОперация, "ЗагрузитьЗавершение", НСтр("ru = 'Загрузка правил…'"),
		Новый Структура("Задания, Отмеченные", Задания, Отмеченные));

КонецПроцедуры

// Строка про удаление показывается только когда такие объекты есть: иначе вопрос
// превращается в формальность, которую прокликивают не читая.
&НаКлиенте
Функция ТекстПодтвержденияЗагрузки(Сводка, Откатов)

	Текст = СтрШаблон(НСтр("ru = 'Будет изменено в базе:
		|  создано объектов: %1
		|  обновлено: %2'"), Сводка.Создать, Сводка.Обновить);

	Если Сводка.Пометить > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = '  помечено на удаление: %1
			    |
			    |Правила, помеченные на удаление, исключаются из состава конвертации.'"),
			Сводка.Пометить);
	КонецЕсли;

	// Абзац только когда такие строки есть — то же правило, что для строки про удаление.
	Если Откатов > 0 Тогда
		Текст = Текст + Символы.ПС + Символы.ПС + СтрШаблон(
			НСтр("ru = '  откатит правки, сделанные в базе: %1
			    |  (объекты изменены в базе после последней синхронизации;
			    |   загрузка заменит их версией из файлов)'"),
			Откатов);
	КонецЕсли;

	Возврат Текст + Символы.ПС + Символы.ПС + НСтр("ru = 'Продолжить загрузку?'");

КонецФункции

// Снимки с диска для отмеченных единиц — или Неопределено, если барьер не пройден.
// Заданию загрузки уходят ровно те снимки, хеш которых проверен здесь.
//
// Барьер против затирания правок в базе файлами, изменившимися после сверки, держится
// по каждой единице отдельно: снятие отметки между «Сверить» и «Загрузить» не должно
// выглядеть изменением файлов, но каждая загружаемая единица обязана иметь хеш со сверки
// и совпасть с ним.
&НаКлиенте
Функция ПроверенныеСнимки(Отмеченные)

	Снимки = Новый Массив;
	Для Каждого Единица Из Отмеченные Цикл
		Представление = ПредставлениеЕдиницы(Единица);
		НайденныеХеши = ХешиСверки.НайтиСтроки(Новый Структура("Единица", Представление));
		Если НайденныеХеши.Количество() = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Единица %1 не проходила сверку, выполните сверку заново'"), Представление));
			Возврат Неопределено;
		КонецЕсли;

		Снимок = dev_tools_СнимокПравилКлиент.ПрочитатьСнимок(
			КаталогЕдиницы(Единица), Единица.Вид, Единица.Наименование);
		Если dev_tools_СинхронизацияПравилВызовСервера.ХешСнимка(Снимок) <> НайденныеХеши[0].Хеш Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(
				НСтр("ru = 'Файлы единицы %1 изменились после сверки, повторите сверку'"), Представление));
			Возврат Неопределено;
		КонецЕсли;
		Снимки.Добавить(Снимок);
	КонецЦикла;

	Возврат Снимки;

КонецФункции

// Ровно две выделенные строки одного вида: «только в базе» и «только в файлах».
&НаКлиенте
Функция ВыделеныСтрокиДляСвязи(СтрокаБазы, СтрокаФайлов)

	ВыделенныеСтроки = Элементы.Единицы.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаЕдиницы = Единицы.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаЕдиницы.КодСостояния = "ТолькоВБазе" Тогда
			СтрокаБазы = СтрокаЕдиницы;
		ИначеЕсли СтрокаЕдиницы.КодСостояния = "ТолькоВФайлах" Тогда
			СтрокаФайлов = СтрокаЕдиницы;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрокаБазы <> Неопределено И СтрокаФайлов <> Неопределено
		И СтрокаБазы.Вид = СтрокаФайлов.Вид;

КонецФункции

&НаКлиенте
Функция КаталогЕдиницы(Единица)

	Возврат dev_tools_СверкаПравил.КаталогЕдиницы(КаталогПравил, Единица.Вид, Единица.ИмяКаталога);

КонецФункции

&НаКлиенте
Процедура ЗаполнитьКаталогПравил()

	ТекущаяВетка = "";
	КаталогПравил = "";
	Если Не ЗначениеЗаполнено(Репозиторий) Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = РеквизитыРепозитория(Репозиторий);
	// Пустой каталог рабочей копии оставляет надпись пустой: единственная проверка,
	// по которой остальной код формы отличает готовый репозиторий от незаполненного.
	Если ПустаяСтрока(Реквизиты.КаталогРепозитория) Тогда
		Возврат;
	КонецЕсли;

	КаталогПравил = dev_tools_СверкаПравил.КаталогПравил(
		Реквизиты.КаталогРепозитория, Реквизиты.ПодкаталогПравил);
	ТекущаяВетка = dev_tools_СверкаПравил.ТекущаяВетка(Реквизиты.КаталогРепозитория);

КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыРепозитория(Репозиторий)

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Репозиторий,
		"КаталогРепозитория, ПодкаталогПравил");

КонецФункции

&НаКлиенте
Процедура ОбновитьСписокЕдиниц()

	Единицы.Очистить();
	Если ЗначениеЗаполнено(Репозиторий) И Не ПустаяСтрока(КаталогПравил) Тогда
		Конвертации = dev_tools_СнимокПравилКлиент.НаименованияЕдиниц(КаталогПравил, "Конвертации");
		Регистрации = dev_tools_СнимокПравилКлиент.НаименованияЕдиниц(КаталогПравил, "Регистрации");
		ЗаполнитьТаблицуЕдиниц(Конвертации, Регистрации);
	КонецЕсли;

	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Функция ТекстСменыВетки()

	Возврат НСтр("ru = 'Ветка сменилась после последней синхронизации (была «%1») — выполните сверку'");

КонецФункции

// Список заполняется заново при каждом обновлении списка единиц, поэтому прежние
// предупреждения о смене ветки удаляются: иначе они копятся и переживают смену репозитория.
&НаСервере
Процедура УдалитьПредупрежденияСменыВетки()

	НачалоТекста = Лев(ТекстСменыВетки(), СтрНайти(ТекстСменыВетки(), "%1") - 1);
	Индекс = Сообщения.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если СтрНачинаетсяС(Сообщения[Индекс].Текст, НачалоТекста) Тогда
			Сообщения.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЕдиниц(Конвертации, Регистрации)

	Найденные = dev_tools_СинхронизацияПравилВызовСервера.ЕдиницыРепозитория(
		Репозиторий, Конвертации, Регистрации);

	// Колонки реквизита формы и таблицы фасада не совпадают: "Отметка" есть только
	// на форме, поэтому строки заполняются по именам, а не загрузкой таблицы целиком.
	Единицы.Очистить();
	ОтмечатьВсе = Не ЗначениеЗаполнено(КонвертацияПараметра);
	КонвертацияНайдена = Ложь;
	УдалитьПредупрежденияСменыВетки();
	Точки = dev_tools_СинхронизацияПравилВызовСервера.ТочкиЕдиниц(Репозиторий);
	Для Каждого НайденнаяЕдиница Из Найденные Цикл
		СтрокаЕдиницы = Единицы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЕдиницы, НайденнаяЕдиница);
		СтрокаЕдиницы.КодСостояния = НайденнаяЕдиница.Состояние;
		СтрокаЕдиницы.Состояние = ПредставлениеСостояния(НайденнаяЕдиница.Состояние);
		СтрокаЕдиницы.Отметка = ОтмечатьВсе Или СтрокаЕдиницы.Ссылка = КонвертацияПараметра;
		ЗаполнитьТочкуСтроки(СтрокаЕдиницы, Точки);
		Если СтрокаЕдиницы.ВеткаСменилась Тогда
			Сообщение = Сообщения.Добавить();
			Сообщение.Уровень = "Предупреждение";
			Сообщение.Объект = НайденнаяЕдиница.Вид + ": " + НайденнаяЕдиница.Наименование;
			Сообщение.Текст = СтрШаблон(ТекстСменыВетки(), Точки[СтрокаЕдиницы.Ссылка].Ветка);
		КонецЕсли;
		Если Не ОтмечатьВсе И СтрокаЕдиницы.Ссылка = КонвертацияПараметра Тогда
			КонвертацияНайдена = Истина;
		КонецЕсли;
	КонецЦикла;

	// Конвертация из параметра открытия отмечает свою строку ровно один раз, но параметр
	// расходуется только тем заполнением, в котором её строка действительно нашлась.
	// Форма может открыться на сохранённом в настройках «чужом» репозитории — спека §3.5,
	// случай «репозиториев ноль или несколько»: там заполнение состоялось, а отмечать
	// было нечего, и параметр обязан дожить до выбора правильного репозитория.
	// Одноразовость снимает явное «Обновить список», а не любое заполнение таблицы.
	Если КонвертацияНайдена Тогда
		КонвертацияПараметра = Справочники.Конвертации.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

// Фасад возвращает состояние кодом, таблица показывает его текстом.
&НаСервереБезКонтекста
Функция ПредставлениеСостояния(Состояние)

	Если Состояние = "ВБазеИВФайлах" Тогда
		Возврат НСтр("ru = 'В базе и в файлах'");
	ИначеЕсли Состояние = "ТолькоВБазе" Тогда
		Возврат НСтр("ru = 'Только в базе'");
	ИначеЕсли Состояние = "ТолькоВФайлах" Тогда
		Возврат НСтр("ru = 'Только в файлах'");
	КонецЕсли;

	Возврат Состояние;

КонецФункции

&НаКлиенте
Процедура УстановитьОтметки(Значение)

	Для Каждого СтрокаЕдиницы Из Единицы Цикл
		СтрокаЕдиницы.Отметка = Значение;
	КонецЦикла;

КонецПроцедуры

// Открепить можно только строку, закреплённую за репозиторием. «Связать» не гасится
// (спека 2026-10-21, §3.4): погашенная кнопка не объясняет, что выделить, — команда
// проверяет выделение сама и называет нужную пару строк.
&НаКлиенте
Процедура ОбновитьДоступностьКоманд()

	ТекущиеДанные = Элементы.Единицы.ТекущиеДанные;
	Элементы.УбратьИзРепозитория.Доступность =
		ТекущиеДанные <> Неопределено И ТекущиеДанные.Закреплена;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЕдиницу(ИмяФормыВыбора, ПараметрыФормыВыбора)

	Если Не РепозиторийГотов() Тогда
		Возврат;
	КонецЕсли;

	// Справочники иерархические: без ограничения за репозиторием закрепилась бы группа,
	// которую выгрузка и сверка прочитали бы профилем обычной единицы.
	ПараметрыФормыВыбора.Вставить("ВыборГруппИЭлементов", ГруппыИЭлементы.Элементы);

	Оповещение = Новый ОписаниеОповещения("ВыборЕдиницыЗавершение", ЭтотОбъект);
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормыВыбора, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Единица в таблице сверки и сообщениях, а заодно ключ хешей сверки, корней дерева
// и отмеченных путей — поэтому обязана быть уникальной. Конвертация и регистрация с одним
// наименованием делят путь "", отсюда вид. Одно наименование бывает и у двух строк одного
// вида: единица «Розница», закреплённая под каталогом «ПО_Розница», и каталог «Розница»
// (спека 2026-10-21) — отсюда каталог в скобках, когда он расходится с наименованием.
// Пара «вид + каталог» в таблице единиц уникальна, значит, уникально и представление.
&НаКлиенте
Функция ПредставлениеЕдиницы(Единица)

	Представление = Единица.Вид + ": " + Единица.Наименование;
	Если ПустаяСтрока(Единица.Наименование)
		Или Единица.ИмяКаталога <> dev_tools_СверкаПравил.НормализоватьИмяКаталога(Единица.Наименование) Тогда
		Представление = Представление + " [" + Единица.ИмяКаталога + "]";
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Дерево строится из плоского списка узлов. Родитель находится по собственному пути узла,
// а не по порядку строк: строковая сортировка путей не гарантирует, что потомок идёт сразу
// за родителем — «ПКО/Магазин 2» сортируется раньше «ПКО/Магазин/ПКС/X», потому что пробел
// меньше слеша. Вложенность по порядку отдала бы ПКС соседу, и отметка на нём утянула бы
// в загрузку объект, которого пользователь не выбирал.
&НаКлиенте
Процедура ЗаполнитьДеревоСверки(ВсеСтроки)

	Сверка.ПолучитьЭлементы().Очистить();
	СтрокиПоПутям = Новый Соответствие;

	Для Каждого Узел Из dev_tools_СверкаПравил.УзлыДереваСверки(ВсеСтроки) Цикл
		СтрокаДерева = ЭлементыРодителяУзла(Узел, СтрокиПоПутям).Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Узел);
		СтрокаДерева.Отметка = Ложь;

		// Шапка в карту не попадает: её путь тоже пустой, и она затёрла бы в ней узел
		// своей единицы, под которым лежат все узлы первого уровня. Потомков у шапки нет.
		Если Узел.Уровень = 0 Или Не ПустаяСтрока(Узел.Путь) Тогда
			СтрокиПоПутям.Вставить(КлючУзлаДерева(Узел.Единица, Узел.Путь), СтрокаДерева);
		КонецЕсли;
	КонецЦикла;

	РазвернутьДваУровня();

КонецПроцедуры

&НаКлиенте
Функция КлючУзлаДерева(Единица, Путь)

	Возврат Единица + "|" + Путь;

КонецФункции

&НаКлиенте
Функция ЭлементыРодителяУзла(Узел, СтрокиПоПутям)

	Если Узел.Уровень = 0 Тогда
		Возврат Сверка.ПолучитьЭлементы();
	КонецЕсли;

	Родитель = СтрокиПоПутям[КлючУзлаДерева(Узел.Единица, Узел.ПутьРодителя)];
	Если Родитель = Неопределено Тогда
		// Родителя в карте нет — узел встаёт в корень своей единицы: потерять строку
		// сверки хуже, чем показать её не на своём уровне.
		Родитель = СтрокиПоПутям[КлючУзлаДерева(Узел.Единица, "")];
	КонецЕсли;
	Если Родитель = Неопределено Тогда
		Возврат Сверка.ПолучитьЭлементы();
	КонецЕсли;

	Возврат Родитель.ПолучитьЭлементы();

КонецФункции

// Раскрываются единицы и коллекции: с раскрытыми объектами дерево ничем не лучше списка.
&НаКлиенте
Процедура РазвернутьДваУровня()

	Для Каждого ЕдиницаДерева Из Сверка.ПолучитьЭлементы() Цикл
		Элементы.Сверка.Развернуть(ЕдиницаДерева.ПолучитьИдентификатор(), Ложь);
		Для Каждого Коллекция Из ЕдиницаДерева.ПолучитьЭлементы() Цикл
			Элементы.Сверка.Развернуть(Коллекция.ПолучитьИдентификатор(), Ложь);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкуПотомкам(СтрокаДерева, Значение)

	Для Каждого Потомок Из СтрокаДерева.ПолучитьЭлементы() Цикл
		Потомок.Отметка = Значение;
		УстановитьОтметкуПотомкам(Потомок, Значение);
	КонецЦикла;

КонецПроцедуры

// Служебная группировка показана отмеченной, когда отмечены все её потомки.
// Промежуточного состояния «часть потомков» нет: свойство флажка ТриСостояния
// существует, но третье состояние — это Неопределено, а булева колонка дерева значений
// его не хранит.
&НаКлиенте
Процедура ПересчитатьОтметкиРодителей()

	Для Каждого ЕдиницаДерева Из Сверка.ПолучитьЭлементы() Цикл
		ПересчитатьОтметкуУзла(ЕдиницаДерева);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПересчитатьОтметкуУзла(СтрокаДерева)

	Потомки = СтрокаДерева.ПолучитьЭлементы();
	Если Потомки.Количество() = 0 Тогда
		Возврат СтрокаДерева.Отметка;
	КонецЕсли;

	ВсеОтмечены = Истина;
	Для Каждого Потомок Из Потомки Цикл
		Если Не ПересчитатьОтметкуУзла(Потомок) Тогда
			ВсеОтмечены = Ложь;
		КонецЕсли;
	КонецЦикла;

	ОтметкаУзла = dev_tools_СверкаПравил.ОтметкаРодителя(
		СтрокаДерева.ЭтоОбъект, СтрокаДерева.Отметка, ВсеОтмечены);

	// Собственную отметку объектного узла пересчёт не переписывает: ПКО с вложенными ПКС —
	// объект, и правило группировки подняло бы на него отметку одного ПКС, а загрузка
	// исключила бы из конвертации весь ПКО. Наверх объект отдаёт «своя И все потомки».
	Если Не СтрокаДерева.ЭтоОбъект Тогда
		СтрокаДерева.Отметка = ОтметкаУзла;
	КонецЕсли;

	Возврат ОтметкаУзла;

КонецФункции

// Режим: «Применяемые» — только «Новый» и «Изменен», «Все» — включая «НетВФайлах»,
// «Ничего» — снять. Разделение не косметическое: когда каталог удалён, все строки
// имеют статус «НетВФайлах», и одна кнопка «отметить всё» означала бы пометку
// всех правил единицы на удаление.
&НаКлиенте
Процедура УстановитьОтметкиСверки(Режим)

	Для Каждого ЕдиницаДерева Из Сверка.ПолучитьЭлементы() Цикл
		УстановитьОтметкуПоРежиму(ЕдиницаДерева, Режим);
	КонецЦикла;
	ПересчитатьОтметкиРодителей();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметкуПоРежиму(СтрокаДерева, Режим)

	// Служебные группировки отметку получают пересчётом по потомкам: своего статуса
	// у них нет, и отмечать их по режиму было бы отметкой пустого пути.
	Если СтрокаДерева.ЭтоОбъект Тогда
		СтрокаДерева.Отметка = dev_tools_СверкаПравил.ОтметкаПоРежиму(СтрокаДерева.Статус, Режим,
			СтрокаДерева.Происхождение);
	КонецЕсли;

	Для Каждого Потомок Из СтрокаДерева.ПолучитьЭлементы() Цикл
		УстановитьОтметкуПоРежиму(Потомок, Режим);
	КонецЦикла;

КонецПроцедуры

// Пути отмеченных объектных узлов единицы — ровно тот же массив, который «Загрузить»
// получал от плоской таблицы. Узел единицы и шапка оба имеют путь "", поэтому отбор
// идёт по признаку ЭтоОбъект: у шапки он Истина, у корня единицы — Ложь.
&НаКлиенте
Функция ОтмеченныеПути(Представление)

	Пути = Новый Массив;
	Для Каждого ЕдиницаДерева Из Сверка.ПолучитьЭлементы() Цикл
		Если ЕдиницаДерева.Единица <> Представление Тогда
			Продолжить;
		КонецЕсли;
		СобратьОтмеченныеПути(ЕдиницаДерева, Пути);
	КонецЦикла;

	Возврат Пути;

КонецФункции

&НаКлиенте
Процедура СобратьОтмеченныеПути(СтрокаДерева, Пути)

	Если СтрокаДерева.ЭтоОбъект И СтрокаДерева.Отметка Тогда
		Пути.Добавить(СтрокаДерева.Путь);
	КонецЕсли;
	Для Каждого Потомок Из СтрокаДерева.ПолучитьЭлементы() Цикл
		СобратьОтмеченныеПути(Потомок, Пути);
	КонецЦикла;

КонецПроцедуры

// Статусы всех строк сверки — для итога после «Сверить»: он считается по различиям,
// а не по отметкам, и поэтому берётся из плоского списка строк, а не из дерева.
&НаКлиенте
Функция СтатусыВсехСтрок(ВсеСтроки)

	Статусы = Новый Массив;
	Для Каждого СтрокаСверки Из ВсеСтроки Цикл
		Статусы.Добавить(СтрокаСверки.Статус);
	КонецЦикла;

	Возврат Статусы;

КонецФункции

// Значения поля отмеченных объектных узлов — для подтверждения загрузки. Служебные
// группировки своего статуса не имеют, их значения пусты, и в сводку они попасть не должны.
//
// Ветки неотмеченных единиц пропускаются: загрузка идёт по ОтмеченныеЕдиницы(), и снятая
// между «Сверить» и «Загрузить» отметка единицы — легальный сценарий. Без этого отбора
// подтверждение обещало бы больше, чем сделает загрузка.
&НаКлиенте
Функция ЗначенияОтмеченных(ИмяПоля)

	ПредставленияЕдиниц = Новый Соответствие;
	Для Каждого Единица Из ОтмеченныеЕдиницы() Цикл
		ПредставленияЕдиниц.Вставить(ПредставлениеЕдиницы(Единица), Истина);
	КонецЦикла;

	Значения = Новый Массив;
	Для Каждого ЕдиницаДерева Из Сверка.ПолучитьЭлементы() Цикл
		Если ПредставленияЕдиниц[ЕдиницаДерева.Единица] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СобратьЗначенияОтмеченных(ЕдиницаДерева, ИмяПоля, Значения);
	КонецЦикла;

	Возврат Значения;

КонецФункции

&НаКлиенте
Процедура СобратьЗначенияОтмеченных(СтрокаДерева, ИмяПоля, Значения)

	Если СтрокаДерева.ЭтоОбъект И СтрокаДерева.Отметка Тогда
		Значения.Добавить(СтрокаДерева[ИмяПоля]);
	КонецЕсли;
	Для Каждого Потомок Из СтрокаДерева.ПолучитьЭлементы() Цикл
		СобратьЗначенияОтмеченных(Потомок, ИмяПоля, Значения);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЕстьНеизвестноеПроисхождение(ВсеСтроки)

	Для Каждого СтрокаСверки Из ВсеСтроки Цикл
		Если СтрокаСверки.Происхождение = "Неизвестно" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Колонка «Точка» обновляется на месте, без перестройки таблицы: перестройка сбросила бы
// отметки единиц, выбранные пользователем.
&НаСервере
Процедура ОбновитьТочкиЕдиниц()

	Если Не ЗначениеЗаполнено(Репозиторий) Тогда
		Возврат;
	КонецЕсли;

	Точки = dev_tools_СинхронизацияПравилВызовСервера.ТочкиЕдиниц(Репозиторий);
	Для Каждого СтрокаЕдиницы Из Единицы Цикл
		ЗаполнитьТочкуСтроки(СтрокаЕдиницы, Точки);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТочкуСтроки(СтрокаЕдиницы, Точки)

	СтрокаЕдиницы.Точка = "";
	СтрокаЕдиницы.ВеткаСменилась = Ложь;
	Если Не ЗначениеЗаполнено(СтрокаЕдиницы.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Точка = Точки[СтрокаЕдиницы.Ссылка];
	Если Точка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Точка другого каталога не применяется — и не показывается.
	Если НРег(Точка.ИмяКаталога) <> НРег(СтрокаЕдиницы.ИмяКаталога) Тогда
		Возврат;
	КонецЕсли;

	СтрокаЕдиницы.Точка = dev_tools_СверкаПравил.ПредставлениеТочки(Точка.Дата, Точка.Ветка);
	СтрокаЕдиницы.ВеткаСменилась = dev_tools_СверкаПравил.ВеткаСменилась(Точка.Ветка, ТекущаяВетка);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщение(Уровень, ОбъектСообщения, Текст)

	Сообщение = Сообщения.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.Объект = ОбъектСообщения;
	Сообщение.Текст = Текст;

КонецПроцедуры

&НаКлиенте
Процедура СброситьСверку()

	Сверка.ПолучитьЭлементы().Очистить();
	ХешиСверки.Очистить();
	Элементы.Загрузить.Доступность = Ложь;

КонецПроцедуры

// Окно ожидания БСП: прогресс по единицам, отмена; форма на время операции заблокирована.
&НаКлиенте
Процедура ОжидатьФоновуюОперацию(ДлительнаяОперация, ИмяОбработчика, ТекстОжидания, ДополнительныеПараметры)

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = ТекстОжидания;
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Истина;
	Оповещение = Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект, ДополнительныеПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

// Результат фонового задания или Неопределено: отмена — молча, ошибка — в список сообщений.
// Прочитанный результат из хранилища формы удаляется: второй раз он не читается.
&НаКлиенте
Функция РезультатФоновойОперации(Результат)

	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		// Задание, завершённое аварийно или снятое администратором, может прийти
		// без информации об ошибке — тогда подробного представления нет.
		Если Результат.ИнформацияОбОшибке = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Фоновое задание завершилось аварийно без описания ошибки'");
		Иначе
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Результат.ИнформацияОбОшибке);
		КонецЕсли;
		ДобавитьСообщение("Ошибка", "", ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

	Значение = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);

	Возврат Значение;

КонецФункции

#КонецОбласти
