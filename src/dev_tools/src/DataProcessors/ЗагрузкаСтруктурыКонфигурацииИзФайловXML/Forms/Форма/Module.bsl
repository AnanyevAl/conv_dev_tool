#Область СлужебныеПроцедурыИФункции

// Каталог проекта EDT вместо файла .project — штатная ловушка: кнопка «…» формы релиза
// выбирает каталог (known-issues §21). Путь нормализуется до разбора базовой процедурой.
&НаКлиенте
&Перед("ПодготовитьФайлыДляСервераНачало")
Процедура dev_tools_ПодготовитьФайлыДляСервераНачало()

	Если Объект.ИсточникДанных <> 0 Тогда
		Объект.ИмяКаталогаЗагрузки = dev_tools_ЗагрузкаСтруктурыКлиентСервер.ПутьКФайлуПроекта(
			Объект.ИмяКаталогаЗагрузки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
