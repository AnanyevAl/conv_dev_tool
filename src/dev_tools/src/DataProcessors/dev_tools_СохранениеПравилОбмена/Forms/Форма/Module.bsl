#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КонвертацияПараметра = Неопределено;
	Если Параметры.Свойство("Конвертация", КонвертацияПараметра)
		И ЗначениеЗаполнено(КонвертацияПараметра) Тогда
		Объект.Конвертация = КонвертацияПараметра;
		ЗаполнитьИмяФайлаПоКонвертации();
	КонецЕсли;

	Объект.СжиматьФайлПравил = Истина;
	УправлениеДоступностью(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Объект.СохранятьАвтоматическиПриОткрытии Тогда
		ПодключитьОбработчикОжидания("СохранитьАвтоматически", 0.5, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаПравилНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Укажите файл для сохранения правил обмена'");
	Если ЭтоАрхив() Тогда
		Диалог.Фильтр = НСтр("ru = 'Архив правил (*.zip)'") + "|*.zip";
		Диалог.Расширение = "zip";
	Иначе
		Диалог.Фильтр = НСтр("ru = 'Файл правил (*.xml)'") + "|*.xml";
		Диалог.Расширение = "xml";
	КонецЕсли;
	Диалог.ПолноеИмяФайла = Объект.ИмяФайлаПравил;

	Оповещение = Новый ОписаниеОповещения("ИмяФайлаПравилНачалоВыбораЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьОбработчикиВыгрузкиПриИзменении(Элемент)

	УправлениеДоступностью(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьОбработчикиЗагрузкиПриИзменении(Элемент)

	УправлениеДоступностью(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОбработчиковВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайлМодуляОбработчиков("ИмяФайлаОбработчиковВыгрузки",
		НСтр("ru = 'Укажите файл модуля обработчиков выгрузки'"));

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаОбработчиковЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайлМодуляОбработчиков("ИмяФайлаОбработчиковЗагрузки",
		НСтр("ru = 'Укажите файл модуля обработчиков загрузки'"));

КонецПроцедуры

&НаКлиенте
Процедура КонвертацияПриИзменении(Элемент)

	ЗаполнитьИмяФайлаПоКонвертации();

КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьПравилаКорреспондентаПриИзменении(Элемент)

	Если Не Объект.ВыгружатьПравилаКорреспондента Тогда
		Объект.КонвертацияКорреспондент = ПредопределенноеЗначение("Справочник.Конвертации.ПустаяСсылка");
	КонецЕсли;
	УправлениеДоступностью(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьПравилаРегистрацииПриИзменении(Элемент)

	Если Не Объект.ВыгружатьПравилаРегистрации Тогда
		Объект.Регистрация = ПредопределенноеЗначение("Справочник.Регистрации.ПустаяСсылка");
	КонецЕсли;
	УправлениеДоступностью(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	ВыполнитьСохранение();

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьОбработчики(Команда)

	Если Не ЗначениеЗаполнено(Объект.Конвертация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите конвертацию'"), , "Объект.Конвертация");
		Возврат;
	КонецЕсли;

	Если Не Объект.ВыгружатьОбработчикиВыгрузки И Не Объект.ВыгружатьОбработчикиЗагрузки Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выберите, какие обработчики выгружать'"));
		Возврат;
	КонецЕсли;

	Если Объект.ВыгружатьОбработчикиВыгрузки Тогда
		СохранитьТекстОбработчиков(Истина, Объект.ИмяФайлаОбработчиковВыгрузки);
	КонецЕсли;

	Если Объект.ВыгружатьОбработчикиЗагрузки Тогда
		СохранитьТекстОбработчиков(Ложь, Объект.ИмяФайлаОбработчиковЗагрузки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИмяФайлаПравилНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Объект.ИмяФайлаПравил = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьАвтоматически()

	ВыполнитьСохранение();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСохранение()

	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	Если Объект.ВыгружатьПравилаКорреспондента
		И Не ЗначениеЗаполнено(Объект.КонвертацияКорреспондент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите конвертацию корреспондента'"), , "Объект.КонвертацияКорреспондент");
		Возврат;
	КонецЕсли;

	Если Объект.ВыгружатьПравилаРегистрации И Не ЗначениеЗаполнено(Объект.Регистрация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите регистрацию'"), , "Объект.Регистрация");
		Возврат;
	КонецЕсли;

	Элементы.ФормаСохранить.Доступность = Ложь;
	ЗапуститьВыгрузку();

	Если ДлительнаяОперация Тогда
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеВыгрузки", 1, Истина);
	Иначе
		ЗавершитьВыгрузку();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершениеВыгрузки()

	Если ЗаданиеВыполнено() Тогда
		ЗавершитьВыгрузку();
	Иначе
		ПодключитьОбработчикОжидания("ПроверитьЗавершениеВыгрузки", 2, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаданиеВыполнено()

	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);

КонецФункции

&НаСервере
Процедура ЗапуститьВыгрузку()

	ИдентификаторЗадания = Неопределено;
	АдресРезультата = "";
	ДлительнаяОперация = Ложь;

	ПараметрыВыгрузки = dev_tools_ВыгрузкаПравилОбменаXML.ПараметрыВыгрузкиКомплекта();
	ПараметрыВыгрузки.Конвертация = Объект.Конвертация;
	ПараметрыВыгрузки.Сжимать = Объект.СжиматьФайлПравил;
	Если Объект.ВыгружатьПравилаКорреспондента Тогда
		ПараметрыВыгрузки.КонвертацияКорреспондент = Объект.КонвертацияКорреспондент;
	КонецЕсли;
	Если Объект.ВыгружатьПравилаРегистрации Тогда
		ПараметрыВыгрузки.Регистрация = Объект.Регистрация;
	КонецЕсли;

	Попытка
		ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Сохранение правил обмена'");
		ПараметрыЗадания.ЗапуститьВФоне = Истина;

		Задание = ДлительныеОперации.ВыполнитьВФоне(
			"dev_tools_ВыгрузкаПравилОбменаXML.ВыгрузитьКомплект",
			ПараметрыВыгрузки,
			ПараметрыЗадания);

		АдресРезультата = Задание.АдресРезультата;
		Если Задание.Статус = "Выполняется" Тогда
			ДлительнаяОперация = Истина;
			ИдентификаторЗадания = Задание.ИдентификаторЗадания;
		КонецЕсли;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'При сохранении правил обмена произошла ошибка'")
				+ Символы.ПС + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыгрузку()

	Элементы.ФормаСохранить.Доступность = Истина;

	ТекстОшибки = "";
	АдресДанных = ПодготовитьДанныеДляСохранения(ТекстОшибки);

	Если ПустаяСтрока(АдресДанных) Тогда
		ПоказатьПредупреждение( ,
			НСтр("ru = 'Сохранение правил обмена не выполнено'")
				+ ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС + ТекстОшибки));
		Возврат;
	КонецЕсли;

	ИмяФайла = ИмяФайлаСохранения();

	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	// Без полного пути неинтерактивное сохранение уводит файл в служебный каталог клиента,
	// поэтому каталог запрашивается у пользователя.
	ПараметрыСохранения.Интерактивно = Не ЭтоПолныйПуть(ИмяФайла);
	Если ПараметрыСохранения.Интерактивно Тогда
		ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Укажите файл для сохранения правил обмена'");
		Если ЭтоАрхив() Тогда
			ПараметрыСохранения.Диалог.Фильтр = НСтр("ru = 'Архив правил (*.zip)'") + "|*.zip";
			ПараметрыСохранения.Диалог.Расширение = "zip";
		Иначе
			ПараметрыСохранения.Диалог.Фильтр = НСтр("ru = 'Файл правил (*.xml)'") + "|*.xml";
			ПараметрыСохранения.Диалог.Расширение = "xml";
		КонецЕсли;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеСохраненияФайла", ЭтотОбъект, ИмяФайла);
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресДанных, ИмяФайла, ПараметрыСохранения);

КонецПроцедуры

// Дополняет имя файла правил расширением, соответствующим режиму выгрузки.
//
// Возвращаемое значение:
//  Строка - имя файла с расширением .zip или .xml.
&НаКлиенте
Функция ИмяФайлаСохранения()

	ИмяФайла = СокрЛП(Объект.ИмяФайлаПравил);
	Расширение = ?(ЭтоАрхив(), ".zip", ".xml");

	Если НРег(Прав(ИмяФайла, СтрДлина(Расширение))) <> Расширение Тогда
		ИмяФайла = ИмяФайла + Расширение;
	КонецЕсли;

	Возврат ИмяФайла;

КонецФункции

// Проверяет, задан ли в имени файла полный путь.
//
// Параметры:
//  ИмяФайла - Строка - проверяемое имя файла.
//
// Возвращаемое значение:
//  Булево - Истина, если указан абсолютный путь или сетевой ресурс.
&НаКлиенте
Функция ЭтоПолныйПуть(ИмяФайла)

	Возврат СтрНайти(ИмяФайла, ":\") > 0
		Или СтрНайти(ИмяФайла, ":/") > 0
		Или СтрНачинаетсяС(ИмяФайла, "\\");

КонецФункции

// Проверяет результат фонового задания и готовит данные к передаче на клиент.
//
// Параметры:
//  ТекстОшибки - Строка - возвращаемый текст ошибки, если выгрузка не удалась.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных во временном хранилище; пустая строка при ошибке.
&НаСервере
Функция ПодготовитьДанныеДляСохранения(ТекстОшибки)

	Если ПустаяСтрока(АдресРезультата) Тогда
		Возврат "";
	КонецЕсли;

	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Успешно Тогда
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			ТекстОшибки = Результат.ТекстОшибки;
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Возврат ПоместитьВоВременноеХранилище(Результат.Данные, УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура ПослеСохраненияФайла(ПолученныеФайлы, ИмяФайла) Экспорт

	Если ПолученныеФайлы = Неопределено Или ПолученныеФайлы.Количество() = 0 Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Файл правил обмена не сохранён'"));
		Возврат;
	КонецЕсли;

	ПутьСохранения = ИмяФайла;
	Если ТипЗнч(ПолученныеФайлы[0]) = Тип("ОписаниеПереданногоФайла") Тогда
		ПутьСохранения = ПолученныеФайлы[0].Имя;
	КонецЕсли;

	// Оповещение, а не сообщение формы: форма может закрыться следующей строкой,
	// и привязанное к ней сообщение пользователь не увидит.
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Правила обмена сохранены'"), , ПутьСохранения);

	Если Не Объект.НеЗакрыватьФормуПослеСохранения Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

// Управляет доступностью зависимых полей формы.
// Директива без контекста: процедура вызывается и с клиента, и с сервера.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма сохранения правил обмена.
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностью(Форма)

	Форма.Элементы.КонвертацияКорреспондент.Доступность = Форма.Объект.ВыгружатьПравилаКорреспондента;
	Форма.Элементы.Регистрация.Доступность = Форма.Объект.ВыгружатьПравилаРегистрации;
	Форма.Элементы.СжиматьФайлПравил.Доступность =
		Не (Форма.Объект.ВыгружатьПравилаКорреспондента Или Форма.Объект.ВыгружатьПравилаРегистрации);
	Форма.Элементы.ИмяФайлаОбработчиковВыгрузки.Доступность = Форма.Объект.ВыгружатьОбработчикиВыгрузки;
	Форма.Элементы.ИмяФайлаОбработчиковЗагрузки.Доступность = Форма.Объект.ВыгружатьОбработчикиЗагрузки;

КонецПроцедуры

&НаКлиенте
Функция ЭтоАрхив()

	Возврат Объект.СжиматьФайлПравил
		Или Объект.ВыгружатьПравилаКорреспондента
		Или Объект.ВыгружатьПравилаРегистрации;

КонецФункции

// Открывает диалог выбора файла модуля обработчиков и записывает выбранный путь в реквизит.
//
// Параметры:
//  ИмяРеквизита - Строка - имя реквизита объекта, куда помещается выбранный путь.
//  Заголовок - Строка - заголовок диалога выбора файла.
&НаКлиенте
Процедура ВыбратьФайлМодуляОбработчиков(ИмяРеквизита, Заголовок)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = Заголовок;
	Диалог.Фильтр = НСтр("ru = 'Модуль (*.txt)'") + "|*.txt";
	Диалог.Расширение = "txt";
	Диалог.ПолноеИмяФайла = Объект[ИмяРеквизита];

	Оповещение = Новый ОписаниеОповещения("ВыбратьФайлМодуляОбработчиковЗавершение",
		ЭтотОбъект, ИмяРеквизита);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлМодуляОбработчиковЗавершение(ВыбранныеФайлы, ИмяРеквизита) Экспорт

	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Объект[ИмяРеквизита] = ВыбранныеФайлы[0];
	КонецЕсли;

КонецПроцедуры

// Формирует текст отладочного модуля обработчиков и сохраняет его в файл.
//
// Параметры:
//  ЭтоВыгрузка - Булево - Истина: обработчики выгрузки, Ложь: обработчики загрузки.
//  ИмяФайла - Строка - полное имя файла, в который сохраняется модуль.
&НаКлиенте
Процедура СохранитьТекстОбработчиков(ЭтоВыгрузка, ИмяФайла)

	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите имя файла модуля обработчиков'"));
		Возврат;
	КонецЕсли;

	АдресТекста = АдресТекстаОбработчиков(ЭтоВыгрузка);
	Если ПустаяСтрока(АдресТекста) Тогда
		Возврат;
	КонецЕсли;

	Если НРег(Прав(ИмяФайла, 4)) <> ".txt" Тогда
		ИмяФайла = ИмяФайла + ".txt";
	КонецЕсли;

	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Интерактивно = Не ЭтоПолныйПуть(ИмяФайла);
	Если ПараметрыСохранения.Интерактивно Тогда
		ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Укажите файл модуля обработчиков'");
		ПараметрыСохранения.Диалог.Фильтр = НСтр("ru = 'Модуль (*.txt)'") + "|*.txt";
		ПараметрыСохранения.Диалог.Расширение = "txt";
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеСохраненияОбработчиков", ЭтотОбъект, ИмяФайла);
	ФайловаяСистемаКлиент.СохранитьФайл(Оповещение, АдресТекста, ИмяФайла, ПараметрыСохранения);

КонецПроцедуры

// Формирует текст отладочного модуля штатным механизмом КД 3.1.
//
// Параметры:
//  ЭтоВыгрузка - Булево - признак обработчиков выгрузки.
//
// Возвращаемое значение:
//  Строка - адрес двоичных данных модуля во временном хранилище; пустая строка при ошибке.
&НаСервере
Функция АдресТекстаОбработчиков(ЭтоВыгрузка)

	Попытка
		ТекстМодуля = Обработки.ВыгрузкаОбработчиковXML.ПолучитьТекстОбработчиков(
			Объект.Конвертация, ЭтоВыгрузка, Истина);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Не удалось сформировать текст обработчиков'")
				+ Символы.ПС + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;

	Возврат ПоместитьВоВременноеХранилище(
		ПолучитьДвоичныеДанныеИзСтроки(ТекстМодуля, КодировкаТекста.UTF8, Ложь),
		УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура ПослеСохраненияОбработчиков(ПолученныеФайлы, ИмяФайла) Экспорт

	Если ПолученныеФайлы = Неопределено Или ПолученныеФайлы.Количество() = 0 Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Файл обработчиков не сохранён'"));
		Возврат;
	КонецЕсли;

	ПутьСохранения = ИмяФайла;
	Если ТипЗнч(ПолученныеФайлы[0]) = Тип("ОписаниеПереданногоФайла") Тогда
		ПутьСохранения = ПолученныеФайлы[0].Имя;
	КонецЕсли;

	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Обработчики выгружены'"), , ПутьСохранения);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИмяФайлаПоКонвертации()

	Если Не ЗначениеЗаполнено(Объект.Конвертация) Тогда
		Возврат;
	КонецЕсли;

	ИмяИзКонвертации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Объект.Конвертация, "ИмяФайлаДляСохранения");

	Если ЗначениеЗаполнено(ИмяИзКонвертации) Тогда
		Объект.ИмяФайлаПравил = ИмяИзКонвертации;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
