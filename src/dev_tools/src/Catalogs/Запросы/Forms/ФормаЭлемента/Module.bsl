#Область ОбработчикиСобытийФормы

&НаСервере
Процедура dev_tools_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Вкладок на форме нет: один текст запроса — одна страница описания.
	dev_tools_РедакторАлгоритмовСервер.ПодключитьРедактор(ЭтотОбъект, "Запросы");

КонецПроцедуры

&НаКлиенте
Асинх Процедура dev_tools_ПриОткрытии(Отказ)

	Если Не dev_tools_РедакторПодключен Тогда
		Возврат;
	КонецЕсли;

#Если ВебКлиент Или МобильныйКлиент Тогда
	dev_tools_РедакторАлгоритмовКлиент.ПоказатьШтатныеПоля(ЭтотОбъект);
	Возврат;
#КонецЕсли

	Ждать dev_tools_ИнициализацияРедактораКлиент.ПриОткрытии(ЭтотОбъект);

	Если Не ЭтотОбъект.dev_tools_ИсходникиЗагружены Тогда
		dev_tools_РедакторАлгоритмовКлиент.ПоказатьШтатныеПоля(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура dev_tools_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "dev_tools_РедакторГотов" И Источник = ЭтотОбъект Тогда
		// init() очищает редактор, поэтому текст заполняем заново.
		dev_tools_ЗагрузитьТекстВРедактор();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура dev_tools_ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Не dev_tools_РедакторПодключен Тогда
		Возврат;
	КонецЕсли;

	dev_tools_ИнициализацияРедактораКлиент.ПередЗаписью(ЭтотОбъект, Отказ, ПараметрыЗаписи);
	dev_tools_РедакторАлгоритмовКлиент.ПеренестиКодВОбъект(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Асинх Процедура dev_tools_ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не dev_tools_РедакторПодключен Или Модифицированность Тогда
		// При модифицированности пользователь ещё может отменить закрытие,
		// а удаление временных файлов сломает открытый редактор.
		Возврат;
	КонецЕсли;

	Ждать dev_tools_ИнициализацияРедактораКлиент.ПередЗакрытием(ЭтотОбъект, Отказ,
		ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Действие поля HTML назначает dev_tools_ИнициализацияРедактораСервер.ПриСозданииНаСервере.
//@skip-check module-unused-method
&НаКлиенте
Процедура dev_tools_ПодключаемыйДокументСформирован(Элемент)

	// Событие приходит и при первом показе, и при пересоздании документа.
	// Редактор в нём новый и пустой, поэтому оба признака сбрасываем.
	ЭтотОбъект.dev_tools_ДокументЗагружен = Ложь;
	ЭтотОбъект.dev_tools_ТекстЗагружен = Ложь;
	ЭтотОбъект.dev_tools_ПопытокЗагрузкиТекста = 0;

	Если ЭтотОбъект.dev_tools_ИсходникиЗагружены Тогда
		ПодключитьОбработчикОжидания("dev_tools_ИнициализироватьДокумент", 0.2, Истина);
	Иначе
		dev_tools_ИнициализацияРедактораКлиент.ЗапланироватьПовторнуюИнициализацию(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

// Действие поля HTML назначает dev_tools_ИнициализацияРедактораСервер.ПриСозданииНаСервере.
//@skip-check module-unused-method
&НаКлиенте
Процедура dev_tools_ПодключаемыйПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	dev_tools_КомандыРедактораКлиент.ОбработатьСобытиеСУчетомРежимаЧтения(
		ЭтотОбъект, ДанныеСобытия.Event.eventData1C);

КонецПроцедуры

&НаКлиенте
Процедура dev_tools_ИнициализироватьДокумент()

	dev_tools_ИнициализацияРедактораКлиент.ДокументСформирован(Неопределено, ЭтотОбъект);
	dev_tools_ЗагрузитьТекстВРедактор();

КонецПроцедуры

// Вызывается обработчиком ожидания из dev_tools_ИнициализацияРедактораКлиент.
//@skip-check module-unused-method
&НаКлиенте
Процедура dev_tools_ПовторИнициализацииКонсоли()

	dev_tools_ИнициализацияРедактораКлиент.ПовторИнициализацииКонсоли(ЭтотОбъект);

КонецПроцедуры

// Заполняет редактор текстом запроса, повторяя попытки, пока Monaco не примет текст:
// готовность редактора наступает асинхронно и не всегда сопровождается событием.
// После удачной загрузки включает подсветку и подсказки языка запросов.
//
//@skip-check module-unused-method
&НаКлиенте
Процедура dev_tools_ЗагрузитьТекстВРедактор()

	Попытка
		// Язык включается до загрузки текста и без его перезаписи: смены языка модели
		// достаточно для подсветки, а лишняя перезапись поднимает событие изменения.
		dev_tools_КомандыРедактораКлиент.УстановитьРежимЯзыка(ЭтотОбъект, Истина);
	Исключение
		// Редактор ещё не принимает команды — язык включится на следующей попытке.
	КонецПопытки;

	Если dev_tools_РедакторАлгоритмовКлиент.ЗагрузитьТекстАктивнойВкладки(ЭтотОбъект) Тогда
		ЭтотОбъект.dev_tools_ПопытокЗагрузкиТекста = 0;
		Возврат;
	КонецЕсли;

	ЭтотОбъект.dev_tools_ПопытокЗагрузкиТекста = ЭтотОбъект.dev_tools_ПопытокЗагрузкиТекста + 1;
	Если ЭтотОбъект.dev_tools_ПопытокЗагрузкиТекста > 40 Тогда
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("dev_tools_ЗагрузитьТекстВРедактор", 0.3, Истина);

КонецПроцедуры

#КонецОбласти
