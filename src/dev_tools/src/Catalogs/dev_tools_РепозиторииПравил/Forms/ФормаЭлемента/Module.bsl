#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Та же функция, что зовёт клиент: при открытии формы клиентского вызова ещё не было.
	КаталогПравилНадпись = ТекстНадписиКаталога(Объект.КаталогРепозитория, Объект.ПодкаталогПравил);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КаталогРепозиторияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Каталог рабочей копии репозитория'");
	Диалог.Каталог = Объект.КаталогРепозитория;

	Оповещение = Новый ОписаниеОповещения("КаталогРепозиторияВыборЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура КаталогРепозиторияВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Объект.КаталогРепозитория = ВыбранныеФайлы[0];
	ОбновитьНадписьКаталога();

КонецПроцедуры

&НаКлиенте
Процедура КаталогРепозиторияПриИзменении(Элемент)

	ОбновитьНадписьКаталога();

КонецПроцедуры

&НаКлиенте
Процедура ПодкаталогПравилПриИзменении(Элемент)

	ОбновитьНадписьКаталога();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЕдиницы

&НаКлиенте
Процедура ЕдиницыЕдиницаПриИзменении(Элемент)

	// Каталог — идентичность прежней единицы строки (спека 2026-10-21, §3.1): новая его
	// не наследует. Пустое имя читается как нормализованное наименование, связь с другим
	// каталогом ставит команда «Связать» формы синхронизации.
	ТекущиеДанные = Элементы.Единицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.ИмяКаталога = "";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собранный каталог правил с примером, куда попадут коллекции: отвечает на вопрос
// «правильно ли указан подкаталог» до перехода на форму синхронизации.
&НаКлиентеНаСервереБезКонтекста
Функция ТекстНадписиКаталога(КаталогРепозитория, ПодкаталогПравил)

	Если ПустаяСтрока(КаталогРепозитория) Тогда
		Возврат НСтр("ru = 'Укажите каталог рабочей копии'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Правила лежат в: %1%2{Конвертации|Регистрации}%2…'"),
		dev_tools_СверкаПравил.КаталогПравил(КаталогРепозитория, ПодкаталогПравил),
		ПолучитьРазделительПути());

КонецФункции

&НаКлиенте
Процедура ОбновитьНадписьКаталога()

	КаталогПравилНадпись = ТекстНадписиКаталога(Объект.КаталогРепозитория, Объект.ПодкаталогПравил);

КонецПроцедуры

#КонецОбласти
