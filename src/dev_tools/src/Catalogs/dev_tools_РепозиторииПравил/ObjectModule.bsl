#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Причина, по которой имена каталогов единиц нельзя записать, или пустая строка.
// Имя каталога — идентичность единицы в git (спека 2026-10-21, §3.1): оно обязано быть
// нормализованным и уникальным в пределах вида — конвертации и регистрации лежат
// в разных коллекциях каталогов. Пустое имя читается как нормализованное наименование
// и проверяется в этом виде.
//
// Возвращаемое значение:
//  Строка
Функция ПричинаОтказаВИменахКаталогов() Экспорт

	Занятые = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Единицы Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Единица) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ПустаяСтрока(СтрокаТЧ.ИмяКаталога)
			И dev_tools_СверкаПравил.НормализоватьИмяКаталога(СтрокаТЧ.ИмяКаталога) <> СтрокаТЧ.ИмяКаталога Тогда
			Возврат СтрШаблон(НСтр("ru = 'Имя каталога «%1» содержит недопустимые символы, допустимое имя: «%2»'"),
				СтрокаТЧ.ИмяКаталога, dev_tools_СверкаПравил.НормализоватьИмяКаталога(СтрокаТЧ.ИмяКаталога));
		КонецЕсли;

		ИмяКаталога = dev_tools_СверкаПравил.ИмяКаталогаЕдиницы(СтрокаТЧ.ИмяКаталога,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Единица, "Наименование"));
		Ключ = ВидЕдиницы(СтрокаТЧ.Единица) + "|" + НРег(ИмяКаталога);
		Занявшая = Занятые[Ключ];
		Если Занявшая <> Неопределено И Занявшая <> СтрокаТЧ.Единица Тогда
			Возврат СтрШаблон(НСтр("ru = 'Каталог «%1» указан у двух единиц: «%2» и «%3»'"),
				ИмяКаталога, Занявшая, СтрокаТЧ.Единица);
		КонецЕсли;
		Занятые.Вставить(Ключ, СтрокаТЧ.Единица);
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ПричинаОтказа = ПричинаОтказаВИменахКаталогов();
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		ОбщегоНазначения.СообщитьПользователю(ПричинаОтказа, ЭтотОбъект, "Единицы", , Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидЕдиницы(Единица)

	Если ТипЗнч(Единица) = Тип("СправочникСсылка.Регистрации") Тогда
		Возврат "Регистрация";
	КонецЕсли;

	Возврат "Конвертация";

КонецФункции

#КонецОбласти

#КонецЕсли
