#Область ПрограммныйИнтерфейс

// Подключает редактор кода к форме правила: создаёт реквизиты редактора, описывает
// вкладки с текстами и подсказками и убирает штатные поля текста.
//
// Вызывать из расширения обработчика ПриСозданииНаСервере заимствованной формы.
// Форма обязана содержать элемент dev_tools_Код и реквизиты dev_tools_HTML
// и dev_tools_РедакторПодключен.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила.
//  ИмяСправочника - Строка - имя справочника правил, например "ПравилаОбработкиДанных".
//  ТипКонвертацииXML - Булево - Истина: вкладки правил формата XML, Ложь: формата XDTO.
//  ИмяГруппыСтраниц - Строка - имя группы страниц с вкладками событий;
//                              пустая строка, если вкладок на форме нет.
//  ИмяФормы - Строка - имя формы, если у справочника несколько форм с разным составом
//                      вкладок; иначе пустая строка.
Процедура ПодключитьРедактор(Форма, ИмяСправочника, ТипКонвертацииXML = Истина,
	ИмяГруппыСтраниц = "", ИмяФормы = "") Экспорт

	Вкладки = dev_tools_РедакторАлгоритмов.ОписаниеВкладок(
		ИмяСправочника, ТипКонвертацииXML, ИмяФормы);

	Если Вкладки.Количество() = 0 Тогда
		// Описания вкладок для этой формы нет — редактор не подключаем,
		// пользователь остаётся со штатными полями.
		Форма.Элементы.dev_tools_Код.Видимость = Ложь;
		Возврат;
	КонецЕсли;

	dev_tools_ИнициализацияРедактораСервер.ПриСозданииНаСервере(Форма);

	Для Каждого Вкладка Из Вкладки Цикл

		Описание = Вкладка.Значение;
		Описание.Код = Форма.Объект[Описание.Реквизит];
		Описание.КодЗаполнен = ЗначениеЗаполнено(Описание.Код);
		Описание.Вставить("JSONПодсказок",
			dev_tools_ПодсказкиОбработчиков.JSONПодсказок(Описание.Параметры));
		Описание.Удалить("Параметры");

		СкрытьШтатноеПоле(Форма, Описание.Реквизит);

	КонецЦикла;

	Форма.dev_tools_СоответствияКодовНаСтранице = Вкладки;
	Форма.dev_tools_КлючАктивнойСтраницы = КлючТекущейСтраницы(Форма, Вкладки, ИмяГруппыСтраниц);

	// Ставится последним и только после удачного создания динамических реквизитов:
	// по нему клиентские обработчики решают, работать им или молча выйти.
	// У ФормыКлиентскогоПриложения нет метода Свойство(), проверить наличие
	// реквизита во время выполнения больше нечем.
	Форма.dev_tools_РедакторПодключен = Истина;

КонецПроцедуры

// Возвращает имя вкладки, открытой в форме сейчас.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила.
//  Вкладки - см. dev_tools_РедакторАлгоритмов.ОписаниеВкладок
//  ИмяГруппыСтраниц - Строка - имя группы страниц; пустая строка, если вкладок нет.
//
// Возвращаемое значение:
//  Строка - имя вкладки; первая из описания, если текущая страница не определена.
Функция КлючТекущейСтраницы(Форма, Вкладки, ИмяГруппыСтраниц) Экспорт

	Если ЗначениеЗаполнено(ИмяГруппыСтраниц) Тогда

		ГруппаСтраниц = Форма.Элементы.Найти(ИмяГруппыСтраниц);

		Если ГруппаСтраниц <> Неопределено
			И ГруппаСтраниц.ТекущаяСтраница <> Неопределено
			И Вкладки.Свойство(ГруппаСтраниц.ТекущаяСтраница.Имя) Тогда
			Возврат ГруппаСтраниц.ТекущаяСтраница.Имя;
		КонецЕсли;

	КонецЕсли;

	Для Каждого Вкладка Из Вкладки Цикл
		Возврат Вкладка.Ключ;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прячет штатное поле текста: его место занимает редактор. Видимость снимается кодом,
// а не в конфигураторе, чтобы при недоступном редакторе поле можно было вернуть.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила.
//  ИмяРеквизита - Строка - имя реквизита с текстом алгоритма.
Процедура СкрытьШтатноеПоле(Форма, ИмяРеквизита)

	ПолеТекста = Форма.Элементы.Найти(ИмяРеквизита);

	Если ПолеТекста <> Неопределено Тогда
		ПолеТекста.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
