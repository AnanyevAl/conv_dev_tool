#Область ПрограммныйИнтерфейс

// Читает каталог единицы в снимок: все файлы рекурсивно, переводы строк — LF.
//
// Параметры:
//  КаталогЕдиницы - Строка - полный путь каталога единицы.
//  Вид - Строка - "Конвертация" или "Регистрация".
//  Наименование - Строка - наименование единицы.
//
// Возвращаемое значение:
//  Структура - см. dev_tools_СверкаПравил.НовыйСнимок; пустой, если каталога нет.
Функция ПрочитатьСнимок(КаталогЕдиницы, Вид, Наименование) Экспорт

	Снимок = dev_tools_СверкаПравил.НовыйСнимок(Вид, Наименование);
	Корень = БезКонцевогоРазделителя(КаталогЕдиницы);
	КаталогЕдиницыФайл = Новый Файл(Корень);
	Если Не КаталогЕдиницыФайл.Существует() Тогда
		Возврат Снимок;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(Корень, "*", Истина) Цикл
		Если Файл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Если Текст = Неопределено Тогда
			Текст = "";
		КонецЕсли;
		Снимок.Файлы.Вставить(ОтносительныйПуть(Корень, Файл.ПолноеИмя),
			dev_tools_СверкаПравил.НормализоватьПереводыСтрок(Текст));
	КонецЦикла;

	Возврат Снимок;

КонецФункции

// Записывает снимок в каталог единицы: только изменившиеся файлы (UTF-8 без BOM, LF),
// файлы вне снимка внутри каталога удаляются, опустевшие каталоги — тоже.
//
// Длину пути инструмент не проверяет: требуется включённый LongPathsEnabled. При выключенном
// запись падает посреди снимка, каталог единицы остаётся недописанным (восстановить из git).
//
// Параметры:
//  КаталогЕдиницы - Строка - полный путь каталога единицы.
//  Снимок - Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
//  СуществующийСнимок - Структура, Неопределено - снимок каталога, уже прочитанный вызывающим
//                       (см. ПрочитатьСнимок); Неопределено — каталог читается здесь.
//
// Возвращаемое значение:
//  Структура - Записано, Удалено, БезИзменений (Число).
Функция ЗаписатьСнимок(КаталогЕдиницы, Снимок, Знач СуществующийСнимок = Неопределено) Экспорт

	Корень = БезКонцевогоРазделителя(КаталогЕдиницы);

	Итог = Новый Структура("Записано, Удалено, БезИзменений", 0, 0, 0);
	Существующий = СуществующийСнимок;
	Если Существующий = Неопределено Тогда
		Существующий = ПрочитатьСнимок(Корень, Снимок.Вид, Снимок.Наименование);
	КонецЕсли;
	СоздатьКаталог(Корень);

	Для Каждого Файл Из Снимок.Файлы Цикл
		Если Существующий.Файлы[Файл.Ключ] = Файл.Значение Тогда
			Итог.БезИзменений = Итог.БезИзменений + 1;
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ПолныйПуть(Корень, Файл.Ключ);
		ФайлЗаписи = Новый Файл(ПолноеИмя);
		СоздатьКаталог(ФайлЗаписи.Путь);
		// ЗаписьТекста пишет BOM и переводит ПС в CRLF даже с кодировкой строкой "UTF-8":
		// байты нужны без изменений, поэтому пишем напрямую двоичными данными.
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Файл.Значение, КодировкаТекста.UTF8, Ложь);
		ДвоичныеДанные.Записать(ПолноеИмя);
		Итог.Записано = Итог.Записано + 1;
	КонецЦикла;

	Для Каждого Файл Из Существующий.Файлы Цикл
		Если Снимок.Файлы[Файл.Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УдалитьФайлы(ПолныйПуть(Корень, Файл.Ключ));
		Итог.Удалено = Итог.Удалено + 1;
	КонецЦикла;

	УдалитьПустыеКаталоги(Корень);

	Возврат Итог;

КонецФункции

// Имена единиц в коллекции: подкаталоги верхнего уровня <КаталогПравил>/<Коллекция>.
// Имя каталога — идентичность единицы в репозитории, с её наименованием в базе оно может
// не совпадать (спека 2026-10-21); сопоставление с базой делает сервер.
//
// Параметры:
//  КаталогПравил - Строка - см. dev_tools_СверкаПравил.КаталогПравил.
//  Коллекция - Строка - «Конвертации» или «Регистрации».
//
// Возвращаемое значение:
//  Массив из Строка - имена подкаталогов; пустой, если коллекции нет.
Функция НаименованияЕдиниц(КаталогПравил, Коллекция) Экспорт

	Имена = Новый Массив;
	КаталогКоллекции = БезКонцевогоРазделителя(КаталогПравил) + ПолучитьРазделительПути() + Коллекция;
	ФайлКоллекции = Новый Файл(КаталогКоллекции);
	Если Не ФайлКоллекции.Существует() Тогда
		Возврат Имена;
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(КаталогКоллекции, "*", Ложь) Цикл
		Если Файл.ЭтоКаталог() Тогда
			Имена.Добавить(Файл.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция БезКонцевогоРазделителя(Путь)

	Если СтрЗаканчиваетсяНа(Путь, ПолучитьРазделительПути()) Тогда
		Возврат Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;

	Возврат Путь;

КонецФункции

Функция ПолныйПуть(Корень, ОтносительныйПуть)

	Возврат Корень + ПолучитьРазделительПути() + СтрЗаменить(ОтносительныйПуть, "/", ПолучитьРазделительПути());

КонецФункции

Функция ОтносительныйПуть(Корень, ПолноеИмя)

	Относительный = Сред(ПолноеИмя, СтрДлина(Корень) + 2);

	Возврат СтрЗаменить(Относительный, ПолучитьРазделительПути(), "/");

КонецФункции

// Удаляет каталоги, в которых не осталось файлов (снизу вверх). Сам корень не трогает.
Функция УдалитьПустыеКаталоги(Каталог)

	ЕстьСодержимое = Ложь;
	Для Каждого Файл Из НайтиФайлы(Каталог, "*", Ложь) Цикл
		Если Файл.ЭтоКаталог() Тогда
			Если УдалитьПустыеКаталоги(Файл.ПолноеИмя) Тогда
				ЕстьСодержимое = Истина;
			Иначе
				УдалитьФайлы(Файл.ПолноеИмя);
			КонецЕсли;
		Иначе
			ЕстьСодержимое = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ЕстьСодержимое;

КонецФункции

#КонецОбласти
