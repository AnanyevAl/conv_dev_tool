	Возврат View(Форма).getSelectionLineNumbers();

КонецФункции

// Функция возвращает текстовое представление формы
// 
// Параметры:
//  Форма  - ФормаКлиентскогоПриложения - форма для получения текстового представления
// 
// Возвращаемое значение:
// Строка - Текстовое представление формы
Функция ПолучитьТекст(Форма) Экспорт

	Код = View(Форма).getText();
	
	// Monaco разделяет строки парой ВК + ПС, в 1С текст живёт с одним ПС. Без нормализации
	// текст, вернувшийся из редактора без единой правки, отличается от исходного на число
	// строк и помечает форму модифицированной.
	Возврат СтрЗаменить(Код, Символы.ВК + Символы.ПС, Символы.ПС);

КонецФункции

