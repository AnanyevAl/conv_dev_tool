#Область СлужебныеПроцедурыИФункции

// Отмечает форму изменённой по событию редактора, но только если содержимое
// действительно разошлось с сохранённым кодом вкладки. Событие EVENT_CONTENT_CHANGED
// приходит и от программного заполнения: JS-обёртка глушит его лишь для части
// операций, а очередь событий редактора доставляет их асинхронно, поэтому
// определять авторство изменения по флагам «сейчас пишем программно» ненадёжно.
//
// Сравнение выполняется, только пока форма не помечена изменённой: после первой
// настоящей правки каждое следующее нажатие клавиши уходит по короткому пути.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с редактором.
Процедура ОтметитьМодифицированность(Форма)

	Если Форма.Модифицированность Тогда
		Возврат;
	КонецЕсли;

	// Редактор ещё не держит текст вкладки — изменение не пользовательское.
	Если Не Форма.dev_tools_ТекстЗагружен Тогда
		Возврат;
	КонецЕсли;

	Описание = Неопределено;
	Если Форма.dev_tools_СоответствияКодовНаСтранице.Свойство(
		Форма.dev_tools_КлючАктивнойСтраницы, Описание) Тогда

		Попытка
			// ПолучитьТекст уже приводит перевод строки к ПС, образец приводим здесь.
			Совпадает = ПолучитьТекст(Форма)
				= СтрЗаменить(Описание.Код, Символы.ВК + Символы.ПС, Символы.ПС);
		Исключение
			Совпадает = Ложь;
		КонецПопытки;

		Если Совпадает Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	Форма.Модифицированность = Истина;

КонецПроцедуры

// Вызывает выбор типа для плейсхолдеров сниппетов "ВыборТипа" и "КонструкторОписанияТипов"
Процедура ВызватьКонструкторТипа(Форма, ОписаниеТипов)

	ИменаТипов = "Строка, Число, Дата, Булево, УникальныйИдентификатор, Массив, Структура, Соответствие,
		|СписокЗначений, ТаблицаЗначений, ДеревоЗначений, ОписаниеТипов, ДвоичныеДанные, Произвольный";

	СписокТипов = Новый СписокЗначений;
	Для Каждого ИмяТипа Из СтрРазделить(ИменаТипов, ",") Цикл
		СписокТипов.Добавить(СокрЛП(ИмяТипа));
	КонецЦикла;

	ДопПараметры = Новый Структура("Форма, ОписаниеТипов", Форма, ОписаниеТипов);
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборТипа", ЭтотОбъект, ДопПараметры);

	СписокТипов.ПоказатьВыборЭлемента(Оповещение, "Выбор типов");

КонецПроцедуры

Процедура ЗавершитьВыборТипа(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяТипа = ВыбранныйЭлемент.Значение;

	Если ДопПараметры.ОписаниеТипов Тогда
		Текст = СтрШаблон("Новый ОписаниеТипов(""%1"")", ИмяТипа);
	Иначе
		Текст = СтрШаблон("Тип(""%1"")", ИмяТипа);
	КонецЕсли;

	УстановитьТекст(ДопПараметры.Форма, Текст, Неопределено, Ложь);

КонецПроцедуры

Процедура СохранитьНастройкуРедактора(Имя, Значение)

	Настройки = dev_tools_ИнициализацияРедактораВызовСервера.НастройкиРедактора();

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = Новый Структура;
	КонецЕсли;

	Настройки.Вставить(Имя, Значение);

	dev_tools_ИнициализацияРедактораВызовСервера.СохранитьНастройкиРедактора(Настройки);

КонецПроцедуры

Асинх Процедура ВызватьКонструкторФорматнойСтроки(Форма, ПараметрыСтроки)

	Если ПараметрыСтроки = Неопределено Тогда
		ТекстВопроса = "Форматная строка не найдена." + Символы.ПС + "Создать новую форматную строку?";
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	
		ФорматнаяСтрока = "";
		Позиция = Неопределено;
	Иначе
		ФорматнаяСтрока = СтрЗаменить(СтрЗаменить(ПараметрыСтроки.text, "|", ""), """", "");
		Позиция = ПараметрыСтроки.range;
	КонецЕсли;
	
	Конструктор = Новый КонструкторФорматнойСтроки;
	Попытка
		Конструктор.Текст = ФорматнаяСтрока;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ПоказатьПредупреждение( , "Ошибка в тексте форматной строки:" + Символы.ПС + Инфо.Причина.Описание);
		Возврат;
	КонецПопытки;
	
	ФорматнаяСтрока = Ждать Конструктор.ОткрытьАсинх();
	
	Если ФорматнаяСтрока <> Неопределено Тогда
		ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "'", "");
		ФорматнаяСтрока = """" + ФорматнаяСтрока + """";
		УстановитьТекст(Форма, ФорматнаяСтрока, Позиция, Ложь);
	КонецЕсли;

КонецПроцедуры

Функция ДанныеДляКонструктораЗапроса(Знач ПараметрыВызова, Знач Форма)

	ТекстЗапроса = "";
	НачальнаяПозиция = 0;
	КонечнаяПозиция = 0;
	Если ПараметрыВызова = Неопределено Тогда
	
		Если View(Форма).queryMode Тогда
			ТекстЗапроса = ПолучитьТекст(Форма);
		Иначе
			// Попытаемся извлечь текст запроса из выделенного текста
			ТекстЗапроса = ПолучитьВыделенныйТекст(Форма);
	
			Строки = ПолучитьНомераСтрокВыделения(Форма);
			НачальнаяПозиция = Строки.startLine;
			КонечнаяПозиция = Строки.endLine;
		КонецЕсли;
	
	Иначе
		НачальнаяПозиция = ПараметрыВызова.range.startLineNumber;
		КонечнаяПозиция = ПараметрыВызова.range.endLineNumber;
		ТекстЗапроса = ПараметрыВызова.text;
	КонецЕсли;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("НачальнаяПозиция", НачальнаяПозиция);
	ДанныеЗапроса.Вставить("КонечнаяПозиция", КонечнаяПозиция);
	ДанныеЗапроса.Вставить("ТекстЗапроса", ТекстЗапроса);
	
	Возврат ДанныеЗапроса;

КонецФункции

Асинх Процедура ОткрытьКонструкторЗапроса(ТекстЗапроса, ДопПараметры)

	Попытка
		Конструктор = Новый КонструкторЗапроса(ТекстЗапроса);
	Исключение
		Инфо = ИнформацияОбОшибке();
		ПоказатьПредупреждение( , "Ошибка в тексте запроса:" + Символы.ПС + Инфо.Причина.Описание);
		Возврат;
	КонецПопытки;
	
	ТекстЗапроса = Ждать Конструктор.ОткрытьАсинх();
	
	УстановитьТекстЗапроса(ТекстЗапроса, ДопПараметры);

КонецПроцедуры

Процедура ПодготовитьТекстЗапросаККонструкторуЗапросов(ТекстЗапроса, Форма)

	Если Не View(Форма).queryMode Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "|", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """""", "$");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "$", """");
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьТекстЗапросаКРедакторуКода(ТекстЗапроса, Форма)

	Если Не View(Форма).queryMode Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС, Символы.ПС + "|");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", """""");
		ТекстЗапроса = """" + ТекстЗапроса + """";
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТекущуюТему(Форма)

	Возврат View(Форма).getTheme();

КонецФункции

Процедура УстановитьТекстЗапроса(ТекстЗапроса, Знач ДопПараметры)

	Форма = ДопПараметры.Форма;
	
	Если ТекстЗапроса <> Неопределено Тогда
	
		Если View(Форма).queryMode Тогда
			ОчиститьТекст(Форма);
			УстановитьТекст(Форма, ТекстЗапроса, Неопределено, Истина);
		Иначе
			ПодготовитьТекстЗапросаКРедакторуКода(ТекстЗапроса, Форма);
			ЗаменитьТекстПоНомерамСтрок(Форма, ТекстЗапроса, ДопПараметры.НачальнаяПозиция,
				ДопПараметры.КонечнаяПозиция);
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
