#Область ПрограммныйИнтерфейс

// Снимок единицы синхронизации: соответствие «относительный путь → текст файла».
//
// Параметры:
//  Вид - Строка - "Конвертация" или "Регистрация".
//  Наименование - Строка - наименование единицы.
//
// Возвращаемое значение:
//  Структура - Вид, Наименование, Файлы (Соответствие), Объекты (Соответствие путь → ссылка).
Функция НовыйСнимок(Вид, Наименование) Экспорт

	Снимок = Новый Структура;
	Снимок.Вставить("Вид", Вид);
	Снимок.Вставить("Наименование", Наименование);
	Снимок.Вставить("Файлы", Новый Соответствие);
	Снимок.Вставить("Объекты", Новый Соответствие);

	Возврат Снимок;

КонецФункции

// Имя каталога по идентичности объекта: символы, запрещённые в файловой системе,
// управляющие символы, концевые точки и пробелы заменяются подчёркиванием.
//
// Параметры:
//  Имя - Строка - идентичность объекта (код или наименование).
//
// Возвращаемое значение:
//  Строка - допустимое имя каталога.
Функция НормализоватьИмяКаталога(Имя) Экспорт

	Результат = СокрЛП(Имя);

	Для Каждого Символ Из СтрРазделить("\ / : * ? "" < > |", " ") Цикл
		Результат = СтрЗаменить(Результат, Символ, "_");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, Символы.Таб, "_");
	Результат = СтрЗаменить(Результат, Символы.ПС, "_");
	Результат = СтрЗаменить(Результат, Символы.ВК, "_");

	// Windows отбрасывает концевые точки и пробелы имени — каталог получил бы другое имя.
	Пока СтрДлина(Результат) > 0 И (Прав(Результат, 1) = "." Или Прав(Результат, 1) = " ") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1) + "_";
	КонецЦикла;

	Если ПустаяСтрока(Результат) Тогда
		ВызватьИсключение НСтр("ru = 'Пустое имя каталога: у объекта не заполнена идентичность'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Имя каталога объекта: нормализованная идентичность, а при заполненном коде —
// с суффиксом « (<код>)». Суффикс нужен только там, где имена соседей совпали:
// код ПКС и ПРО уникален в пределах владельца по контролю платформы и разводит
// такие каталоги однозначно.
//
// Параметры:
//  Идентичность - Строка - значение реквизита идентичности объекта.
//  Код - Строка, Число, Неопределено - код объекта; Неопределено или пустой — без суффикса.
//
// Возвращаемое значение:
//  Строка
Функция ИмяКаталогаОбъекта(Идентичность, Код = Неопределено) Экспорт

	Имя = НормализоватьИмяКаталога(Идентичность);
	Если Код = Неопределено Или Не ЗначениеЗаполнено(Код) Тогда
		Возврат Имя;
	КонецЕсли;

	Возврат Имя + " (" + НормализоватьИмяКаталога(КодСтрокой(Код)) + ")";

КонецФункции

// Приводит переводы строк к LF: и CRLF, и одиночный CR.
//
// Параметры:
//  Текст - Строка.
//
// Возвращаемое значение:
//  Строка.
Функция НормализоватьПереводыСтрок(Текст) Экспорт

	Результат = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Возврат СтрЗаменить(Результат, Символы.ВК, Символы.ПС);

КонецФункции

// Соединяет части относительного пути через "/". Пустые части пропускаются.
Функция СоединитьПуть(Часть1, Часть2) Экспорт

	Если ПустаяСтрока(Часть1) Тогда
		Возврат Часть2;
	КонецЕсли;
	Если ПустаяСтрока(Часть2) Тогда
		Возврат Часть1;
	КонецЕсли;

	Возврат Часть1 + "/" + Часть2;

КонецФункции

// Каталог объекта — путь без последнего сегмента.
//
// Параметры:
//  Путь - Строка - относительный путь файла.
//
// Возвращаемое значение:
//  Строка - "" для файлов в корне единицы.
Функция КаталогОбъекта(Путь) Экспорт

	Позиция = СтрНайти(Путь, "/", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Путь, Позиция - 1);

КонецФункции

// Вид объекта по имени его JSON-файла и положению каталога.
//
// Параметры:
//  КаталогОбъекта - Строка - каталог объекта относительно единицы.
//  Снимок - Структура - см. НовыйСнимок.
//
// Возвращаемое значение:
//  Строка - "Конвертация", "Регистрация", "ПКО", "ПКС", "ГруппаПКС", "ПОД", "ПКПД",
//           "Алгоритм", "Запрос", "ПРО", "ГруппаПРО"; "" — JSON объекта в каталоге не найден.
Функция ВидОбъекта(КаталогОбъекта, Снимок) Экспорт

	// Имена JSON известны наперёд — ищем их прямым обращением к соответствию, а не перебором
	// всех файлов снимка: функция вызывается на каждый каталог сверки и разбора.
	Если ПустаяСтрока(КаталогОбъекта) Тогда
		Префикс = "";
		ИменаJSON = "Конвертация, Регистрация";
	Иначе
		Префикс = КаталогОбъекта + "/";
		ИменаJSON = "ПКО, ПКС, ПОД, ПКПД, Алгоритм, Запрос, ПРО, Группа";
	КонецЕсли;

	ИмяJSON = "";
	Для Каждого Имя Из СтрРазделить(ИменаJSON, ", ") Цикл
		Если Снимок.Файлы[Префикс + Имя + ".json"] <> Неопределено Тогда
			ИмяJSON = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ИмяJSON <> "Группа" Тогда
		Возврат ИмяJSON;
	КонецЕсли;

	// Группы есть только у ПКС (внутри ПКО/<Код>/ПКС/) и у ПРО (в корне регистрации).
	Если СтрНачинаетсяС(КаталогОбъекта, "ПРО/") Тогда
		Возврат "ГруппаПРО";
	КонецЕсли;

	Возврат "ГруппаПКС";

КонецФункции

// Сравнивает снимок базы со снимком диска по объектам.
//
// Параметры:
//  СнимокБазы - Структура - см. НовыйСнимок.
//  СнимокДиска - Структура - см. НовыйСнимок.
//
// Возвращаемое значение:
//  Массив из Структура - Путь, Вид, Статус ("Новый", "Изменен", "НетВФайлах"), Файлы (Массив);
//                        совпавшие объекты в результат не попадают; порядок — по Путь.
Функция СравнитьСнимки(СнимокБазы, СнимокДиска) Экспорт

	Объекты = Новый Соответствие;

	Для Каждого Файл Из СнимокБазы.Файлы Цикл
		Описание = ОписаниеОбъектаСверки(Объекты, КаталогОбъекта(Файл.Ключ));
		Описание.ЕстьВБазе = Истина;
		ТекстДиска = СнимокДиска.Файлы[Файл.Ключ];
		Если ТекстДиска = Неопределено Тогда
			Описание.Файлы.Добавить(Файл.Ключ);
		ИначеЕсли ТекстДиска <> Файл.Значение Тогда
			Описание.Файлы.Добавить(Файл.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Файл Из СнимокДиска.Файлы Цикл
		Описание = ОписаниеОбъектаСверки(Объекты, КаталогОбъекта(Файл.Ключ));
		Описание.ЕстьНаДиске = Истина;
		Если СнимокБазы.Файлы[Файл.Ключ] = Неопределено Тогда
			Описание.Файлы.Добавить(Файл.Ключ);
		КонецЕсли;
	КонецЦикла;

	Пути = Новый СписокЗначений;
	Для Каждого Элемент Из Объекты Цикл
		Пути.Добавить(Элемент.Ключ);
	КонецЦикла;
	Пути.СортироватьПоЗначению(НаправлениеСортировки.Возр);

	Результат = Новый Массив;
	Для Каждого ЭлементПути Из Пути Цикл
		Путь = ЭлементПути.Значение;
		Описание = Объекты[Путь];
		Если Описание.ЕстьВБазе И Не Описание.ЕстьНаДиске Тогда
			Статус = "НетВФайлах";
			Вид = ВидОбъекта(Путь, СнимокБазы);
		ИначеЕсли Описание.ЕстьНаДиске И Не Описание.ЕстьВБазе Тогда
			Статус = "Новый";
			Вид = ВидОбъекта(Путь, СнимокДиска);
		ИначеЕсли Описание.Файлы.Количество() > 0 Тогда
			Статус = "Изменен";
			Вид = ВидОбъекта(Путь, СнимокДиска);
		Иначе
			Продолжить;
		КонецЕсли;

		Строка = Новый Структура("Путь, Вид, Статус, Файлы", Путь, Вид, Статус, Описание.Файлы);
		Результат.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Полный путь каталога единицы на клиенте.
//
// Параметры:
//  Корень - Строка - корневой каталог.
//  Вид - Строка - "Конвертация" или "Регистрация".
//  ИмяКаталога - Строка - имя каталога единицы в коллекции (см. ИмяКаталогаЕдиницы),
//                а не её наименование: с наименованием оно может не совпадать
//                (спека 2026-10-21). Нормализуется повторно — нормализация идемпотентна.
//
// Возвращаемое значение:
//  Строка - <Корень>\Конвертации\<имя> или <Корень>\Регистрации\<имя>.
Функция КаталогЕдиницы(Корень, Вид, ИмяКаталога) Экспорт

	Разделитель = ПолучитьРазделительПути();
	КорневойКаталог = Корень;
	Если СтрЗаканчиваетсяНа(КорневойКаталог, Разделитель) Тогда
		КорневойКаталог = Лев(КорневойКаталог, СтрДлина(КорневойКаталог) - 1);
	КонецЕсли;

	Если Вид = "Регистрация" Тогда
		Коллекция = "Регистрации";
	Иначе
		Коллекция = "Конвертации";
	КонецЕсли;

	Возврат КорневойКаталог + Разделитель + Коллекция + Разделитель + НормализоватьИмяКаталога(ИмяКаталога);

КонецФункции

// Имя каталога единицы в репозитории: записанное в ТЧ репозитория, а у строк, закреплённых
// до появления реквизита ИмяКаталога, — нормализованное наименование, как раньше.
//
// Параметры:
//  ИмяКаталога - Строка - значение реквизита ТЧ, может быть пустым.
//  Наименование - Строка - наименование единицы в базе.
//
// Возвращаемое значение:
//  Строка
Функция ИмяКаталогаЕдиницы(ИмяКаталога, Наименование) Экспорт

	Если ПустаяСтрока(ИмяКаталога) Тогда
		Возврат НормализоватьИмяКаталога(Наименование);
	КонецЕсли;

	Возврат ИмяКаталога;

КонецФункции

// Каталог правил репозитория: рабочая копия плюс подкаталог внутри неё.
// Собирается в одном месте — путь нужен и форме, и справочнику, и тестам.
//
// Параметры:
//  КаталогРепозитория - Строка - путь к рабочей копии (каталог, в котором лежит .git).
//  ПодкаталогПравил - Строка - относительный путь внутри репозитория; пустой — корень.
//
// Возвращаемое значение:
//  Строка - путь без концевого разделителя.
Функция КаталогПравил(КаталогРепозитория, ПодкаталогПравил) Экспорт

	Разделитель = ПолучитьРазделительПути();

	Корень = СтрЗаменить(СокрЛП(КаталогРепозитория), "/", Разделитель);
	Пока СтрДлина(Корень) > 0 И Прав(Корень, 1) = Разделитель Цикл
		Корень = Лев(Корень, СтрДлина(Корень) - 1);
	КонецЦикла;

	Подкаталог = СтрЗаменить(СокрЛП(ПодкаталогПравил), "/", Разделитель);
	Пока СтрДлина(Подкаталог) > 0 И Лев(Подкаталог, 1) = Разделитель Цикл
		Подкаталог = Сред(Подкаталог, 2);
	КонецЦикла;
	Пока СтрДлина(Подкаталог) > 0 И Прав(Подкаталог, 1) = Разделитель Цикл
		Подкаталог = Лев(Подкаталог, СтрДлина(Подкаталог) - 1);
	КонецЦикла;

	Если ПустаяСтрока(Подкаталог) Тогда
		Возврат Корень;
	КонецЕсли;

	Возврат Корень + Разделитель + Подкаталог;

КонецФункции

// SHA-256 содержимого снимка; порядок вставки файлов на хеш не влияет.
// Только сервер: ХешированиеДанных недоступна в тонком и веб-клиенте, поэтому форма
// получает хеш через серверный фасад, а на клиенте вызов даёт исключение.
Функция ХешСнимка(Снимок) Экспорт

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда
	Пути = Новый СписокЗначений;
	Для Каждого Файл Из Снимок.Файлы Цикл
		Пути.Добавить(Файл.Ключ);
	КонецЦикла;
	Пути.СортироватьПоЗначению(НаправлениеСортировки.Возр);

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Для Каждого ЭлементПути Из Пути Цикл
		Хеширование.Добавить(ЭлементПути.Значение + Символы.ПС);
		Хеширование.Добавить(Снимок.Файлы[ЭлементПути.Значение] + Символы.ПС);
	КонецЦикла;

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);
#Иначе
	ВызватьИсключение НСтр(
		"ru = 'ХешСнимка недоступен в тонком и веб-клиенте: вызывайте с сервера'");
#КонецЕсли

КонецФункции

// SHA-256 текста каждого файла снимка. Только сервер — по той же причине, что ХешСнимка.
//
// Параметры:
//  Снимок - Структура - см. НовыйСнимок.
//
// Возвращаемое значение:
//  Соответствие - относительный путь файла → hex-строка SHA-256 его текста.
Функция ХешиФайлов(Снимок) Экспорт

#Если Сервер Или ВнешнееСоединение Или ТолстыйКлиентОбычноеПриложение Тогда
	Хеши = Новый Соответствие;
	Для Каждого Файл Из Снимок.Файлы Цикл
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Файл.Значение);
		Хеши.Вставить(Файл.Ключ, ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	КонецЦикла;

	Возврат Хеши;
#Иначе
	ВызватьИсключение НСтр(
		"ru = 'ХешиФайлов недоступен в тонком и веб-клиенте: вызывайте с сервера'");
#КонецЕсли

КонецФункции

// Значение, которое точка синхронизации хранит у пути с неизвестной общей версией:
// в момент точки база и каталог по нему расходились (спека 2026-10-31, §3.1).
// Отсутствие пути в точке означает другое — в общей версии файла не было.
//
// Возвращаемое значение:
//  Строка
Функция НеизвестнаяВерсия() Экспорт

	Возврат "?";

КонецФункции

// Происхождение различия одного файла (спека 2026-10-31, §3.1).
//
// Параметры:
//  ХешБазы - Строка, Неопределено - хеш файла в снимке базы; Неопределено — файла в базе нет.
//  ХешФайла - Строка, Неопределено - хеш файла на диске; Неопределено — файла на диске нет.
//  ХешТочки - Строка, Неопределено - общая версия: хеш, НеизвестнаяВерсия() или
//             Неопределено — в общей версии файла не было.
//
// Возвращаемое значение:
//  Строка - "ВФайлах", "ВБазе", "СОбеихСторон", "Неизвестно"; "" — различия нет.
Функция ПроисхождениеФайла(ХешБазы, ХешФайла, ХешТочки) Экспорт

	Если ХешБазы = ХешФайла Тогда
		Возврат "";
	КонецЕсли;
	Если ХешТочки = НеизвестнаяВерсия() Тогда
		Возврат "Неизвестно";
	КонецЕсли;
	Если ХешБазы = ХешТочки Тогда
		Возврат "ВФайлах";
	КонецЕсли;
	Если ХешФайла = ХешТочки Тогда
		Возврат "ВБазе";
	КонецЕсли;

	Возврат "СОбеихСторон";

КонецФункции

// Происхождение объекта из происхождений его файлов: однородное сохраняется,
// конфликт сильнее неизвестного, неизвестное сильнее одной стороны, смесь сторон — конфликт.
//
// Параметры:
//  Происхождения - Массив из Строка - см. ПроисхождениеФайла; пустые строки пропускаются.
//
// Возвращаемое значение:
//  Строка - код происхождения; "" — если различий нет.
Функция ПроисхождениеОбъекта(Происхождения) Экспорт

	ЕстьНеизвестное = Ложь;
	Стороны = Новый Соответствие;
	Для Каждого Происхождение Из Происхождения Цикл
		Если ПустаяСтрока(Происхождение) Тогда
			Продолжить;
		КонецЕсли;
		Если Происхождение = "СОбеихСторон" Тогда
			Возврат Происхождение;
		КонецЕсли;
		Если Происхождение = "Неизвестно" Тогда
			ЕстьНеизвестное = Истина;
		Иначе
			Стороны.Вставить(Происхождение, Истина);
		КонецЕсли;
	КонецЦикла;

	Если ЕстьНеизвестное Тогда
		Возврат "Неизвестно";
	КонецЕсли;
	Если Стороны.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Стороны.Количество() > 1 Тогда
		Возврат "СОбеихСторон";
	КонецЕсли;

	Для Каждого Сторона Из Стороны Цикл
		Возврат Сторона.Ключ;
	КонецЦикла;

КонецФункции

// Происхождение строки сверки по её файлам.
//
// Параметры:
//  Файлы - Массив из Строка - файлы строки сверки (см. СравнитьСнимки).
//  ХешиБазы - Соответствие - см. ХешиФайлов, по снимку базы.
//  ХешиФайлов - Соответствие - см. ХешиФайлов, по снимку с диска.
//  Точка - Соответствие, Неопределено - хеши общей версии; Неопределено — точки нет,
//          общая версия всех файлов неизвестна.
//
// Возвращаемое значение:
//  Строка - см. ПроисхождениеОбъекта.
Функция ПроисхождениеСтроки(Файлы, ХешиБазы, ХешиФайлов, Точка) Экспорт

	Происхождения = Новый Массив;
	Для Каждого Путь Из Файлы Цикл
		Если Точка = Неопределено Тогда
			ХешТочки = НеизвестнаяВерсия();
		Иначе
			ХешТочки = Точка[Путь];
		КонецЕсли;
		Происхождения.Добавить(ПроисхождениеФайла(ХешиБазы[Путь], ХешиФайлов[Путь], ХешТочки));
	КонецЦикла;

	Возврат ПроисхождениеОбъекта(Происхождения);

КонецФункции

// Точка после выгрузки: каталог теперь равен базе целиком (спека 2026-10-31, §3.2).
//
// Параметры:
//  ХешиБазы - Соответствие - см. ХешиФайлов, по выгруженному снимку базы.
//
// Возвращаемое значение:
//  Соответствие - новая точка; входное соответствие не меняется.
Функция ТочкаПослеВыгрузки(ХешиБазы) Экспорт

	Точка = Новый Соответствие;
	Для Каждого Элемент Из ХешиБазы Цикл
		Точка.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Точка;

КонецФункции

// Точка после сверки (спека 2026-10-31, §3.2): согласованный файл получает свой хеш,
// у расходящегося запись сохраняется (в том числе её отсутствие), а без точки становится
// неизвестной. Пути, которых нет ни в базе, ни в каталоге, из точки уходят.
//
// Параметры:
//  Точка - Соответствие, Неопределено - текущая точка; Неопределено — точки нет.
//  ХешиБазы - Соответствие - см. ХешиФайлов.
//  ХешиФайлов - Соответствие - см. ХешиФайлов.
//
// Возвращаемое значение:
//  Соответствие - новая точка; входные соответствия не меняются.
Функция ТочкаПослеСверки(Точка, ХешиБазы, ХешиФайлов) Экспорт

	НоваяТочка = Новый Соответствие;
	Для Каждого Путь Из ОбъединениеПутей(ХешиБазы, ХешиФайлов) Цикл
		ХешБазы = ХешиБазы[Путь];
		Если ХешБазы = ХешиФайлов[Путь] Тогда
			НоваяТочка.Вставить(Путь, ХешБазы);
		ИначеЕсли Точка = Неопределено Тогда
			НоваяТочка.Вставить(Путь, НеизвестнаяВерсия());
		ИначеЕсли Точка[Путь] <> Неопределено Тогда
			НоваяТочка.Вставить(Путь, Точка[Путь]);
		КонецЕсли;
	КонецЦикла;

	Возврат НоваяТочка;

КонецФункции

// Точка после загрузки (спека 2026-10-31, §3.2): файлы применённых объектов получают хеш
// с диска, их файлы, которых на диске нет, и файлы удалённых объектов из точки уходят;
// записи прочих объектов не меняются — расхождение по неотмеченным строкам остаётся видимым.
//
// Параметры:
//  Точка - Соответствие, Неопределено - точка, записанная сверкой; Неопределено — новая
//          единица, начинается с пустой точки.
//  ХешиФайлов - Соответствие - см. ХешиФайлов, по загруженному снимку с диска.
//  ПрименённыеПути - Массив из Строка - пути применённых объектов.
//  УдалённыеПути - Массив из Строка - пути объектов, помеченных на удаление.
//
// Возвращаемое значение:
//  Соответствие - новая точка; входные соответствия не меняются.
Функция ТочкаПослеЗагрузки(Точка, ХешиФайлов, ПрименённыеПути, УдалённыеПути) Экспорт

	Применённые = Новый Соответствие;
	Затронутые = Новый Соответствие;
	Для Каждого Путь Из ПрименённыеПути Цикл
		Применённые.Вставить(Путь, Истина);
		Затронутые.Вставить(Путь, Истина);
	КонецЦикла;
	Для Каждого Путь Из УдалённыеПути Цикл
		Затронутые.Вставить(Путь, Истина);
	КонецЦикла;

	НоваяТочка = Новый Соответствие;
	Если Точка <> Неопределено Тогда
		Для Каждого Элемент Из Точка Цикл
			Если Затронутые[КаталогОбъекта(Элемент.Ключ)] = Неопределено Тогда
				НоваяТочка.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Элемент Из ХешиФайлов Цикл
		Если Применённые[КаталогОбъекта(Элемент.Ключ)] <> Неопределено Тогда
			НоваяТочка.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат НоваяТочка;

КонецФункции

// Объекты, которые выгрузка затёрла бы, не загрузив: файл расходится с базой и не равен
// общей версии (спека 2026-10-31, §3.4). Неизвестная общая версия с файлом не совпадает
// никогда, поэтому без точки сюда попадает любое различие — кроме первой выгрузки в пустой
// каталог: без точки и без файлов создание файлов ничего не затирает.
//
// Параметры:
//  ХешиБазы - Соответствие - см. ХешиФайлов.
//  ХешиФайлов - Соответствие - см. ХешиФайлов.
//  Точка - Соответствие, Неопределено - текущая точка; Неопределено — точки нет.
//
// Возвращаемое значение:
//  Массив из Строка - пути объектов по возрастанию, без повторов.
Функция НеЗагруженныеОбъекты(ХешиБазы, ХешиФайлов, Точка) Экспорт

	// Первая выгрузка в пустой каталог: создание файлов ничего не затирает
	// (спека 2026-10-31, §3.4).
	Если Точка = Неопределено И ХешиФайлов.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Объекты = Новый Соответствие;
	Для Каждого Путь Из ОбъединениеПутей(ХешиБазы, ХешиФайлов) Цикл
		ХешФайла = ХешиФайлов[Путь];
		Если ХешиБазы[Путь] = ХешФайла Тогда
			Продолжить;
		КонецЕсли;
		Если Точка = Неопределено Тогда
			ХешТочки = НеизвестнаяВерсия();
		Иначе
			ХешТочки = Точка[Путь];
		КонецЕсли;
		Если ХешТочки <> ХешФайла Тогда
			Объекты.Вставить(КаталогОбъекта(Путь), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат ОтсортированныеКлючи(Объекты);

КонецФункции

// Текст вопроса перед выгрузкой, затирающей незагруженные изменения (спека 2026-10-31, §3.4).
//
// Параметры:
//  НеЗагруженные - Массив из Структура:
//   * Единица - Строка - представление единицы.
//   * Пути - Массив из Строка - см. НеЗагруженныеОбъекты.
//
// Возвращаемое значение:
//  Строка
Функция ТекстВопросаВыгрузки(НеЗагруженные) Экспорт

	ПределСписка = 10;
	Абзацы = Новый Массив;
	Для Каждого ЕдиницаВыгрузки Из НеЗагруженные Цикл
		Показанные = Новый Массив;
		Для Каждого Путь Из ЕдиницаВыгрузки.Пути Цикл
			Если Показанные.Количество() = ПределСписка Тогда
				Прервать;
			КонецЕсли;
			Если ПустаяСтрока(Путь) Тогда
				Показанные.Добавить(НСтр("ru = 'Шапка'"));
			Иначе
				Показанные.Добавить(Путь);
			КонецЕсли;
		КонецЦикла;
		Остаток = ЕдиницаВыгрузки.Пути.Количество() - Показанные.Количество();
		Если Остаток > 0 Тогда
			Показанные.Добавить(СтрШаблон(НСтр("ru = '…ещё %1'"), Остаток));
		КонецЕсли;

		Абзацы.Добавить(СтрШаблон(
			НСтр("ru = 'В каталоге единицы «%1» изменены после последней синхронизации и не загружены в базу объекты (%2):
				|  %3'"),
			ЕдиницаВыгрузки.Единица, ЕдиницаВыгрузки.Пути.Количество(), СтрСоединить(Показанные, ", ")));
	КонецЦикла;

	Абзацы.Добавить(НСтр("ru = 'Выгрузка заменит их версией из базы.'"));

	Возврат СтрСоединить(Абзацы, Символы.ПС + Символы.ПС);

КонецФункции

// Сообщение операции для показа в форме.
//
// Параметры:
//  Уровень - Строка - "Ошибка", "Предупреждение", "Информация".
//  Объект - Строка - путь объекта относительно единицы.
//  Текст - Строка.
//
// Возвращаемое значение:
//  Структура - Уровень, Объект, Текст.
Функция НовоеСообщение(Уровень, Объект, Текст) Экспорт

	Возврат Новый Структура("Уровень, Объект, Текст", Уровень, Объект, Текст);

КонецФункции


// Узлы дерева сверки: плоский список в порядке обхода сверху вниз, из которого форма
// строит дерево. Узел — это префикс пути; узлы, которым соответствует строка сверки,
// объектные и несут вид, статус и файлы, остальные — служебные группировки.
//
// Параметры:
//  СтрокиСверки - Массив из Структура - Единица (представление), Путь, Вид, Статус, Файлы,
//                 Происхождение;
//                 строки одной единицы идут подряд, пути внутри единицы отсортированы.
//
// Возвращаемое значение:
//  Массив из Структура - Уровень (Число, 0 — единица), Имя, Единица, Путь, ПутьРодителя,
//   ЭтоОбъект (Булево), Вид, Статус, Файлы, Происхождение (код), Изменено (его представление).
//   ПутьРодителя: путь узла-родителя внутри той же единицы; "" у узла единицы и у узлов
//   первого уровня, родителем которых выступает узел единицы. Форма вкладывает узлы
//   по нему: по порядку строк вкладывать нельзя, строковая сортировка путей
//   не гарантирует, что потомок идёт сразу за родителем («ПКО/Магазин 2» раньше
//   «ПКО/Магазин/ПКС/X», потому что пробел меньше слеша).
Функция УзлыДереваСверки(СтрокиСверки) Экспорт

	Узлы = Новый Массив;
	Созданные = Новый Соответствие;
	ПоследняяЕдиница = Неопределено;

	Для Каждого ТекущаяСтрока Из СтрокиСверки Цикл
		Если ТекущаяСтрока.Единица <> ПоследняяЕдиница Тогда
			Узлы.Добавить(НовыйУзелДерева(0, ТекущаяСтрока.Единица, ТекущаяСтрока.Единица, ""));
			ПоследняяЕдиница = ТекущаяСтрока.Единица;
		КонецЕсли;

		Если ПустаяСтрока(ТекущаяСтрока.Путь) Тогда
			// Шапка единицы: путь пустой, поэтому отдельным узлом первого уровня.
			// В карту созданных шапка не попадает: её ключом был бы «единица плюс пустой
			// путь», а потомков у неё нет и такой ключ никто не ищет.
			Узел = НовыйУзелДерева(1, НСтр("ru = 'Шапка'"), ТекущаяСтрока.Единица, "");
			СделатьУзелОбъектным(Узел, ТекущаяСтрока);
			Узлы.Добавить(Узел);
			Продолжить;
		КонецЕсли;

		Сегменты = СтрРазделить(ТекущаяСтрока.Путь, "/", Ложь);
		Префикс = "";
		Для Индекс = 0 По Сегменты.ВГраница() Цикл
			Если ПустаяСтрока(Префикс) Тогда
				Префикс = Сегменты[Индекс];
			Иначе
				Префикс = Префикс + "/" + Сегменты[Индекс];
			КонецЕсли;

			Ключ = ТекущаяСтрока.Единица + "|" + Префикс;
			Существующий = Созданные[Ключ];
			Если Существующий <> Неопределено Тогда
				// Вложенная строка могла прийти раньше родительской — тогда служебный
				// узел становится объектным, не теряя уже созданных потомков.
				Если Префикс = ТекущаяСтрока.Путь Тогда
					СделатьУзелОбъектным(Существующий, ТекущаяСтрока);
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Узел = НовыйУзелДерева(Индекс + 1, Сегменты[Индекс], ТекущаяСтрока.Единица, Префикс,
				КаталогОбъекта(Префикс));
			Если Префикс = ТекущаяСтрока.Путь Тогда
				СделатьУзелОбъектным(Узел, ТекущаяСтрока);
			КонецЕсли;
			Узлы.Добавить(Узел);
			Созданные.Вставить(Ключ, Узел);
		КонецЦикла;
	КонецЦикла;

	Возврат Узлы;

КонецФункции

// Отметка объектного узла дерева сверки по режиму массовой отметки.
//
// Параметры:
//  Статус - Строка - статус строки сверки: "Новый", "Изменен" или "НетВФайлах".
//  Режим - Строка - "Ничего", "Все" или "Применяемые"; любое другое значение
//          работает как "Применяемые".
//  Происхождение - Строка - см. ПроисхождениеСтроки.
//
// Возвращаемое значение:
//  Булево - "Применяемые" отмечают только пришедшее из файлов и не "НетВФайлах": правка базы,
//   конфликт и неизвестное откатили бы работу в базе, а пометка на удаление требует явного
//   решения пользователя (спека 2026-10-31, §3.4).
Функция ОтметкаПоРежиму(Статус, Режим, Происхождение) Экспорт

	Если Режим = "Ничего" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Режим = "Все" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Статус <> "НетВФайлах" И Происхождение = "ВФайлах";

КонецФункции

// Отметка, которую узел дерева сверки отдаёт своему родителю при пересчёте.
//
// Параметры:
//  ЭтоОбъект - Булево - узлу соответствует строка сверки.
//  СобственнаяОтметка - Булево - текущая отметка самого узла.
//  ВсеПотомкиОтмечены - Булево - итог пересчёта потомков.
//
// Возвращаемое значение:
//  Булево - у служебной группировки это состояние поддерева, и его же она показывает
//   флажком; у объектного узла — "своя отметка И все потомки", а собственная отметка
//   остаётся при нём. Правило группировки у объекта было бы кражей выбора: ПКО с ПКС
//   внутри — объект, и отметка одного ПКС не должна исключать из конвертации весь ПКО.
Функция ОтметкаРодителя(ЭтоОбъект, СобственнаяОтметка, ВсеПотомкиОтмечены) Экспорт

	Если ЭтоОбъект Тогда
		Возврат СобственнаяОтметка И ВсеПотомкиОтмечены;
	КонецЕсли;

	Возврат ВсеПотомкиОтмечены;

КонецФункции

// Разбор отмеченных строк сверки по действиям, которые выполнит загрузка.
//
// Параметры:
//  Статусы - Массив из Строка - статусы отмеченных объектных узлов.
//
// Возвращаемое значение:
//  Структура - Создать, Обновить, Пометить (Число).
Функция СводкаЗагрузки(Статусы) Экспорт

	Сводка = Новый Структура("Создать, Обновить, Пометить", 0, 0, 0);
	Для Каждого Статус Из Статусы Цикл
		Если Статус = "Новый" Тогда
			Сводка.Создать = Сводка.Создать + 1;
		ИначеЕсли Статус = "Изменен" Тогда
			Сводка.Обновить = Сводка.Обновить + 1;
		ИначеЕсли Статус = "НетВФайлах" Тогда
			Сводка.Пометить = Сводка.Пометить + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Сводка;

КонецФункции

// Сколько отмеченных строк откатят правки базы — для подтверждения загрузки.
//
// Параметры:
//  Происхождения - Массив из Строка - происхождения отмеченных объектных узлов.
//
// Возвращаемое значение:
//  Число - строки "ВБазе" и "СОбеихСторон".
Функция СводкаОткатов(Происхождения) Экспорт

	Откатов = 0;
	Для Каждого Происхождение Из Происхождения Цикл
		Если Происхождение = "ВБазе" Или Происхождение = "СОбеихСторон" Тогда
			Откатов = Откатов + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Откатов;

КонецФункции

// Представление происхождения в колонке «Изменено» дерева сверки.
//
// Параметры:
//  Происхождение - Строка - см. ПроисхождениеСтроки.
//
// Возвращаемое значение:
//  Строка
Функция ПредставлениеПроисхождения(Происхождение) Экспорт

	Если Происхождение = "ВФайлах" Тогда
		Возврат НСтр("ru = 'в файлах'");
	ИначеЕсли Происхождение = "ВБазе" Тогда
		Возврат НСтр("ru = 'в базе'");
	ИначеЕсли Происхождение = "СОбеихСторон" Тогда
		Возврат НСтр("ru = 'с обеих сторон'");
	ИначеЕсли Происхождение = "Неизвестно" Тогда
		Возврат НСтр("ru = 'неизвестно'");
	КонецЕсли;

	Возврат "";

КонецФункции


// Ветка по содержимому файла HEAD git.
//
// Параметры:
//  Содержимое - Строка - текст файла HEAD.
//
// Возвращаемое значение:
//  Строка - имя локальной ветки; полная ссылка, если HEAD указывает не на локальную ветку;
//   первые 8 символов коммита при detached HEAD; пусто, если содержимое не разобрано.
Функция ВеткаИзHEAD(Содержимое) Экспорт

	ПерваяСтрока = СокрЛП(СтрПолучитьСтроку(Содержимое, 1));
	ПрефиксВетки = "ref: refs/heads/";
	Если СтрНачинаетсяС(ПерваяСтрока, ПрефиксВетки) Тогда
		Возврат Сред(ПерваяСтрока, СтрДлина(ПрефиксВетки) + 1);
	КонецЕсли;
	ПрефиксСсылки = "ref: ";
	Если СтрНачинаетсяС(ПерваяСтрока, ПрефиксСсылки) Тогда
		Возврат Сред(ПерваяСтрока, СтрДлина(ПрефиксСсылки) + 1);
	КонецЕсли;
	Если ЭтоХешКоммита(ПерваяСтрока) Тогда
		Возврат Лев(ПерваяСтрока, 8);
	КонецЕсли;

	Возврат "";

КонецФункции

// Текущая ветка рабочей копии — чтением .git/HEAD, без запуска git (спека 2026-10-31, §3.4).
// Ветка — справка для пользователя: любая ошибка чтения даёт пустую строку, а не исключение.
//
// Параметры:
//  КаталогРепозитория - Строка - корень рабочей копии.
//
// Возвращаемое значение:
//  Строка - см. ВеткаИзHEAD; пусто, если .git нет или он не разобран.
Функция ТекущаяВетка(КаталогРепозитория) Экспорт

	Если ПустаяСтрока(КаталогРепозитория) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ВеткаРабочейКопии(КаталогРепозитория);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Сменилась ли ветка после точки: только когда известны обе ветки.
//
// Параметры:
//  ВеткаТочки - Строка
//  ВеткаСейчас - Строка
//
// Возвращаемое значение:
//  Булево
Функция ВеткаСменилась(ВеткаТочки, ВеткаСейчас) Экспорт

	Возврат Не ПустаяСтрока(ВеткаТочки) И Не ПустаяСтрока(ВеткаСейчас) И ВеткаТочки <> ВеткаСейчас;

КонецФункции

// Представление точки в таблице единиц.
//
// Параметры:
//  МоментТочки - Дата - момент точки; пустая — точки нет.
//  Ветка - Строка
//
// Возвращаемое значение:
//  Строка - "30.10 14:02 · main"; без ветки — только дата; пусто, если точки нет.
Функция ПредставлениеТочки(МоментТочки, Ветка) Экспорт

	Если Не ЗначениеЗаполнено(МоментТочки) Тогда
		Возврат "";
	КонецЕсли;

	Представление = Формат(МоментТочки, "ДФ='дд.ММ ЧЧ:мм'");
	Если Не ПустаяСтрока(Ветка) Тогда
		Представление = Представление + " · " + Ветка;
	КонецЕсли;

	Возврат Представление;

КонецФункции

