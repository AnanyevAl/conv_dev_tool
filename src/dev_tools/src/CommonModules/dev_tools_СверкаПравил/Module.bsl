#Область СлужебныеПроцедурыИФункции

// ПутьРодителя по умолчанию пустой: его не имеют ни узел единицы, ни узлы первого
// уровня — их родитель и есть узел единицы.
Функция НовыйУзелДерева(Уровень, Имя, Единица, Путь, ПутьРодителя = "")

	Узел = Новый Структура;
	Узел.Вставить("Уровень", Уровень);
	Узел.Вставить("Имя", Имя);
	Узел.Вставить("Единица", Единица);
	Узел.Вставить("Путь", Путь);
	Узел.Вставить("ПутьРодителя", ПутьРодителя);
	Узел.Вставить("ЭтоОбъект", Ложь);
	Узел.Вставить("Вид", "");
	Узел.Вставить("Статус", "");
	Узел.Вставить("Файлы", "");
	Узел.Вставить("Происхождение", "");
	Узел.Вставить("Изменено", "");

	Возврат Узел;

КонецФункции

Процедура СделатьУзелОбъектным(Узел, СтрокаИсточник)

	Узел.ЭтоОбъект = Истина;
	Узел.Вид = СтрокаИсточник.Вид;
	Узел.Статус = СтрокаИсточник.Статус;
	Узел.Файлы = СтрокаИсточник.Файлы;
	Узел.Происхождение = СтрокаИсточник.Происхождение;
	Узел.Изменено = ПредставлениеПроисхождения(СтрокаИсточник.Происхождение);

КонецПроцедуры

// Код в строку без группировки разрядов: Строка(1000) дала бы «1 000» с неразрывным
// пробелом, и имя каталога не совпало бы с кодом из файла.
Функция КодСтрокой(Код)

	Если ТипЗнч(Код) = Тип("Число") Тогда
		Возврат Формат(Код, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Код);

КонецФункции

Функция ОписаниеОбъектаСверки(Объекты, Каталог)

	Описание = Объекты[Каталог];
	Если Описание = Неопределено Тогда
		Описание = Новый Структура("ЕстьВБазе, ЕстьНаДиске, Файлы", Ложь, Ложь, Новый Массив);
		Объекты.Вставить(Каталог, Описание);
	КонецЕсли;

	Возврат Описание;

КонецФункции

Функция ОбъединениеПутей(ПервыеХеши, ВторыеХеши)

	Пути = Новый Массив;
	Для Каждого Элемент Из ПервыеХеши Цикл
		Пути.Добавить(Элемент.Ключ);
	КонецЦикла;
	Для Каждого Элемент Из ВторыеХеши Цикл
		Если ПервыеХеши[Элемент.Ключ] = Неопределено Тогда
			Пути.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Пути;

КонецФункции

Функция ОтсортированныеКлючи(Элементы)

	Ключи = Новый СписокЗначений;
	Для Каждого Элемент Из Элементы Цикл
		Ключи.Добавить(Элемент.Ключ);
	КонецЦикла;
	Ключи.СортироватьПоЗначению(НаправлениеСортировки.Возр);

	Возврат Ключи.ВыгрузитьЗначения();

КонецФункции

Функция ВеткаРабочейКопии(КаталогРепозитория)

	Разделитель = ПолучитьРазделительПути();
	Корень = КаталогРепозитория;
	Если СтрЗаканчиваетсяНа(Корень, Разделитель) Тогда
		Корень = Лев(Корень, СтрДлина(Корень) - 1);
	КонецЕсли;

	ПутьGit = Корень + Разделитель + ".git";
	ФайлGit = Новый Файл(ПутьGit);
	Если Не ФайлGit.Существует() Тогда
		Возврат "";
	КонецЕсли;

	// Worktree и подмодуль: .git — файл со строкой «gitdir: <путь>», путь бывает относительным.
	Если ФайлGit.ЭтоКаталог() Тогда
		КаталогGit = ПутьGit;
	Иначе
		ПерваяСтрока = СокрЛП(СтрПолучитьСтроку(ТекстФайла(ПутьGit), 1));
		Если Не СтрНачинаетсяС(ПерваяСтрока, "gitdir:") Тогда
			Возврат "";
		КонецЕсли;
		КаталогGit = СокрЛП(Сред(ПерваяСтрока, СтрДлина("gitdir:") + 1));
		Если Не ЭтоАбсолютныйПуть(КаталогGit) Тогда
			КаталогGit = Корень + Разделитель + КаталогGit;
		КонецЕсли;
	КонецЕсли;

	ПутьHEAD = КаталогGit + Разделитель + "HEAD";
	ФайлHEAD = Новый Файл(ПутьHEAD);
	Если Не ФайлHEAD.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Возврат ВеткаИзHEAD(ТекстФайла(ПутьHEAD));

КонецФункции

Функция ТекстФайла(Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ЭтоАбсолютныйПуть(Путь)

	Возврат Сред(Путь, 2, 1) = ":" Или СтрНачинаетсяС(Путь, "\") Или СтрНачинаетсяС(Путь, "/");

КонецФункции

// 40 (SHA-1) или 64 (SHA-256) шестнадцатеричных символа в нижнем регистре — так git пишет HEAD.
Функция ЭтоХешКоммита(Значение)

	Длина = СтрДлина(Значение);
	Если Длина <> 40 И Длина <> 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По Длина Цикл
		Если СтрНайти("0123456789abcdef", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти
