#Область ПрограммныйИнтерфейс

// Возвращает описание вкладок с текстами алгоритмов для формы правила.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника правил, например "ПравилаОбработкиДанных".
//  ТипКонвертацииXML - Булево - Истина: вкладки правил формата XML, Ложь: формата XDTO.
//  ИмяФормы - Строка - имя формы, если у справочника их несколько с разным составом
//                      вкладок (форма элемента и форма группы); иначе пустая строка.
//
// Возвращаемое значение:
//  Структура - ключ соответствует имени страницы формы, значение - Структура:
//   * Реквизит - Строка - имя реквизита объекта с текстом алгоритма.
//   * Код - Строка - текущий текст; заполняет форма.
//   * КодЗаполнен - Булево - признак непустого текста; заполняет форма.
//   * КлючСобытия - Строка - ключ в макете сигнатур; пустая строка, если сигнатуры нет.
//   * Параметры - Массив из Строка - переменные контекста обработчика.
Функция ОписаниеВкладок(ИмяСправочника, ТипКонвертацииXML, ИмяФормы = "") Экспорт

	ПараметрыСобытий = dev_tools_ПодсказкиОбработчиков.ПараметрыСобытий();
	Вкладки = Новый Структура;

	Если ИмяСправочника = "ПравилаОбработкиДанных" И ТипКонвертацииXML Тогда

		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередОбработкой",
			"АлгоритмПередОбработкойПравила", "ПВД_ПередОбработкойПравила");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередВыгрузкой",
			"АлгоритмПередВыгрузкойОбъекта", "ПВД_ПередВыгрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеВыгрузки",
			"АлгоритмПослеВыгрузкиОбъекта", "ПВД_ПослеВыгрузкиОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеОбработки",
			"АлгоритмПослеОбработкиПравила", "ПВД_ПослеОбработкиПравила");

	ИначеЕсли ИмяСправочника = "Алгоритмы" Тогда

		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаАлгоритм", "Алгоритм", "");

	ИначеЕсли ИмяСправочника = "Запросы" Тогда

		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаТекстЗапроса", "ТекстЗапроса", "");

	ИначеЕсли ИмяСправочника = "ПравилаКонвертацииСвойств" И ТипКонвертацииXML Тогда

		// Состав вкладок у элемента и у группы разный, поэтому различаем по форме.
		Если ИмяФормы = "ФормаГруппы" Тогда

			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередОбработкой",
				"АлгоритмПередОбработкойВыгрузки", "ПКГС_ПередОбработкойВыгрузки");
			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередВыгрузкой",
				"АлгоритмПередВыгрузкойСвойства", "ПКГС_ПередВыгрузкойСвойства");
			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПриВыгрузке",
				"АлгоритмПриВыгрузкеСвойства", "ПКГС_ПриВыгрузкеСвойства");
			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеВыгрузки",
				"АлгоритмПослеВыгрузкиСвойства", "ПКГС_ПослеВыгрузкиСвойства");
			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеОбработки",
				"АлгоритмПослеОбработкиВыгрузки", "ПКГС_ПослеОбработкиВыгрузки");

		Иначе

			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередВыгрузкой",
				"АлгоритмПередВыгрузкойСвойства", "ПКС_ПередВыгрузкойСвойства");
			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПриВыгрузке",
				"АлгоритмПриВыгрузкеСвойства", "ПКС_ПриВыгрузкеСвойства");
			ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеВыгрузки",
				"АлгоритмПослеВыгрузкиСвойства", "ПКС_ПослеВыгрузкиСвойства");

		КонецЕсли;

	ИначеЕсли ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных" И ТипКонвертацииXML Тогда

		// Сигнатуры у правил предопределённых данных общие с правилами конвертации
		// объектов: штатная выгрузка обработчиков берёт для них области "ПКО_".
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПередВыгрузкой",
			"АлгоритмПередВыгрузкойОбъекта", "ПКО_ПередВыгрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПриВыгрузке",
			"АлгоритмПриВыгрузкеОбъекта", "ПКО_ПриВыгрузкеОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПослеВыгрузки",
			"АлгоритмПослеВыгрузкиОбъекта", "ПКО_ПослеВыгрузкиОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПослеВыгрузкиВФайл",
			"АлгоритмПослеВыгрузкиОбъектаВФайлОбмена", "ПКО_ПослеВыгрузкиОбъектаВФайлОбмена");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПередЗагрузкой",
			"АлгоритмПередЗагрузкойОбъекта", "ПКО_ПередЗагрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПриЗагрузке",
			"АлгоритмПриЗагрузкеОбъекта", "ПКО_ПриЗагрузкеОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПослеЗагрузки",
			"АлгоритмПослеЗагрузкиОбъекта", "ПКО_ПослеЗагрузкиОбъекта");

	ИначеЕсли ИмяСправочника = "ПравилаРегистрацииОбъектов" Тогда

		// Страница пакетной обработки перенесена в группу обработчиков: в штатной форме
		// она лежала на верхнем уровне, вне досягаемости единственного поля редактора.
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаПередОбработкой",
			"АлгоритмПередОбработкойПравила", "ПРО_ПередОбработкой");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаПриОбработке",
			"АлгоритмПриОбработкеПравила", "ПРО_ПриОбработке");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаПриОбработкеДоп",
			"АлгоритмПриОбработкеДополнительныйПравила", "ПРО_ПриОбработкеДополнительный");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаПослеОбработки",
			"АлгоритмПослеОбработкиПравила", "ПРО_ПослеОбработки");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "СтраницаПакетныйОбработчик",
			"АлгоритмПакетнаяОбработкаРегистрации", "ПРО_ПакетнаяОбработка");

	ИначеЕсли ИмяСправочника = "Конвертации" И ТипКонвертацииXML Тогда

		// Обработчики XDTO-конвертации живут в другой ветке формы, со своей группой
		// страниц, и редактором не покрыты: поле редактора в форме одно.
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеЗагрузкиПравилОбмена",
			"АлгоритмПослеЗагрузкиПравилОбмена", "Конвертация_ПослеЗагрузкиПравилОбмена");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередВыгрузкойДанных",
			"АлгоритмПередВыгрузкойДанных", "Конвертация_ПередВыгрузкойДанных");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередПолучениемИзмененных",
			"АлгоритмПередПолучениемИзмененныхОбъектов", "Конвертация_ПередПолучениемИзмененныхОбъектов");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередВыгрузкойОбъекта",
			"АлгоритмПередВыгрузкойОбъекта", "Конвертация_ПередВыгрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередОтправкойУдаления",
			"АлгоритмПередОтправкойИнформацииОбУдалении", "Конвертация_ПередОтправкойИнформацииОбУдалении");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередКонвертациейОбъекта",
			"АлгоритмПередКонвертациейОбъекта", "Конвертация_ПередКонвертациейОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеВыгрузкиОбъекта",
			"АлгоритмПослеВыгрузкиОбъекта", "Конвертация_ПослеВыгрузкиОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеВыгрузкиДанных",
			"АлгоритмПослеВыгрузкиДанных", "Конвертация_ПослеВыгрузкиДанных");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередЗагрузкойДанных",
			"АлгоритмПередЗагрузкойДанных", "Конвертация_ПередЗагрузкойДанных");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеЗагрузкиПараметров",
			"АлгоритмПослеЗагрузкиПараметров", "Конвертация_ПослеЗагрузкиПараметров");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеПолученияУзловОбмена",
			"АлгоритмПослеПолученияИнформацииОбУзлахОбмена", "Конвертация_ПослеПолученияИнформацииОбУзлахОбмена");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПередЗагрузкойОбъекта",
			"АлгоритмПередЗагрузкойОбъекта", "Конвертация_ПередЗагрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПриПолученииУдаления",
			"АлгоритмПриПолученииИнформацииОбУдалении", "Конвертация_ПриПолученииИнформацииОбУдалении");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеЗагрузкиОбъекта",
			"АлгоритмПослеЗагрузкиОбъекта", "Конвертация_ПослеЗагрузкиОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "ПослеЗагрузкиДанных",
			"АлгоритмПослеЗагрузкиДанных", "Конвертация_ПослеЗагрузкиДанных");

	ИначеЕсли ИмяСправочника = "ПравилаКонвертацииОбъектов" И ТипКонвертацииXML Тогда

		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПередВыгрузкой",
			"АлгоритмПередВыгрузкойОбъекта", "ПКО_ПередВыгрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПриВыгрузке",
			"АлгоритмПриВыгрузкеОбъекта", "ПКО_ПриВыгрузкеОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПослеВыгрузки",
			"АлгоритмПослеВыгрузкиОбъекта", "ПКО_ПослеВыгрузкиОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПослеВыгрузкиВФайл",
			"АлгоритмПослеВыгрузкиОбъектаВФайлОбмена", "ПКО_ПослеВыгрузкиОбъектаВФайлОбмена");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПоляПоиска",
			"АлгоритмПоследовательностьПолейПоиска", "ПКО_ПоследовательностьПолейПоиска");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПередЗагрузкой",
			"АлгоритмПередЗагрузкойОбъекта", "ПКО_ПередЗагрузкойОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПриЗагрузке",
			"АлгоритмПриЗагрузкеОбъекта", "ПКО_ПриЗагрузкеОбъекта");
		ДобавитьВкладку(Вкладки, ПараметрыСобытий, "Страница_ПослеЗагрузки",
			"АлгоритмПослеЗагрузкиОбъекта", "ПКО_ПослеЗагрузкиОбъекта");

	КонецЕсли;

	Возврат Вкладки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет описание одной вкладки события.
//
// Параметры:
//  Вкладки - Структура - накопитель описаний.
//  ПараметрыСобытий - Соответствие - см. dev_tools_ПодсказкиОбработчиков.ПараметрыСобытий.
//  КлючСтраницы - Строка - имя страницы формы.
//  ИмяРеквизита - Строка - имя реквизита объекта с текстом алгоритма.
//  КлючСобытия - Строка - ключ события в макете сигнатур; пустая строка, если сигнатуры нет.
Процедура ДобавитьВкладку(Вкладки, ПараметрыСобытий, КлючСтраницы, ИмяРеквизита, КлючСобытия)

	Параметры = ?(ПустаяСтрока(КлючСобытия), Неопределено, ПараметрыСобытий.Получить(КлючСобытия));
	Если Параметры = Неопределено Тогда
		Параметры = Новый Массив;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("Реквизит", ИмяРеквизита);
	Описание.Вставить("Код", "");
	Описание.Вставить("КодЗаполнен", Ложь);
	Описание.Вставить("КлючСобытия", КлючСобытия);
	Описание.Вставить("Параметры", Параметры);

	Вкладки.Вставить(КлючСтраницы, Описание);

КонецПроцедуры

#КонецОбласти
