#Область ПрограммныйИнтерфейс

// Запускает функцию модуля dev_tools_СинхронизацияПравилФон фоновым заданием
// (спека 2026-10-31-background-operations, §2.4). Форма ждёт его через
// ДлительныеОперацииКлиент.ОжидатьЗавершение.
//
// Параметры:
//  ИмяФункции - Строка - полное имя функции фонового модуля.
//  Задания - Массив из Структура - параметр функции, см. dev_tools_СинхронизацияПравилФон.
//  Наименование - Строка - наименование фонового задания.
//  ИдентификаторФормы - УникальныйИдентификатор - форма, во временное хранилище которой
//                       помещается результат задания.
//
// Возвращаемое значение:
//  Структура - см. ДлительныеОперации.ВыполнитьФункцию.
Функция НачатьФоновуюОперацию(ИмяФункции, Задания, Наименование, ИдентификаторФормы) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Задания);

КонецФункции

// Хеш снимка с диска.
//
// Хеширование доступно только на сервере, поэтому форма получает хеш
// через фасад, а не считает его сама.
//
// Параметры:
//  СнимокДиска - Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
//
// Возвращаемое значение:
//  Строка - см. dev_tools_СверкаПравил.ХешСнимка.
Функция ХешСнимка(СнимокДиска) Экспорт

	Возврат dev_tools_СверкаПравил.ХешСнимка(СнимокДиска);

КонецФункции

// Сверка снимка с диска с базой; закладывает и уточняет точку синхронизации
// (спека 2026-10-31, §3.2).
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил - пустая ссылка: точка не читается
//                и не пишется, происхождение всех строк — «Неизвестно». У строки «только в файлах»
//                (Единица = Неопределено) происхождение — «ВФайлах» (пустая точка); «Неизвестно» —
//                только у существующей единицы.
//  Вид - Строка
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации, Неопределено -
//            существующая единица либо Неопределено у строки «только в файлах».
//  ИмяКаталога - Строка - каталог единицы, прочитанный формой.
//  СнимокДиска - Структура - снимок с диска, см. dev_tools_СверкаПравил.НовыйСнимок.
//  Ветка - Строка - текущая ветка рабочей копии, записывается в точку.
//
// Возвращаемое значение:
//  Структура - Строки (Массив, см. dev_tools_СверкаПравил.СравнитьСнимки, плюс
//               Происхождение - Строка, см. dev_tools_СверкаПравил.ПроисхождениеСтроки),
//              Сообщения (Массив, см. dev_tools_ЗагрузкаПравил.ПредупрежденияСверки),
//              Хеш (Строка, см. dev_tools_СверкаПравил.ХешСнимка) - хеш снимка с диска.
Функция Сверить(Репозиторий, Вид, Единица, ИмяКаталога, СнимокДиска, Ветка) Экспорт

	Если ЗначениеЗаполнено(Единица) Тогда
		// Снимок базы строится один раз: и для сверки, и для предупреждений о разделяемых правилах.
		СнимокБазы = СнимокЕдиницы(Вид, Единица);
		Сообщения = dev_tools_ЗагрузкаПравил.ПредупрежденияСверки(СнимокДиска, Единица, СнимокБазы);
	Иначе
		СнимокБазы = dev_tools_СверкаПравил.НовыйСнимок(Вид, СнимокДиска.Наименование);
		Сообщения = dev_tools_ЗагрузкаПравил.ПредупрежденияСверки(СнимокДиска, Единица);
	КонецЕсли;

	Строки = dev_tools_СверкаПравил.СравнитьСнимки(СнимокБазы, СнимокДиска);
	ХешиБазы = dev_tools_СверкаПравил.ХешиФайлов(СнимокБазы);
	ХешиДиска = dev_tools_СверкаПравил.ХешиФайлов(СнимокДиска);
	Точка = dev_tools_ТочкиСинхронизации.ХешиТочки(Репозиторий, Единица, ИмяКаталога);
	Для Каждого СтрокаСверки Из Строки Цикл
		СтрокаСверки.Вставить("Происхождение", dev_tools_СверкаПравил.ПроисхождениеСтроки(
			СтрокаСверки.Файлы, ХешиБазы, ХешиДиска, Точка));
	КонецЦикла;

	// У строки «только в файлах» единицы нет — точку писать не к чему.
	Если ЗначениеЗаполнено(Репозиторий) И ЗначениеЗаполнено(Единица) Тогда
		dev_tools_ТочкиСинхронизации.Записать(Репозиторий, Единица, ИмяКаталога,
			dev_tools_СверкаПравил.ТочкаПослеСверки(Точка, ХешиБазы, ХешиДиска), Ветка);
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("Строки", Строки);
	Ответ.Вставить("Сообщения", Сообщения);
	Ответ.Вставить("Хеш", dev_tools_СверкаПравил.ХешСнимка(СнимокДиска));

	Возврат Ответ;

КонецФункции

// Загрузка отмеченных объектов снимка с диска в базу; при успехе обновляет точку
// синхронизации в той же транзакции (спека 2026-10-31, §3.5).
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил - пустая ссылка: точка не пишется.
//  Вид - Строка
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации, Неопределено -
//            существующая единица либо Неопределено для создания единицы по снимку.
//  ИмяКаталога - Строка - каталог единицы, прочитанный формой.
//  СнимокДиска - Структура - снимок с диска, см. dev_tools_СверкаПравил.НовыйСнимок.
//  ОтмеченныеПути - Массив из Строка, Неопределено
//  Ветка - Строка - текущая ветка рабочей копии.
//
// Возвращаемое значение:
//  Структура - см. dev_tools_ЗагрузкаПравил.НовыйРезультат.
Функция Загрузить(Репозиторий, Вид, Единица, ИмяКаталога, СнимокДиска, ОтмеченныеПути, Ветка) Экспорт

	// Загрузчик открывает свою транзакцию внутри этой. Его отмена при ошибке отменяет
	// и внешнюю — поэтому при неуспехе внешняя только завершается отменой, без записи точки.
	НачатьТранзакцию();
	Попытка
		Результат = dev_tools_ЗагрузкаПравил.Загрузить(СнимокДиска, Единица, ОтмеченныеПути);
		Если Результат.Успешно И ЗначениеЗаполнено(Репозиторий) Тогда
			ЗаписатьТочкуПослеЗагрузки(Репозиторий, Единица, ИмяКаталога, Результат, СнимокДиска, Ветка);
		КонецЕсли;
		Если Результат.Успешно Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
		КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Записывает точку после выгрузки: каталог равен снимку базы. Хеши посчитаны фоновой
// подготовкой выгрузки — снимок второй раз на сервер не передаётся. Ошибка записи данные
// не портит: каталог уже равен базе, следующая сверка заложит точку сама.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
//  ИмяКаталога - Строка
//  Хеши - Соответствие - см. dev_tools_СверкаПравил.ХешиФайлов выгруженного снимка.
//  Ветка - Строка
//
// Возвращаемое значение:
//  Строка - пустая или причина, по которой точка не записана.
Функция ЗафиксироватьВыгрузку(Репозиторий, Единица, ИмяКаталога, Хеши, Ветка) Экспорт

	Попытка
		dev_tools_ТочкиСинхронизации.Записать(Репозиторий, Единица, ИмяКаталога,
			dev_tools_СверкаПравил.ТочкаПослеВыгрузки(Хеши), Ветка);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'Точка синхронизации не записана: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат "";

КонецФункции

// Даты и ветки точек единиц репозитория.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//
// Возвращаемое значение:
//  Соответствие - см. dev_tools_ТочкиСинхронизации.ТочкиРепозитория.
Функция ТочкиЕдиниц(Репозиторий) Экспорт

	Возврат dev_tools_ТочкиСинхронизации.ТочкиРепозитория(Репозиторий);

КонецФункции

// Единицы синхронизации репозитория: закреплённые в нём и найденные в каталоге правил.
//
// Закреплённая единица сопоставляется с каталогом по имени каталога из ТЧ репозитория
// (спека 2026-10-21); каталог без закреплённой единицы — по нормализованному наименованию
// среди незакреплённых единиц базы, без учёта регистра.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  НаименованияКонвертаций - Массив из Строка - имена подкаталогов коллекции «Конвертации».
//  НаименованияРегистраций - Массив из Строка - имена подкаталогов коллекции «Регистрации».
//
// Возвращаемое значение:
//  ТаблицаЗначений - Вид (Строка), Ссылка (СправочникСсылка.Конвертации,
//   СправочникСсылка.Регистрации или Неопределено у строки «только в файлах»),
//   Наименование (Строка),
//   ИмяКаталога (Строка) - каталог единицы в коллекции репозитория,
//   Состояние (Строка: «ВБазеИВФайлах», «ТолькоВБазе», «ТолькоВФайлах»),
//   Закреплена (Булево).
Функция ЕдиницыРепозитория(Репозиторий, НаименованияКонвертаций, НаименованияРегистраций) Экспорт

	Единицы = НоваяТаблицаЕдиниц();
	Индекс = Новый Соответствие;
	СсылкиЗакреплённых = Новый Массив;

	Для Каждого СтрокаТЧ Из ЗакреплённыеЕдиницы(Репозиторий) Цикл
		Вид = ВидЕдиницы(СтрокаТЧ.Единица);
		СтрокаЕдиницы = Единицы.Добавить();
		СтрокаЕдиницы.Вид = Вид;
		СтрокаЕдиницы.Ссылка = СтрокаТЧ.Единица;
		СтрокаЕдиницы.Наименование = СтрокаТЧ.Наименование;
		СтрокаЕдиницы.ИмяКаталога = dev_tools_СверкаПравил.ИмяКаталогаЕдиницы(
			СтрокаТЧ.ИмяКаталога, СтрокаТЧ.Наименование);
		СтрокаЕдиницы.Состояние = "ТолькоВБазе";
		СтрокаЕдиницы.Закреплена = Истина;
		Индекс.Вставить(КлючЕдиницы(Вид, СтрокаЕдиницы.ИмяКаталога), СтрокаЕдиницы);
		СсылкиЗакреплённых.Добавить(СтрокаТЧ.Единица);
	КонецЦикла;

	ДобавитьИзКаталога(Единицы, Индекс, "Конвертация", "Конвертации", НаименованияКонвертаций,
		СсылкиЗакреплённых);
	ДобавитьИзКаталога(Единицы, Индекс, "Регистрация", "Регистрации", НаименованияРегистраций,
		СсылкиЗакреплённых);

	Единицы.Сортировать("Вид, Наименование");

	Возврат Единицы;

КонецФункции

// Закрепляет единицу за репозиторием; повторный вызов строк не добавляет.
//
// Проверки живут здесь, а не только в форме синхронизации: форма ограничивает выбор
// элементами и XML-конвертациями, но ту же табличную часть можно править руками
// из формы элемента репозитория.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
//  ИмяКаталога - Строка - каталог единицы в репозитории; пусто — нормализованное наименование.
//
// Возвращаемое значение:
//  Строка - пустая, если единица закреплена; иначе причина отказа для пользователя.
Функция ЗакрепитьЕдиницу(Репозиторий, Единица, ИмяКаталога = "") Экспорт

	ПричинаОтказа = ПричинаОтказаВЗакреплении(Единица);
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		Возврат ПричинаОтказа;
	КонецЕсли;

	Объект = Репозиторий.ПолучитьОбъект();
	Если Объект.Единицы.Найти(Единица, "Единица") <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИмяКаталогаСтроки = dev_tools_СверкаПравил.ИмяКаталогаЕдиницы(ИмяКаталога,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "Наименование"));
	ПричинаОтказа = ПричинаОтказаВДлинеИмениКаталога(ИмяКаталогаСтроки);
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		Возврат ПричинаОтказа;
	КонецЕсли;

	СтрокаТЧ = Объект.Единицы.Добавить();
	СтрокаТЧ.Единица = Единица;
	СтрокаТЧ.ИмяКаталога = ИмяКаталогаСтроки;

	ПричинаОтказа = Объект.ПричинаОтказаВИменахКаталогов();
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		Возврат ПричинаОтказа;
	КонецЕсли;
	Объект.Записать();

	Возврат "";

КонецФункции

// Снимает закрепление единицы. Файлы и базу не трогает.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
Процедура ОткрепитьЕдиницу(Репозиторий, Единица) Экспорт

	Объект = Репозиторий.ПолучитьОбъект();
	НайденныеСтроки = Объект.Единицы.НайтиСтроки(Новый Структура("Единица", Единица));
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЧ Из НайденныеСтроки Цикл
		Объект.Единицы.Удалить(СтрокаТЧ);
	КонецЦикла;
	Объект.Записать();
	dev_tools_ТочкиСинхронизации.Удалить(Репозиторий, Единица);

КонецПроцедуры

// Связывает единицу, закреплённую за репозиторием, с каталогом другого имени (спека
// 2026-10-21, §3.4): строки «Только в базе» и «Только в файлах» склеиваются в одну.
// Существование каталога не проверяется — это клиентская операция; форма предлагает
// только найденные на диске каталоги. Повторный вызов с тем же именем ничего не пишет.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
//  Вид - Строка - вид каталога: "Конвертация" или "Регистрация".
//  ИмяКаталога - Строка - имя подкаталога в коллекции вида.
//
// Возвращаемое значение:
//  Строка - пустая, если связь записана; иначе причина отказа для пользователя.
Функция СвязатьЕдиницу(Репозиторий, Единица, Вид, ИмяКаталога) Экспорт

	Если ПустаяСтрока(ИмяКаталога) Тогда
		Возврат НСтр("ru = 'Не указан каталог единицы'");
	КонецЕсли;
	ПричинаОтказа = ПричинаОтказаВДлинеИмениКаталога(ИмяКаталога);
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		Возврат ПричинаОтказа;
	КонецЕсли;
	Если ВидЕдиницы(Единица) <> Вид Тогда
		Возврат СтрШаблон(НСтр("ru = 'Единицу «%1» можно связать только с каталогом вида «%2»'"),
			Единица, ВидЕдиницы(Единица));
	КонецЕсли;

	Объект = Репозиторий.ПолучитьОбъект();
	СтрокаТЧ = Объект.Единицы.Найти(Единица, "Единица");
	Если СтрокаТЧ = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Единица «%1» не закреплена за репозиторием'"), Единица);
	КонецЕсли;
	Если СтрокаТЧ.ИмяКаталога = ИмяКаталога Тогда
		Возврат "";
	КонецЕсли;

	СтрокаТЧ.ИмяКаталога = ИмяКаталога;
	ПричинаОтказа = Объект.ПричинаОтказаВИменахКаталогов();
	Если Не ПустаяСтрока(ПричинаОтказа) Тогда
		Возврат ПричинаОтказа;
	КонецЕсли;
	// Точку не трогаем: записанная для прежнего каталога, она для нового не применяется
	// (спека 2026-10-31-point-directory-and-edt-path, А.2).
	Объект.Записать();

	Возврат "";

КонецФункции

// Репозитории, за которыми закреплена единица. Каталоги не сканируются:
// обход рабочих копий — клиентская операция, и по всем репозиториям она дорогая.
//
// Параметры:
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.dev_tools_РепозиторииПравил
Функция РепозиторииЕдиницы(Единица) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Единицы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.dev_tools_РепозиторииПравил.Единицы КАК Единицы
		|ГДЕ
		|	Единицы.Единица = &Единица
		|	И НЕ Единицы.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Единицы.Ссылка.Наименование";
	Запрос.УстановитьПараметр("Единица", Единица);

	РезультатЗапроса = Запрос.Выполнить();
	Найденные = РезультатЗапроса.Выгрузить();

	Возврат Найденные.ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Новая единица начинает с пустой точки; существующая без точки её не получает —
// заложит следующая сверка (спека 2026-10-31, §3.2).
Процедура ЗаписатьТочкуПослеЗагрузки(Репозиторий, Единица, ИмяКаталога, Результат, СнимокДиска, Ветка)

	Если ЗначениеЗаполнено(Единица) Тогда
		Сохранённая = dev_tools_ТочкиСинхронизации.Прочитать(Репозиторий, Единица, ИмяКаталога);
		Если Сохранённая = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Точка = Сохранённая.Хеши;
	Иначе
		Точка = Неопределено;
	КонецЕсли;

	НоваяТочка = dev_tools_СверкаПравил.ТочкаПослеЗагрузки(Точка,
		dev_tools_СверкаПравил.ХешиФайлов(СнимокДиска), Результат.Применённые, Результат.Удалённые);
	dev_tools_ТочкиСинхронизации.Записать(Репозиторий, Результат.Единица, ИмяКаталога, НоваяТочка, Ветка);

КонецПроцедуры

Функция СнимокЕдиницы(Вид, Единица)

	Если Вид = "Регистрация" Тогда
		Возврат dev_tools_СнимокПравил.СнимокРегистрации(Единица);
	КонецЕсли;

	Возврат dev_tools_СнимокПравил.СнимокКонвертации(Единица);

КонецФункции

Функция НоваяТаблицаЕдиниц()

	Единицы = Новый ТаблицаЗначений;
	Единицы.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка"));
	Единицы.Колонки.Добавить("Ссылка");
	Единицы.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Единицы.Колонки.Добавить("ИмяКаталога", Новый ОписаниеТипов("Строка"));
	Единицы.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Единицы.Колонки.Добавить("Закреплена", Новый ОписаниеТипов("Булево"));

	Возврат Единицы;

КонецФункции

// Ключ строки таблицы: вид плюс имя каталога без учёта регистра.
Функция КлючЕдиницы(Вид, ИмяКаталога)

	Возврат Вид + "|" + НРег(dev_tools_СверкаПравил.НормализоватьИмяКаталога(ИмяКаталога));

КонецФункции

Функция ВидЕдиницы(Единица)

	Если ТипЗнч(Единица) = Тип("СправочникСсылка.Регистрации") Тогда
		Возврат "Регистрация";
	КонецЕсли;

	Возврат "Конвертация";

КонецФункции

Функция ЗакреплённыеЕдиницы(Репозиторий)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Единицы.Единица КАК Единица,
		|	Единицы.Единица.Наименование КАК Наименование,
		|	Единицы.ИмяКаталога КАК ИмяКаталога
		|ИЗ
		|	Справочник.dev_tools_РепозиторииПравил.Единицы КАК Единицы
		|ГДЕ
		|	Единицы.Ссылка = &Репозиторий
		|	И Единицы.Единица <> НЕОПРЕДЕЛЕНО";
	Запрос.УстановитьПараметр("Репозиторий", Репозиторий);

	РезультатЗапроса = Запрос.Выполнить();
	Закреплённые = РезультатЗапроса.Выгрузить();

	// Строка табличной части с выбранным типом, но незаполненным значением отбор запроса
	// проходит: пустая ссылка — не НЕОПРЕДЕЛЕНО. Наименование у неё приходит NULL,
	// и ключ единицы на ней падал «Пустое имя каталога» — таблица не строилась вовсе.
	Индекс = Закреплённые.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Не ЗначениеЗаполнено(Закреплённые[Индекс].Единица) Тогда
			Закреплённые.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Закреплённые;

КонецФункции

// Причина, по которой единицу нельзя закрепить за репозиторием, или пустая строка.
// Группа и XDTO-конвертация отвергаются: снимок снял бы с них профиль XML-единицы.
Функция ПричинаОтказаВЗакреплении(Единица)

	Если Не ЗначениеЗаполнено(Единица) Тогда
		Возврат НСтр("ru = 'Единица не выбрана'");
	КонецЕсли;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "ЭтоГруппа") = Истина Тогда
		Возврат НСтр("ru = 'Группа единицей синхронизации быть не может, выберите элемент'");
	КонецЕсли;

	Если ВидЕдиницы(Единица) = "Конвертация"
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "ТипКонвертации")
			<> Перечисления.ТипыКонвертаций.XML Тогда
		Возврат НСтр("ru = 'Инструмент работает только с XML-конвертациями'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Имя каталога длиннее реквизита ТЧ платформа при присваивании обрезала бы молча: в git
// остался бы каталог, которого инструмент под записанным именем уже не найдёт. Модулю
// объекта эту проверку не отдать — до него доходит уже обрезанное значение.
Функция ПричинаОтказаВДлинеИмениКаталога(ИмяКаталога)

	РеквизитИмени = Метаданные.Справочники.dev_tools_РепозиторииПравил.ТабличныеЧасти.Единицы.Реквизиты.ИмяКаталога;
	ПредельнаяДлина = РеквизитИмени.Тип.КвалификаторыСтроки.Длина;
	Если СтрДлина(ИмяКаталога) <= ПредельнаяДлина Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Имя каталога «%1» длиннее %2 символов'"), ИмяКаталога, ПредельнаяДлина);

КонецФункции

// Строки из каталога: найденной в базе единице проставляется ссылка и состояние
// «в базе и в файлах», ненайденной — «только в файлах» без ссылки.
Процедура ДобавитьИзКаталога(Единицы, Индекс, Вид, ИмяСправочника, Наименования, Исключить)

	Если Наименования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВБазе = ЕдиницыБазыПоНормализованномуИмени(ИмяСправочника, Исключить);
	Для Каждого ИмяКаталога Из Наименования Цикл
		Ключ = КлючЕдиницы(Вид, ИмяКаталога);
		СтрокаЕдиницы = Индекс[Ключ];
		Если СтрокаЕдиницы <> Неопределено Тогда
			СтрокаЕдиницы.Состояние = "ВБазеИВФайлах";
			Продолжить;
		КонецЕсли;

		СтрокаЕдиницы = Единицы.Добавить();
		СтрокаЕдиницы.Вид = Вид;
		СтрокаЕдиницы.Наименование = ИмяКаталога;
		СтрокаЕдиницы.ИмяКаталога = ИмяКаталога;
		СтрокаЕдиницы.Закреплена = Ложь;

		НайденнаяВБазе = ВБазе[НРег(ИмяКаталога)];
		Если НайденнаяВБазе = Неопределено Тогда
			СтрокаЕдиницы.Состояние = "ТолькоВФайлах";
		Иначе
			СтрокаЕдиницы.Ссылка = НайденнаяВБазе.Ссылка;
			СтрокаЕдиницы.Наименование = НайденнаяВБазе.Наименование;
			СтрокаЕдиницы.Состояние = "ВБазеИВФайлах";
		КонецЕсли;
		Индекс.Вставить(Ключ, СтрокаЕдиницы);
	КонецЦикла;

КонецПроцедуры

// Соответствие «нормализованное имя в нижнем регистре → ссылка и наименование».
// Фильтровать запросом по наименованию нельзя: в базе оно исходное, а в каталоге —
// нормализованное, и сравнивать их можно только после нормализации обеих сторон.
// Единицы, закреплённые за репозиторием, исключаются: закреплённая под другим каталогом
// единица иначе попала бы в таблицу второй раз.
Функция ЕдиницыБазыПоНормализованномуИмени(ИмяСправочника, Исключить)

	Запрос = Новый Запрос;
	// Имя справочника — из кода, не пользовательский ввод; параметризовать его нельзя.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Единицы.Ссылка КАК Ссылка,
		|	Единицы.Наименование КАК Наименование
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Единицы
		|ГДЕ
		|	НЕ Единицы.ПометкаУдаления
		|	И НЕ Единицы.ЭтоГруппа
		|	И НЕ Единицы.Ссылка В (&Исключить)";
	Запрос.УстановитьПараметр("Исключить", Исключить);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	ПоИмени = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Ключ = НРег(dev_tools_СверкаПравил.НормализоватьИмяКаталога(Выборка.Наименование));
		Если ПоИмени[Ключ] = Неопределено Тогда
			ПоИмени.Вставить(Ключ, Новый Структура("Ссылка, Наименование",
				Выборка.Ссылка, Выборка.Наименование));
		КонецЕсли;
	КонецЦикла;

	Возврат ПоИмени;

КонецФункции

#КонецОбласти
