#Область ПрограммныйИнтерфейс

// Профиль сериализации справочника правил — единственное место, где движок снимка
// и загрузки узнаёт о специфике конкретного справочника.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника метаданных.
//
// Возвращаемое значение:
//  Структура - см. НовыйПрофиль.
Функция Профиль(ИмяСправочника) Экспорт

	Профили = ВсеПрофили();
	Профиль = Профили[ИмяСправочника];
	Если Профиль = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Нет профиля сериализации для справочника %1'"), ИмяСправочника);
	КонецЕсли;

	Возврат Профиль;

КонецФункции

// Профиль по виду объекта из сверки: "ПКО", "ГруппаПКС" → профиль ПКС и т. д.
//
// Параметры:
//  Вид - Строка - вид объекта.
//
// Возвращаемое значение:
//  Структура - см. НовыйПрофиль.
Функция ПрофильПоВиду(Вид) Экспорт

	ИскомыйВид = Вид;
	Если Вид = "ГруппаПКС" Тогда
		ИскомыйВид = "ПКС";
	ИначеЕсли Вид = "ГруппаПРО" Тогда
		ИскомыйВид = "ПРО";
	КонецЕсли;

	Для Каждого Элемент Из ВсеПрофили() Цикл
		Если Элемент.Значение.Вид = ИскомыйВид Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный вид объекта правил: %1'"), Вид);

КонецФункции

// Все профили.
//
// Возвращаемое значение:
//  Соответствие - имя справочника → профиль.
Функция ВсеПрофили() Экспорт

	Профили = Новый Соответствие;

	Профиль = НовыйПрофиль("Конвертации", "Конвертация", "", "Наименование");
	Профиль.Единица = Истина;
	ДобавитьПропускаемые(Профиль, "Код, ИмяФайлаДляСохранения, СерверБазыДанных, ИмяБазыДанных,
		|ПолноеИмяФайловойБазы, ПользовательБазыДанных, ПарольПользователя, Статус, ВерсииФормата");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("ПравилаКонвертацииОбъектов", "ПКО", "ПКО", "Код");
	Профиль.ВСоставе = Истина;
	Профиль.Дочерние = Новый Структура("Справочник, Каталог", "ПравилаКонвертацииСвойств", "ПКС");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("ПравилаКонвертацииСвойств", "ПКС", "ПКС", "Наименование");
	Профиль.Иерархический = Истина;
	Профиль.ВторичныйКлюч = "Код";
	Профиль.Ссылки.Вставить("СвойствоКонфигурации", "ВладелецИсточник");
	Профиль.Ссылки.Вставить("СвойствоКонфигурацииКорреспондента", "ВладелецКорреспондент");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("ПравилаОбработкиДанных", "ПОД", "ПОД", "Наименование");
	Профиль.ВСоставе = Истина;
	ДобавитьПропускаемые(Профиль, "Код");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("ПравилаКонвертацииПредопределенныхДанных", "ПКПД", "ПКПД", "Код");
	Профиль.ВСоставе = Истина;
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("Алгоритмы", "Алгоритм", "Алгоритмы", "Код");
	Профиль.ВСоставе = Истина;
	Профиль.Обработчики.Вставить("Алгоритм", "Алгоритм.bsl");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("Запросы", "Запрос", "Запросы", "Код");
	Профиль.ВСоставе = Истина;
	Профиль.Обработчики.Вставить("ТекстЗапроса", "Запрос.sdbl");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("Регистрации", "Регистрация", "", "Наименование");
	Профиль.Единица = Истина;
	ДобавитьПропускаемые(Профиль, "Код, ДатаОбновления, Статус");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Профиль = НовыйПрофиль("ПравилаРегистрацииОбъектов", "ПРО", "ПРО", "Наименование");
	Профиль.Иерархический = Истина;
	Профиль.ВторичныйКлюч = "Код";
	Профиль.Деревья.Добавить("ОтборПоСвойствамОбъекта");
	Профиль.Деревья.Добавить("ОтборПоСвойствамПланаОбмена");
	Профили.Вставить(Профиль.Справочник, Профиль);

	Возврат Профили;

КонецФункции

// Пропускается ли реквизит или табличная часть при сериализации.
//
// Параметры:
//  Профиль - Структура - см. НовыйПрофиль.
//  Имя - Строка - имя реквизита, ТЧ или колонки ТЧ.
//
// Возвращаемое значение:
//  Булево
Функция ПропускатьРеквизит(Профиль, Имя) Экспорт

	Если СтрНачинаетсяС(Имя, "Удалить") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Профиль.Пропускать.Найти(Имя) <> Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйПрофиль(Справочник, Вид, Каталог, Идентичность)

	Профиль = Новый Структура;
	Профиль.Вставить("Справочник", Справочник);
	Профиль.Вставить("Вид", Вид);
	Профиль.Вставить("Каталог", Каталог);
	Профиль.Вставить("Идентичность", Идентичность);
	Профиль.Вставить("ВторичныйКлюч", "");
	Профиль.Вставить("Пропускать", Новый Массив);
	Профиль.Вставить("Обработчики", ОбработчикиПоМетаданным(Справочник));
	Профиль.Вставить("Ссылки", Новый Соответствие);
	Профиль.Вставить("Деревья", Новый Массив);
	Профиль.Вставить("Дочерние", Неопределено);
	Профиль.Вставить("ВСоставе", Ложь);
	Профиль.Вставить("Иерархический", Ложь);
	Профиль.Вставить("Единица", Ложь);

	// Служебные реквизиты совместной работы и копирования, тип конвертации задаётся при загрузке.
	ДобавитьПропускаемые(Профиль, "Захвачен, Копия, ВременнаяКопия, ТипКонвертации");

	Возврат Профиль;

КонецФункции

Процедура ДобавитьПропускаемые(Профиль, СписокИмен)

	Для Каждого Имя Из СтрРазделить(СписокИмен, ",") Цикл
		Профиль.Пропускать.Добавить(СокрЛП(Имя));
	КонецЦикла;

КонецПроцедуры

// Обработчики — строки неограниченной длины с именем на «Алгоритм». Строка ограниченной
// длины с тем же префиксом (ПКО.АлгоритмПослеЗагрузкиВсехДанных) — имя процедуры, остаётся в JSON.
Функция ОбработчикиПоМетаданным(Справочник)

	Обработчики = Новый Соответствие;
	Префикс = "Алгоритм";

	Для Каждого Реквизит Из Метаданные.Справочники[Справочник].Реквизиты Цикл
		Если Не СтрНачинаетсяС(Реквизит.Имя, Префикс) Или Реквизит.Имя = Префикс Тогда
			Продолжить;
		КонецЕсли;
		Если Не Реквизит.Тип.СодержитТип(Тип("Строка")) Тогда
			Продолжить;
		КонецЕсли;
		Если Реквизит.Тип.КвалификаторыСтроки.Длина <> 0 Тогда
			Продолжить;
		КонецЕсли;
		Обработчики.Вставить(Реквизит.Имя, Сред(Реквизит.Имя, СтрДлина(Префикс) + 1) + ".bsl");
	КонецЦикла;

	Возврат Обработчики;

КонецФункции

#КонецОбласти
