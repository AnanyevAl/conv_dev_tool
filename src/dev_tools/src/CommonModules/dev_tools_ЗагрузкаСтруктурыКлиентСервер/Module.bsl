#Область ПрограммныйИнтерфейс

// Путь, который обработка загрузки структуры в режиме «Файлы EDT» ждёт в ИмяКаталогаЗагрузки:
// файл .project. Каталог проекта, в котором этот файл лежит, заменяется путём к нему — иначе
// обработка ищет файлы уровнем выше и падает (known-issues §21). Прочие пути не меняются.
//
// Параметры:
//  Путь - Строка - путь, указанный пользователем.
//
// Возвращаемое значение:
//  Строка
Функция ПутьКФайлуПроекта(Путь) Экспорт

	Если ПустаяСтрока(Путь) Тогда
		Возврат Путь;
	КонецЕсли;
	Указанный = Новый Файл(Путь);
	Если Не Указанный.Существует() Или Не Указанный.ЭтоКаталог() Тогда
		Возврат Путь;
	КонецЕсли;

	Разделитель = ПолучитьРазделительПути();
	Каталог = Путь;
	Если СтрЗаканчиваетсяНа(Каталог, Разделитель) Тогда
		Каталог = Лев(Каталог, СтрДлина(Каталог) - 1);
	КонецЕсли;
	ПутьПроекта = Каталог + Разделитель + ".project";
	ФайлПроекта = Новый Файл(ПутьПроекта);
	Если ФайлПроекта.Существует() И ФайлПроекта.ЭтоФайл() Тогда
		Возврат ПутьПроекта;
	КонецЕсли;

	Возврат Путь;

КонецФункции

// Останавливает загрузку структуры понятной ошибкой, если файлов метаданных не нашлось:
// иначе обработка падает «Индекс находится за границами массива» (known-issues §21).
//
// Параметры:
//  ПомещенныеФайлы - Массив из Структура, ТаблицаЗначений - файлы, переданные на сервер.
Процедура ПроверитьПомещенныеФайлы(ПомещенныеФайлы) Экспорт

	Если ПомещенныеФайлы.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Не найдено файлов метаданных для загрузки структуры. Для источника «Файлы EDT» укажите каталог проекта EDT — тот, в котором лежит файл .project'");

КонецПроцедуры

#КонецОбласти

