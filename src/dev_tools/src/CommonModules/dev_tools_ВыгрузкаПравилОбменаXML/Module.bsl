#Область ПрограммныйИнтерфейс

// Выгружает правила обмена одной конвертации в формате XML версии 2.01.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - конвертация типа XML.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно - Булево
//   * ТекстОшибки - Строка
//   * Данные - ДвоичныеДанные, Неопределено - содержимое файла правил.
Функция ВыгрузитьПравилаКонвертации(Конвертация) Экспорт

	Результат = НовыйРезультат();

	ПараметрыВыгрузки = Новый Структура("Конвертация, ПоСостояниюХранилища", Конвертация, Ложь);
	АдресРезультата = Неопределено;

	Попытка
		Обработки.ВыгрузкаКонвертацииXML.ВыполнитьВыгрузкуПравил(ПараметрыВыгрузки, АдресРезультата);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось выгрузить правила конвертации ""%1"": %2'"),
			Строка(Конвертация),
			ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	РезультатВыгрузки = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(РезультатВыгрузки) <> Тип("Структура")
		Или Не РезультатВыгрузки.Свойство("ФлагОшибки")
		Или РезультатВыгрузки.ФлагОшибки
		Или Не РезультатВыгрузки.Свойство("ПравилаXML") Тогда

		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Выгрузка правил конвертации ""%1"" завершилась с ошибкой'"),
			Строка(Конвертация));
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.Данные = РезультатВыгрузки.ПравилаXML;

	Возврат Результат;

КонецФункции

// Выгружает правила регистрации объектов в формате XML версии 2.01.
//
// Параметры:
//  Регистрация - СправочникСсылка.Регистрации - выгружаемая регистрация.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно - Булево
//   * ТекстОшибки - Строка
//   * Данные - ДвоичныеДанные, Неопределено - содержимое файла правил регистрации.
Функция ВыгрузитьПравилаРегистрации(Регистрация) Экспорт

	Результат = НовыйРезультат();

	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("Регистрация", Регистрация);
	ПараметрыВыгрузки.Вставить("ПоСостояниюХранилища", Ложь);
	ПараметрыВыгрузки.Вставить("НомерВерсии", 1);
	// Ключ обязателен: штатная выгрузка читает его до первой Попытки.
	ПараметрыВыгрузки.Вставить("СпособВыгрузки", Перечисления.СпособыВыгрузкиРегистрации.ФайлыXML);

	АдресРезультата = Неопределено;

	Попытка
		Обработки.ВыгрузкаРегистрации.ВыполнитьВыгрузкуПравил(ПараметрыВыгрузки, АдресРезультата);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не удалось выгрузить правила регистрации ""%1"": %2'"),
			Строка(Регистрация),
			ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	РезультатВыгрузки = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(РезультатВыгрузки) <> Тип("Структура")
		Или Не РезультатВыгрузки.Свойство("Успешно")
		Или Не РезультатВыгрузки.Успешно
		Или Не РезультатВыгрузки.Свойство("ПравилаXML") Тогда

		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Выгрузка правил регистрации ""%1"" завершилась с ошибкой'"),
			Строка(Регистрация));
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.Данные = РезультатВыгрузки.ПравилаXML;

	Возврат Результат;

КонецФункции

// Конструктор параметров выгрузки комплекта правил.
//
// Возвращаемое значение:
//  Структура:
//   * Конвертация - СправочникСсылка.Конвертации
//   * КонвертацияКорреспондент - СправочникСсылка.Конвертации - пустая ссылка, если не выгружается
//   * Регистрация - СправочникСсылка.Регистрации - пустая ссылка, если не выгружается
//   * Сжимать - Булево - упаковать результат в zip-архив.
Функция ПараметрыВыгрузкиКомплекта() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Конвертация", Справочники.Конвертации.ПустаяСсылка());
	Параметры.Вставить("КонвертацияКорреспондент", Справочники.Конвертации.ПустаяСсылка());
	Параметры.Вставить("Регистрация", Справочники.Регистрации.ПустаяСсылка());
	Параметры.Вставить("Сжимать", Истина);

	Возврат Параметры;

КонецФункции

// Выгружает комплект правил и помещает результат во временное хранилище.
// Предназначена для запуска через ДлительныеОперации.ВыполнитьВФоне.
//
// Параметры:
//  ПараметрыВыгрузки - см. ПараметрыВыгрузкиКомплекта
//  АдресВременногоХранилища - Строка - адрес временного хранилища, куда помещается
//   структура с полями Успешно (Булево), ТекстОшибки (Строка),
//   Данные (ДвоичныеДанные, Неопределено) и ЭтоАрхив (Булево).
Процедура ВыгрузитьКомплект(ПараметрыВыгрузки, АдресВременногоХранилища) Экспорт

	Результат = НовыйРезультат();
	Результат.Вставить("ЭтоАрхив", Ложь);

	ВыгружатьКорреспондента = ЗначениеЗаполнено(ПараметрыВыгрузки.КонвертацияКорреспондент);
	ВыгружатьРегистрацию = ЗначениеЗаполнено(ПараметрыВыгрузки.Регистрация);
	Сжимать = ПараметрыВыгрузки.Сжимать Или ВыгружатьКорреспондента Или ВыгружатьРегистрацию;

	// Массив, а не соответствие: порядок файлов в архиве должен быть воспроизводимым.
	ФайлыКомплекта = Новый Массив;

	ВыгрузкаПравил = ВыгрузитьПравилаКонвертации(ПараметрыВыгрузки.Конвертация);
	Если Не ВыгрузкаПравил.Успешно Тогда
		Результат.ТекстОшибки = ВыгрузкаПравил.ТекстОшибки;
		ПоместитьВоВременноеХранилище(Результат, АдресВременногоХранилища);
		Возврат;
	КонецЕсли;
	ДобавитьФайлКомплекта(ФайлыКомплекта, "ExchangeRules.xml", ВыгрузкаПравил.Данные);

	Если ВыгружатьКорреспондента Тогда
		ВыгрузкаКорреспондента = ВыгрузитьПравилаКонвертации(ПараметрыВыгрузки.КонвертацияКорреспондент);
		Если Не ВыгрузкаКорреспондента.Успешно Тогда
			Результат.ТекстОшибки = ВыгрузкаКорреспондента.ТекстОшибки;
			ПоместитьВоВременноеХранилище(Результат, АдресВременногоХранилища);
			Возврат;
		КонецЕсли;
		ДобавитьФайлКомплекта(ФайлыКомплекта, "CorrespondentExchangeRules.xml", ВыгрузкаКорреспондента.Данные);
	КонецЕсли;

	Если ВыгружатьРегистрацию Тогда
		ВыгрузкаРегистрации = ВыгрузитьПравилаРегистрации(ПараметрыВыгрузки.Регистрация);
		Если Не ВыгрузкаРегистрации.Успешно Тогда
			Результат.ТекстОшибки = ВыгрузкаРегистрации.ТекстОшибки;
			ПоместитьВоВременноеХранилище(Результат, АдресВременногоХранилища);
			Возврат;
		КонецЕсли;
		ДобавитьФайлКомплекта(ФайлыКомплекта, "RegistrationRules.xml", ВыгрузкаРегистрации.Данные);
	КонецЕсли;

	Если Сжимать Тогда
		Попытка
			Результат.Данные = УпаковатьВАрхив(ФайлыКомплекта);
			Результат.ЭтоАрхив = Истина;
			Результат.Успешно = Истина;
		Исключение
			Результат.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Не удалось упаковать комплект правил в архив: %1'"),
				ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Результат.Данные = ВыгрузкаПравил.Данные;
		Результат.Успешно = Истина;
	КонецЕсли;

	ПоместитьВоВременноеХранилище(Результат, АдресВременногоХранилища);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет файл в комплект с сохранением порядка.
//
// Параметры:
//  ФайлыКомплекта - Массив из Структура - накопитель файлов комплекта.
//  Имя - Строка - имя файла внутри архива.
//  Данные - ДвоичныеДанные - содержимое файла.
Процедура ДобавитьФайлКомплекта(ФайлыКомплекта, Имя, Данные)

	ФайлыКомплекта.Добавить(Новый Структура("Имя, Данные", Имя, Данные));

КонецПроцедуры

// Упаковывает файлы комплекта в zip-архив.
//
// Параметры:
//  ФайлыКомплекта - Массив из Структура - элементы с полями Имя (Строка) и Данные (ДвоичныеДанные).
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое архива.
Функция УпаковатьВАрхив(ФайлыКомплекта)

	КаталогКомплекта = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(КаталогКомплекта);
	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
	ДанныеАрхива = Неопределено;
	ОшибкаУпаковки = "";

	Попытка
		Архиватор = Новый ЗаписьZipФайла(ИмяАрхива, , НСтр("ru = 'Файл правил обмена данными'"));
		Для Каждого Файл Из ФайлыКомплекта Цикл
			ПутьФайла = КаталогКомплекта + ПолучитьРазделительПути() + Файл.Имя;
			Файл.Данные.Записать(ПутьФайла);
			Архиватор.Добавить(ПутьФайла);
		КонецЦикла;
		Архиватор.Записать();

		ДанныеАрхива = Новый ДвоичныеДанные(ИмяАрхива);
	Исключение
		ОшибкаУпаковки = ОписаниеОшибки();
	КонецПопытки;

	// Временные файлы удаляются в любом исходе: и после успешной упаковки, и после ошибки.
	Попытка
		УдалитьФайлы(КаталогКомплекта);
		УдалитьФайлы(ИмяАрхива);
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Выгрузка правил обмена'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(ОшибкаУпаковки) Тогда
		ВызватьИсключение ОшибкаУпаковки;
	КонецЕсли;

	Возврат ДанныеАрхива;

КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Данные", Неопределено);

	Возврат Результат;

КонецФункции

#КонецОбласти
