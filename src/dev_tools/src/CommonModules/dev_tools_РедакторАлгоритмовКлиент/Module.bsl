#Область ПрограммныйИнтерфейс

// Обрабатывает переключение вкладки события: сохраняет текст покидаемой вкладки,
// загружает текст активированной и обновляет подсказки переменных контекста.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
Процедура ПриСменеВкладки(Форма) Экспорт

	Если Не Форма.dev_tools_ДокументЗагружен Тогда
		Возврат;
	КонецЕсли;

	dev_tools_ИнициализацияРедактораКлиент.ПриИзмененииВкладкиСКодом(Форма);
	ПрименитьПодсказки(Форма);

КонецПроцедуры

// Переносит тексты вкладок в реквизиты объекта формы, чтобы штатные механизмы правила
// (индикация заполненности, запись, выгрузка обработчиков) видели тот же текст,
// что и пользователь в редакторе.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
Процедура ПеренестиКодВОбъект(Форма) Экспорт

	Для Каждого Вкладка Из Форма.dev_tools_СоответствияКодовНаСтранице Цикл

		Описание = Вкладка.Значение;
		Сохраненный = Форма.Объект[Описание.Реквизит];

		// Присваиваем только изменившееся, и различие в переводах строк изменением
		// не считаем: редактор всегда отдаёт текст с ПС, а в реквизитах правил
		// встречается и ВК + ПС. Иначе простой переход по вкладкам переписывал бы
		// реквизит и помечал форму модифицированной.
		Если СТекстомПС(Сохраненный) = СТекстомПС(Описание.Код) Тогда
			Продолжить;
		КонецЕсли;

		Форма.Объект[Описание.Реквизит] = ВСоглашенииОбразца(Описание.Код, Сохраненный);

	КонецЦикла;

КонецПроцедуры

// Уточняет активную вкладку по фактически открытой странице формы. Вызывать при открытии:
// настройки формы восстанавливают страницу уже после ПриСозданииНаСервере, поэтому
// вычисленная там вкладка может не совпадать с показанной пользователю.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
//  ИмяГруппыСтраниц - Строка - имя группы страниц с вкладками событий.
Процедура УточнитьАктивнуюВкладку(Форма, ИмяГруппыСтраниц) Экспорт

	Если Не Форма.dev_tools_РедакторПодключен Или Не ЗначениеЗаполнено(ИмяГруппыСтраниц) Тогда
		Возврат;
	КонецЕсли;

	ГруппаСтраниц = Форма.Элементы.Найти(ИмяГруппыСтраниц);
	Если ГруппаСтраниц = Неопределено Или ГруппаСтраниц.ТекущаяСтраница = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Форма.dev_tools_СоответствияКодовНаСтранице.Свойство(ГруппаСтраниц.ТекущаяСтраница.Имя) Тогда
		Форма.dev_tools_КлючАктивнойСтраницы = ГруппаСтраниц.ТекущаяСтраница.Имя;
	КонецЕсли;

КонецПроцедуры

// Обрабатывает смену вкладки события: сохраняет текст покидаемой вкладки, загружает
// текст активированной, переносит тексты в объект и обновляет индикацию заполненности.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
//  ТекущаяСтраница - ГруппаФормы - страница, на которую перешли.
//  ИмяГруппыСтраниц - Строка - имя группы страниц с вкладками событий.
Процедура ПриСменеСтраницы(Форма, ТекущаяСтраница, ИмяГруппыСтраниц) Экспорт

	Если Не Форма.dev_tools_РедакторПодключен Тогда
		Возврат;
	КонецЕсли;

	Форма.dev_tools_КлючАктивированнойСтраницы = ТекущаяСтраница.Имя;

	Форма.dev_tools_ЭтоИзменениеСтраницы = Истина;
	ПриСменеВкладки(Форма);
	Форма.dev_tools_ЭтоИзменениеСтраницы = Ложь;

	ПеренестиКодВОбъект(Форма);
	ОбновитьИндикациюВкладок(Форма, ИмяГруппыСтраниц);

КонецПроцедуры

// Обновляет штатные зелёные флажки заполненности вкладок по реквизитам объекта.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила.
//  ИмяГруппыСтраниц - Строка - имя группы страниц с вкладками событий.
Процедура ОбновитьИндикациюВкладок(Форма, ИмяГруппыСтраниц) Экспорт

	ГруппаСтраниц = Форма.Элементы.Найти(ИмяГруппыСтраниц);

	Если ГруппаСтраниц <> Неопределено Тогда
		КонвертацияДанныхXDTOКлиент.ОбновитьИндикациюСтраницОбработчиков(ГруппаСтраниц, Форма.Объект, "");
	КонецЕсли;

КонецПроцедуры

// Возвращает форму к штатным полям текста: редактор недоступен или не нужен.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила.
Процедура ПоказатьШтатныеПоля(Форма) Экспорт

	Если Форма.dev_tools_РедакторПодключен Тогда

		Для Каждого Вкладка Из Форма.dev_tools_СоответствияКодовНаСтранице Цикл
			ПолеТекста = Форма.Элементы.Найти(Вкладка.Значение.Реквизит);
			Если ПолеТекста <> Неопределено Тогда
				ПолеТекста.Видимость = Истина;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Форма.Элементы.dev_tools_Код.Видимость = Ложь;

КонецПроцедуры

// Загружает в редактор текст активной вкладки. Вызывается после каждой инициализации
// редактора: init() очищает содержимое, поэтому текст восстанавливается заново.
// Успех подтверждается чтением редактора: setText не выбрасывает исключение,
// пока Monaco не готов, и молча теряет текст.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
//
// Возвращаемое значение:
//  Булево - Истина, если текст вкладки теперь в редакторе.
Функция ЗагрузитьТекстАктивнойВкладки(Форма) Экспорт

	Если Форма.dev_tools_ТекстЗагружен Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не Форма.dev_tools_ДокументЗагружен Тогда
		Возврат Ложь;
	КонецЕсли;

	Описание = ОписаниеАктивнойВкладки(Форма);
	Если Описание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		// Именно ОбновитьТекст: только он глушит событие модификации на время записи,
		// иначе программное заполнение помечает форму изменённой.
		dev_tools_КомандыРедактораКлиент.ОбновитьТекст(Форма, Описание.Код, Истина, Истина);
		Принят = ПустаяСтрока(Описание.Код)
			Или Не ПустаяСтрока(dev_tools_КомандыРедактораКлиент.ПолучитьТекст(Форма));
	Исключение
		// Редактор ещё не готов принимать текст — заполнение повторит форма.
		Возврат Ложь;
	КонецПопытки;

	Если Не Принят Тогда
		Возврат Ложь;
	КонецЕсли;

	Форма.dev_tools_ТекстЗагружен = Истина;
	ПрименитьПодсказки(Форма);

	Возврат Истина;

КонецФункции

// Передаёт в редактор список переменных контекста активной вкладки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
Процедура ПрименитьПодсказки(Форма) Экспорт

	Если Не Форма.dev_tools_ДокументЗагружен Тогда
		Возврат;
	КонецЕсли;

	Описание = ОписаниеАктивнойВкладки(Форма);
	Если Описание = Неопределено
		Или Не Описание.Свойство("JSONПодсказок")
		Или ПустаяСтрока(Описание.JSONПодсказок) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// Пустой путь: updateMetadata кладёт набор в bslMetadata.customObjects.items
		// целиком, поэтому переменные предыдущей вкладки не остаются в подсказках.
		dev_tools_КомандыРедактораКлиент.View(Форма).updateMetadata(Описание.JSONПодсказок, "");
	Исключение
		// Редактор ещё не готов — подсказки применятся при следующей смене вкладки.
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит перевод строки к ПС — для сравнения текстов по содержимому.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст, в котором перевод строки задан одним ПС.
Функция СТекстомПС(Текст)

	Возврат СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);

КонецФункции

// Приводит перевод строки к тому же соглашению, что и в образце. Так правка одной
// строки не переписывает переводы строк во всём обработчике: иначе выгрузка правил
// обмена дала бы дифф на весь текст вместо одной изменённой строки.
//
// Параметры:
//  Текст - Строка - текст из редактора, перевод строки в нём задан одним ПС.
//  Образец - Строка - ранее сохранённый текст реквизита.
//
// Возвращаемое значение:
//  Строка - текст с переводом строки по соглашению образца.
Функция ВСоглашенииОбразца(Текст, Образец)

	Нормализованный = СТекстомПС(Текст);

	Если СтрНайти(Образец, Символы.ВК + Символы.ПС) > 0 Тогда
		Возврат СтрЗаменить(Нормализованный, Символы.ПС, Символы.ВК + Символы.ПС);
	КонецЕсли;

	Возврат Нормализованный;

КонецФункции

// Возвращает описание вкладки, текст которой сейчас показан в редакторе.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма правила с редактором.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. dev_tools_РедакторАлгоритмов.ОписаниеВкладок.
Функция ОписаниеАктивнойВкладки(Форма)

	Описание = Неопределено;
	Форма.dev_tools_СоответствияКодовНаСтранице.Свойство(Форма.dev_tools_КлючАктивнойСтраницы, Описание);

	Возврат Описание;

КонецФункции

#КонецОбласти
