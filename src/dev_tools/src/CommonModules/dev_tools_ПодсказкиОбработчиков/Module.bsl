#Область ПрограммныйИнтерфейс

// Читает параметры обработчиков из штатного макета сигнатур КД 3.1.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - ключ события вида "<Префикс>_<Событие>", например
//            "Конвертация_ПередВыгрузкойОбъекта".
//   * Значение - Массив из Строка - имена параметров обработчика.
Функция ПараметрыСобытий() Экспорт

	Результат = Новый Соответствие;

	Макет = Обработки.ВыгрузкаОбработчиковXML.ПолучитьМакет("ПараметрыОбработчиков");

	КлючОбласти = "";
	СтрокиПараметров = "";

	Для НомерСтроки = 1 По Макет.КоличествоСтрок() Цикл

		Строка = СокрЛП(Макет.ПолучитьСтроку(НомерСтроки));

		Если СтрНачинаетсяС(Строка, "#Область") Тогда

			ЗаписатьОбласть(Результат, КлючОбласти, СтрокиПараметров);

			КлючОбласти = СокрЛП(Сред(Строка, СтрДлина("#Область") + 1));
			СтрокиПараметров = "";

		ИначеЕсли ЗначениеЗаполнено(КлючОбласти) Тогда

			СтрокиПараметров = СтрокиПараметров + Строка;

		КонецЕсли;

	КонецЦикла;

	ЗаписатьОбласть(Результат, КлючОбласти, СтрокиПараметров);
	ДобавитьСобытияРегистрации(Результат);

	Возврат Результат;

КонецФункции

// Формирует JSON переменных контекста для JS-метода updateMetadata (без пути).
//
// Параметры:
//  ИменаПараметров - Массив из Строка - имена переменных контекста обработчика.
//
// Возвращаемое значение:
//  Строка - JSON вида {"customObjects": {"<Имя>": {"detail": ..., "description": ...}}}.
Функция JSONПодсказок(ИменаПараметров) Экспорт

	Подсказки = Новый Структура;

	Для Каждого ИмяПараметра Из ИменаПараметров Цикл

		Описание = Новый Структура;
		Описание.Вставить("detail", НСтр("ru = 'Переменная контекста обработчика'"));
		Описание.Вставить("description", НСтр("ru = 'Доступна в этом обработчике события'"));

		// Ключ — то, что редактор подставит в текст, поэтому регистр сохраняем.
		Подсказки.Вставить(ИмяПараметра, Описание);

	КонецЦикла;

	// Именно customObjects, а не customFunctions: последние дополняются как методы
	// и редактор дописывает к имени пустые скобки.
	Данные = Новый Структура("customObjects", Подсказки);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дополняет разбор событиями правил регистрации объектов. Их сигнатуры живут не в общем
// макете, а в шаблонах модулей регистрации, и заданы заголовком процедуры, а не списком
// параметров: "#Область Обработчик_<Событие>_Заголовок" и следом строка вида
// "Процедура &ИмяОбработчика(ПРО, Отказ, Объект)".
//
// Параметры:
//  Результат - Соответствие из КлючИЗначение - накопитель разбора:
//   * Ключ - Строка - ключ события с префиксом "ПРО_".
//   * Значение - Массив из Строка - имена параметров обработчика.
Процедура ДобавитьСобытияРегистрации(Результат)

	Макет = Обработки.ВыгрузкаРегистрации.ПолучитьМакет("ШаблоныТекстовМодулей");

	НачалоОбласти = "#Область Обработчик_";
	ОкончаниеОбласти = "_Заголовок";

	Для НомерСтроки = 1 По Макет.КоличествоСтрок() - 1 Цикл

		Строка = СокрЛП(Макет.ПолучитьСтроку(НомерСтроки));
		Если Не СтрНачинаетсяС(Строка, НачалоОбласти) Или Не СтрЗаканчиваетсяНа(Строка, ОкончаниеОбласти) Тогда
			Продолжить;
		КонецЕсли;

		ИмяСобытия = Сред(Строка, СтрДлина(НачалоОбласти) + 1,
			СтрДлина(Строка) - СтрДлина(НачалоОбласти) - СтрДлина(ОкончаниеОбласти));

		Заголовок = СокрЛП(Макет.ПолучитьСтроку(НомерСтроки + 1));
		Открывающая = СтрНайти(Заголовок, "(");
		Закрывающая = СтрНайти(Заголовок, ")", НаправлениеПоиска.СКонца);
		Если Открывающая = 0 Или Закрывающая <= Открывающая Тогда
			Продолжить;
		КонецЕсли;

		СтрокиПараметров = Сред(Заголовок, Открывающая + 1, Закрывающая - Открывающая - 1);
		ЗаписатьОбласть(Результат, "ПРО_" + ИмяСобытия, СтрокиПараметров);

	КонецЦикла;

КонецПроцедуры

// Записывает разобранную область макета в результат.
//
// Параметры:
//  Результат - Соответствие из КлючИЗначение - накопитель результата разбора:
//   * Ключ - Строка - ключ события.
//   * Значение - Массив из Строка - имена параметров обработчика.
//  КлючОбласти - Строка - ключ события; пустая строка пропускается.
//  СтрокиПараметров - Строка - слитые строки параметров области.
Процедура ЗаписатьОбласть(Результат, КлючОбласти, СтрокиПараметров)

	Если Не ЗначениеЗаполнено(КлючОбласти) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Массив;

	Для Каждого Параметр Из СтрРазделить(СтрокиПараметров, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Параметр)) Тогда
			Параметры.Добавить(СокрЛП(Параметр));
		КонецЕсли;
	КонецЦикла;

	Результат.Вставить(КлючОбласти, Параметры);

КонецПроцедуры

#КонецОбласти
