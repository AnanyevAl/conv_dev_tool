#Область ПрограммныйИнтерфейс

// Применяет снимок с диска к базе: только различающиеся объекты, одной транзакцией.
// Всё, что может упасть, падает до первой записи; ошибки — в Результат.Сообщения.
//
// Параметры:
//  СнимокДиска - Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации, Неопределено -
//            существующая единица; Неопределено или пустая ссылка создают единицу
//            по снимку. Форма синхронизации передаёт Неопределено: у строки
//            «только в файлах» ссылки нет вовсе.
//  ОтмеченныеПути - Массив из Строка, Неопределено - каталоги объектов, которые применять;
//                   Неопределено — все различия сверки.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультат.
Функция Загрузить(СнимокДиска, Единица, ОтмеченныеПути = Неопределено) Экспорт

	Результат = НовыйРезультат();

	Описатели = РазобратьСнимок(СнимокДиска, Результат);
	Если ЕстьОшибки(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	// Спека §3.6, шаг 1: единица ищется по наименованию. «Новая» единица с наименованием,
	// которое уже есть в базе, — не дубль, а незаполненное поле формы.
	Если Не ЗначениеЗаполнено(Единица) Тогда
		ПроверитьНовизнуЕдиницы(СнимокДиска.Вид, Описатели[""].Идентичность, Результат);
		Если ЕстьОшибки(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	СнимокЕдиницыБазы = СнимокБазы(СнимокДиска, Единица);
	Сверка = dev_tools_СверкаПравил.СравнитьСнимки(СнимокЕдиницыБазы, СнимокДиска);

	Применяемые = Новый Массив;
	Удаляемые = Новый Массив;
	ОтобратьИзменения(Сверка, ОтмеченныеПути, Описатели, Применяемые, Удаляемые);

	// Отметка путём не должна позволять пропустить шапку новой единицы: без неё правила
	// запишутся с владельцем — заготовкой (НаписатьЗаготовкуЕдиницы) с пустым наименованием,
	// без Родитель/ТипКонвертации, а загрузка тем не менее пройдёт как успешная.
	// ОтобратьИзменения вызывается до КонтекстЕдиницы — новизна единицы здесь определяется
	// по параметру Загрузить, а не по контексту, которого ещё нет.
	Если Не ЗначениеЗаполнено(Единица) Тогда
		ВключитьШапкуНовойЕдиницы(Описатели, Применяемые, Результат);
	КонецЕсли;

	// Фасад строит по ним точку синхронизации (спека 2026-10-31, §3.2).
	Для Каждого Описатель Из Применяемые Цикл
		Результат.Применённые.Добавить(Описатель.Путь);
	КонецЦикла;
	Для Каждого Путь Из Удаляемые Цикл
		Результат.Удалённые.Добавить(Путь);
	КонецЦикла;

	Если Применяемые.Количество() = 0 И Удаляемые.Количество() = 0 Тогда
		Результат.Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Информация", "",
			НСтр("ru = 'Изменений нет'")));
		Результат.Единица = Единица;
		Результат.Успешно = Истина;
		Возврат Результат;
	КонецЕсли;

	Контекст = КонтекстЕдиницы(СнимокДиска, Единица, Описатели, Результат);
	Если ЕстьОшибки(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	ПроверитьВладельцев(Применяемые, Описатели, СнимокЕдиницыБазы, Результат);
	Если ЕстьОшибки(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	// Разрешение ссылок может создать теги — в той же транзакции, что и запись:
	// отвергнутая загрузка не оставляет в базе следов.
	НачатьТранзакцию();
	Попытка
		НаписатьЗаготовкуЕдиницы(Контекст);
		РазрешитьСсылки(Применяемые, Описатели, СнимокЕдиницыБазы, Контекст, Результат);
		Если ЕстьОшибки(Результат) Тогда
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		ЗаписатьИзменения(Применяемые, Удаляемые, Описатели, СнимокЕдиницыБазы, Контекст, Результат);
		// Неоднозначное сопоставление находится уже при записи: транзакция откатывается целиком.
		Если ЕстьОшибки(Результат) Тогда
			ОтменитьТранзакцию();
			Результат.Создано = 0;
			Результат.Обновлено = 0;
			Результат.Удалено = 0;
			Возврат Результат;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Результат.Единица = Контекст.Единица;
	Результат.Успешно = Истина;

	Возврат Результат;

КонецФункции

// Пустой результат загрузки.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно - Булево
//   * Сообщения - Массив из Структура - см. dev_tools_СверкаПравил.НовоеСообщение.
//   * Создано - Число - счётчики Создано, Обновлено и Удалено осмысленны только при Успешно = Истина
//   * Обновлено - Число
//   * Удалено - Число - исключено из этой конвертации: отключено в составе и/или помечено
//                       на удаление (см. ПометитьУдаляемые).
//   * Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации, Неопределено - загруженная единица при Успешно = Истина
//   * Применённые - Массив из Строка - пути объектов, записанных загрузкой (при Успешно = Истина)
//   * Удалённые - Массив из Строка - пути объектов, помеченных на удаление (при Успешно = Истина)
Функция НовыйРезультат() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("Создано", 0);
	Результат.Вставить("Обновлено", 0);
	Результат.Вставить("Удалено", 0);
	Результат.Вставить("Единица", Неопределено);
	Результат.Вставить("Применённые", Новый Массив);
	Результат.Вставить("Удалённые", Новый Массив);

	Возврат Результат;

КонецФункции

// Есть ли среди сообщений результата ошибки.
Функция ЕстьОшибки(Результат) Экспорт

	Для Каждого Сообщение Из Результат.Сообщения Цикл
		Если Сообщение.Уровень = "Ошибка" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Предупреждения сверки, не блокирующие загрузку: расхождение релизов между файлами
// и базой, правила, разделяемые с другими конвертациями.
//
// Параметры:
//  СнимокДиска - Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации - существующая единица.
//  СнимокБазы - Структура, Неопределено - уже построенный снимок единицы из базы (с картой
//               Объекты); Неопределено — строится здесь.
//
// Возвращаемое значение:
//  Массив из Структура - см. dev_tools_СверкаПравил.НовоеСообщение.
Функция ПредупрежденияСверки(СнимокДиска, Единица, СнимокБазы = Неопределено) Экспорт

	Сообщения = Новый Массив;
	Если Не ЗначениеЗаполнено(Единица) Тогда
		Возврат Сообщения;
	КонецЕсли;

	ДобавитьПредупрежденияОРелизах(Сообщения, СнимокДиска, Единица);
	ДобавитьПредупрежденияОРазделяемых(Сообщения, СнимокДиска, Единица, СнимокБазы);

	Возврат Сообщения;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Разбор

// Снимок → описатели объектов в порядке применения. Ошибки формата — в Результат.
Функция РазобратьСнимок(Снимок, Результат)

	ФайлыКаталогов = Новый Соответствие;
	Для Каждого Файл Из Снимок.Файлы Цикл
		Каталог = dev_tools_СверкаПравил.КаталогОбъекта(Файл.Ключ);
		Список = ФайлыКаталогов[Каталог];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ФайлыКаталогов.Вставить(Каталог, Список);
		КонецЕсли;
		Список.Добавить(Файл.Ключ);
	КонецЦикла;

	Описатели = Новый Соответствие;
	Для Каждого Элемент Из ФайлыКаталогов Цикл
		Описатель = РазобратьКаталог(Снимок, Элемент.Ключ, Элемент.Значение, Результат);
		Если Описатель <> Неопределено Тогда
			Описатели.Вставить(Описатель.Путь, Описатель);
		КонецЕсли;
	КонецЦикла;

	Если Описатели[""] = Неопределено Тогда
		ДобавитьОшибку(Результат, "", НСтр("ru = 'В корне каталога единицы нет файла шапки (Конвертация.json или Регистрация.json)'"));
	КонецЕсли;

	Возврат Описатели;

КонецФункции

Функция РазобратьКаталог(Снимок, Каталог, Файлы, Результат)

	Вид = dev_tools_СверкаПравил.ВидОбъекта(Каталог, Снимок);
	Если ПустаяСтрока(Вид) Тогда
		ДобавитьОшибку(Результат, Каталог, НСтр("ru = 'В каталоге нет JSON-файла объекта'"));
		Возврат Неопределено;
	КонецЕсли;

	Профиль = dev_tools_ПрофилиПравил.ПрофильПоВиду(Вид);
	ЭтоГруппа = (Вид = "ГруппаПКС" Или Вид = "ГруппаПРО");
	Если ЭтоГруппа Тогда
		ИмяJSON = "Группа.json";
	Иначе
		ИмяJSON = Профиль.Вид + ".json";
	КонецЕсли;
	ПутьJSON = dev_tools_СверкаПравил.СоединитьПуть(Каталог, ИмяJSON);

	Данные = Неопределено;
	Попытка
		Данные = dev_tools_СнимокПравил.ДанныеИзJSON(Снимок.Файлы[ПутьJSON]);
	Исключение
		ДобавитьОшибку(Результат, ПутьJSON, НСтр("ru = 'Не удалось разобрать JSON: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Результат, ПутьJSON, НСтр("ru = 'Ожидался JSON-объект'"));
		Возврат Неопределено;
	КонецЕсли;

	Описатель = Новый Структура;
	Описатель.Вставить("Путь", Каталог);
	Описатель.Вставить("Вид", Вид);
	Описатель.Вставить("Профиль", Профиль);
	Описатель.Вставить("ЭтоГруппа", ЭтоГруппа);
	Описатель.Вставить("ЭтоЕдиница", Профиль.Единица);
	Описатель.Вставить("Данные", Данные);
	Описатель.Вставить("Обработчики", Новый Соответствие);
	Описатель.Вставить("Идентичность", Данные[Профиль.Идентичность]);
	Описатель.Вставить("Код", ЗначениеВторичногоКлюча(Данные, Профиль));
	Описатель.Вставить("Владелец", ПутьВладельца(Каталог, Профиль));
	Описатель.Вставить("Родитель", ПутьРодителя(Каталог, Снимок, Профиль));
	Описатель.Вставить("Значения", Новый Соответствие);
	Описатель.Вставить("Табличные", Новый Соответствие);
	Описатель.Вставить("Деревья", Новый Соответствие);
	Описатель.Вставить("Ссылка", Неопределено);

	ПроверитьВерсиюФормата(Описатель, ПутьJSON, Результат);
	ПроверитьКлючи(Описатель, ПутьJSON, Результат);
	ПроверитьИдентичность(Описатель, Каталог, Результат);
	ПроверитьКаталогГруппы(Описатель, Каталог, Результат);
	ПрочитатьОбработчики(Описатель, Файлы, ПутьJSON, Снимок, Результат);

	Возврат Описатель;

КонецФункции

// Значение вторичного ключа из JSON: у ПКС и ПРО это Код, у остальных справочников
// вторичного ключа нет.
Функция ЗначениеВторичногоКлюча(Данные, Профиль)

	Если ПустаяСтрока(Профиль.ВторичныйКлюч) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Данные[Профиль.ВторичныйКлюч];
	// Значение не числового и не строкового вида отвергает ПроверитьКлючи; здесь оно не нужно.
	Если ТипЗнч(Значение) <> Тип("Число") И ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьВерсиюФормата(Описатель, ПутьJSON, Результат)

	Если Не Описатель.ЭтоЕдиница Тогда
		Возврат;
	КонецЕсли;
	Версия = Описатель.Данные["ВерсияФормата"];
	Если Версия = 1 Тогда
		ДобавитьОшибку(Результат, ПутьJSON,
			НСтр("ru = 'Файл собран до перехода на код в идентичности (формат 1): выгрузите каталог заново'"));
	ИначеЕсли Версия <> 2 Тогда
		ДобавитьОшибку(Результат, ПутьJSON,
			СтрШаблон(НСтр("ru = 'Незнакомая ВерсияФормата %1, поддерживается 2'"), Версия));
	КонецЕсли;

КонецПроцедуры

// Каждый ключ JSON — реквизит или ТЧ справочника, не пропускаемый профилем.
Процедура ПроверитьКлючи(Описатель, ПутьJSON, Результат)

	Профиль = Описатель.Профиль;
	МетаданныеСправочника = Метаданные.Справочники[Профиль.Справочник];

	Для Каждого Ключ Из Описатель.Данные Цикл
		Имя = Ключ.Ключ;
		Если Имя = "ВерсияФормата" И Описатель.ЭтоЕдиница Тогда
			Продолжить;
		КонецЕсли;
		Если Имя = "Код" Или Имя = "Наименование" Тогда
			Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, Имя) Тогда
				ДобавитьОшибку(Результат, ПутьJSON, СтрШаблон(НСтр("ru = 'Ключ %1 не хранится в файле'"), Имя));
			ИначеЕсли Имя = Профиль.ВторичныйКлюч Тогда
				// Присваивание кода неподходящего типа или длины бросило бы исключение платформы
				// внутри транзакции, мимо контракта «ошибки — в Результат».
				ПроблемаКода = ПроблемаЗначенияКода(Ключ.Значение, МетаданныеСправочника);
				Если Не ПустаяСтрока(ПроблемаКода) Тогда
					ДобавитьОшибку(Результат, ПутьJSON, СтрШаблон(НСтр("ru = 'Ключ Код: %1'"), ПроблемаКода));
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Реквизит = МетаданныеСправочника.Реквизиты.Найти(Имя);
		ТабличнаяЧасть = МетаданныеСправочника.ТабличныеЧасти.Найти(Имя);
		Если Реквизит = Неопределено И ТабличнаяЧасть = Неопределено Тогда
			ДобавитьОшибку(Результат, ПутьJSON,
				СтрШаблон(НСтр("ru = 'Неизвестный ключ %1: такого реквизита нет у справочника %2'"), Имя, Профиль.Справочник));
		ИначеЕсли dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, Имя) Тогда
			ДобавитьОшибку(Результат, ПутьJSON, СтрШаблон(НСтр("ru = 'Ключ %1 не хранится в файле'"), Имя));
		ИначеЕсли Профиль.Обработчики[Имя] <> Неопределено Тогда
			ДобавитьОшибку(Результат, ПутьJSON,
				СтрШаблон(НСтр("ru = 'Обработчик %1 хранится в файле %2, а не в JSON'"), Имя, Профиль.Обработчики[Имя]));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Вложенный иерархический объект обязан лежать либо в корне коллекции (ПКС, ПРО), либо в каталоге
// группы с Группа.json: иначе родитель молча стал бы пустым и правило переехало бы в корень.
Процедура ПроверитьКаталогГруппы(Описатель, Каталог, Результат)

	Если Не Описатель.Профиль.Иерархический Или Описатель.ЭтоЕдиница Или Не ПустаяСтрока(Описатель.Родитель) Тогда
		Возврат;
	КонецЕсли;

	// Корень коллекции сравнивается позиционно: каталог группы, названный как коллекция
	// («ПКС»), корнем не считается.
	КореньКоллекции = Описатель.Профиль.Каталог;
	Если Не ПустаяСтрока(Описатель.Владелец) Тогда
		КореньКоллекции = Описатель.Владелец + "/" + КореньКоллекции;
	КонецЕсли;
	КаталогВыше = dev_tools_СверкаПравил.КаталогОбъекта(Каталог);
	Если КаталогВыше <> КореньКоллекции Тогда
		ДобавитьОшибку(Результат, Каталог,
			СтрШаблон(НСтр("ru = 'Каталог группы %1 без Группа.json'"), КаталогВыше));
	КонецЕсли;

КонецПроцедуры

// Пустая строка — код годится для справочника; иначе причина отказа.
Функция ПроблемаЗначенияКода(Значение, МетаданныеСправочника)

	ДлинаКода = МетаданныеСправочника.ДлинаКода;
	Если МетаданныеСправочника.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Число Тогда
		Если ТипЗнч(Значение) <> Тип("Число") Или Значение <> Цел(Значение) Или Значение < 0 Тогда
			Возврат НСтр("ru = 'ожидалось целое неотрицательное число'");
		КонецЕсли;
		Если СтрДлина(Формат(Значение, "ЧГ=0")) > ДлинаКода Тогда
			Возврат СтрШаблон(НСтр("ru = 'число длиннее %1 зн.'"), ДлинаКода);
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат НСтр("ru = 'ожидалась строка'");
	КонецЕсли;
	Если СтрДлина(Значение) > ДлинаКода Тогда
		Возврат СтрШаблон(НСтр("ru = 'строка длиннее %1 зн.'"), ДлинаКода);
	КонецЕсли;

	Возврат "";

КонецФункции

// Идентичность из JSON авторитетна; имя каталога объекта — её нормализованная форма.
// У единицы идентичность в репозитории — имя её каталога, а не наименование (спека
// 2026-10-21, §3.5): наименование в шапке — обычное поле, загрузка переименует единицу.
Процедура ПроверитьИдентичность(Описатель, Каталог, Результат)

	Если Не ЗначениеЗаполнено(Описатель.Идентичность) Тогда
		ДобавитьОшибку(Результат, Каталог,
			СтрШаблон(НСтр("ru = 'В JSON не заполнена идентичность (%1)'"), Описатель.Профиль.Идентичность));
		Возврат;
	КонецЕсли;

	Если Описатель.ЭтоЕдиница Тогда
		Возврат;
	КонецЕсли;

	Ожидаемое = dev_tools_СверкаПравил.НормализоватьИмяКаталога(Описатель.Идентичность);
	ИмяКаталога = Сред(Каталог, СтрНайти(Каталог, "/", НаправлениеПоиска.СКонца) + 1);
	ИмяСКодом = dev_tools_СверкаПравил.ИмяКаталогаОбъекта(Описатель.Идентичность, Описатель.Код);
	Если ИмяКаталога <> Ожидаемое И ИмяКаталога <> ИмяСКодом Тогда
		ДобавитьОшибку(Результат, Каталог,
			СтрШаблон(НСтр("ru = 'Имя каталога %1 не совпадает с идентичностью %2 из JSON (ожидался каталог %3 или %4)'"),
				ИмяКаталога, Описатель.Идентичность, Ожидаемое, ИмяСКодом));
	КонецЕсли;

КонецПроцедуры

// Файлы каталога кроме JSON — обработчики из профиля; чужой файл — ошибка.
Процедура ПрочитатьОбработчики(Описатель, Файлы, ПутьJSON, Снимок, Результат)

	РеквизитыПоФайлам = Новый Соответствие;
	Для Каждого Обработчик Из Описатель.Профиль.Обработчики Цикл
		РеквизитыПоФайлам.Вставить(Обработчик.Значение, Обработчик.Ключ);
	КонецЦикла;

	Для Каждого Путь Из Файлы Цикл
		Если Путь = ПутьJSON Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайла = Сред(Путь, СтрНайти(Путь, "/", НаправлениеПоиска.СКонца) + 1);
		Реквизит = РеквизитыПоФайлам[ИмяФайла];
		Если Реквизит = Неопределено Тогда
			ДобавитьОшибку(Результат, Путь,
				СтрШаблон(НСтр("ru = 'Файл %1 не соответствует ни одному обработчику объекта вида %2'"), ИмяФайла, Описатель.Вид));
			Продолжить;
		КонецЕсли;
		Описатель.Обработчики.Вставить(Реквизит, dev_tools_СверкаПравил.НормализоватьПереводыСтрок(Снимок.Файлы[Путь]));
	КонецЦикла;

КонецПроцедуры

// Владелец ПКС — ПКО, каталог которого стоит перед сегментом "ПКС".
Функция ПутьВладельца(Каталог, Профиль)

	Если Профиль.Справочник <> "ПравилаКонвертацииСвойств" Тогда
		Возврат "";
	КонецЕсли;

	Позиция = СтрНайти(Каталог, "/ПКС/");
	Возврат Лев(Каталог, Позиция - 1);

КонецФункции

// Родитель иерархического объекта — каталог с Группа.json уровнем выше; иначе корень коллекции.
Функция ПутьРодителя(Каталог, Снимок, Профиль)

	Если Не Профиль.Иерархический Тогда
		Возврат "";
	КонецЕсли;

	КаталогВыше = dev_tools_СверкаПравил.КаталогОбъекта(Каталог);
	Если Снимок.Файлы[dev_tools_СверкаПравил.СоединитьПуть(КаталогВыше, "Группа.json")] <> Неопределено Тогда
		Возврат КаталогВыше;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область Отбор

Функция СнимокБазы(СнимокДиска, Единица)

	Если Не ЗначениеЗаполнено(Единица) Тогда
		Возврат dev_tools_СверкаПравил.НовыйСнимок(СнимокДиска.Вид, СнимокДиска.Наименование);
	КонецЕсли;
	Если СнимокДиска.Вид = "Регистрация" Тогда
		Возврат dev_tools_СнимокПравил.СнимокРегистрации(Единица);
	КонецЕсли;

	Возврат dev_tools_СнимокПравил.СнимокКонвертации(Единица);

КонецФункции

// Строки сверки → применяемые описатели (в порядке применения) и удаляемые пути.
Процедура ОтобратьИзменения(Сверка, ОтмеченныеПути, Описатели, Применяемые, Удаляемые)

	Отобранные = Новый Массив;
	Для Каждого Строка Из Сверка Цикл
		Если ОтмеченныеПути <> Неопределено И ОтмеченныеПути.Найти(Строка.Путь) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Строка.Статус = "НетВФайлах" Тогда
			Удаляемые.Добавить(Строка.Путь);
		Иначе
			Отобранные.Добавить(Описатели[Строка.Путь]);
		КонецЕсли;
	КонецЦикла;

	// Порядок записи: шапка, алгоритмы, запросы, ПКО, ПКС (группы раньше вложенных), ПКПД, ПОД;
	// у регистрации — шапка, группы ПРО, ПРО. Внутри вида — по глубине пути.
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Глубина", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Путь", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Описатель");
	Для Каждого Описатель Из Отобранные Цикл
		Строка = Таблица.Добавить();
		Строка.Порядок = ПорядокВида(Описатель.Вид);
		Строка.Глубина = СтрЧислоВхождений(Описатель.Путь, "/");
		Строка.Путь = Описатель.Путь;
		Строка.Описатель = Описатель;
	КонецЦикла;
	Таблица.Сортировать("Порядок, Глубина, Путь");

	Для Каждого Строка Из Таблица Цикл
		Применяемые.Добавить(Строка.Описатель);
	КонецЦикла;

КонецПроцедуры

// Шапку новой единицы применяем всегда, даже если её путь ("") не прошёл отбор по
// ОтмеченныеПути: иначе правила запишутся с владельцем — незаполненной заготовкой
// (см. НаписатьЗаготовкуЕдиницы), а загрузка тем не менее отчитается как успешная.
// У шапки Порядок = 0 (см. ПорядокВида), поэтому место в начале списка не нарушает
// порядок применения, который иначе обеспечивает сортировка в ОтобратьИзменения.
Процедура ВключитьШапкуНовойЕдиницы(Описатели, Применяемые, Результат)

	Для Каждого Описатель Из Применяемые Цикл
		Если Описатель.Путь = "" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Применяемые.Вставить(0, Описатели[""]);
	Результат.Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Информация", "",
		НСтр("ru = 'Шапка новой единицы применяется обязательно'")));

КонецПроцедуры

Функция ПорядокВида(Вид)

	Порядок = Новый Соответствие;
	Порядок.Вставить("Конвертация", 0);
	Порядок.Вставить("Регистрация", 0);
	Порядок.Вставить("Алгоритм", 1);
	Порядок.Вставить("Запрос", 2);
	Порядок.Вставить("ПКО", 3);
	Порядок.Вставить("ГруппаПКС", 4);
	Порядок.Вставить("ПКС", 5);
	Порядок.Вставить("ПКПД", 6);
	Порядок.Вставить("ПОД", 7);
	Порядок.Вставить("ГруппаПРО", 8);
	Порядок.Вставить("ПРО", 9);

	Возврат Порядок[Вид];

КонецФункции

// Новый ПКС (или ПРО в группе) требует владельца и родителя: либо они уже есть в базе,
// либо тоже применяются в этой загрузке. Иначе загрузка остановится с понятным текстом.
Процедура ПроверитьВладельцев(Применяемые, Описатели, СнимокБазы, Результат)

	ПрименяемыеПути = Новый Соответствие;
	Для Каждого Описатель Из Применяемые Цикл
		ПрименяемыеПути.Вставить(Описатель.Путь, Истина);
	КонецЦикла;

	Для Каждого Описатель Из Применяемые Цикл
		Для Каждого ОпорныйПуть Из СтрРазделить(Описатель.Владелец + "|" + Описатель.Родитель, "|") Цикл
			Если ПустаяСтрока(ОпорныйПуть) Тогда
				Продолжить;
			КонецЕсли;
			Если СнимокБазы.Объекты[ОпорныйПуть] <> Неопределено Или ПрименяемыеПути[ОпорныйПуть] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Описатели[ОпорныйПуть] = Неопределено Тогда
				ДобавитьОшибку(Результат, Описатель.Путь,
					СтрШаблон(НСтр("ru = 'Объект ссылается на %1, которого нет ни в базе, ни в файлах'"), ОпорныйПуть));
			Иначе
				ДобавитьОшибку(Результат, Описатель.Путь,
					СтрШаблон(НСтр("ru = 'Объект %1 зависит от нового объекта %2, снятого с отметки: отметьте оба'"),
						Описатель.Путь, ОпорныйПуть));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Контекст

// Новая единица не должна дублировать существующую: непомеченный элемент справочника
// единиц с таким же наименованием — отказ с отсылкой к «Сверить».
Процедура ПроверитьНовизнуЕдиницы(Вид, Наименование, Результат)

	Если Вид = "Регистрация" Тогда
		ИмяСправочника = "Регистрации";
	Иначе
		ИмяСправочника = "Конвертации";
	КонецЕсли;

	Запрос = Новый Запрос;
	// Имя справочника — из вида снимка (имя метаданных, не пользовательский ввод); параметризовать
	// его нельзя, это допустимое исключение из правила о конкатенации в тексте запроса.
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Единицы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Единицы
		|ГДЕ
		|	Единицы.Наименование = &Наименование
		|	И НЕ Единицы.ЭтоГруппа
		|	И НЕ Единицы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", Наименование);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	ДобавитьОшибку(Результат, "",
		СтрШаблон(НСтр("ru = 'Единица «%1» уже есть в базе: закрепите её за репозиторием («Добавить конвертацию/регистрацию») и свяжите с каталогом командой «Связать», затем выполните «Сверить»'"),
			Наименование));

КонецПроцедуры

// Релизы и владелец тегов для разрешения ссылок. У существующей единицы — из базы,
// у новой — по описанию из шапки.
Функция КонтекстЕдиницы(СнимокДиска, Единица, Описатели, Результат)

	Контекст = Новый Структура;
	Контекст.Вставить("Вид", СнимокДиска.Вид);
	Контекст.Вставить("Единица", Единица);
	Контекст.Вставить("НоваяЕдиница", Не ЗначениеЗаполнено(Единица));
	Контекст.Вставить("РелизИсточника", Справочники.Релизы.ПустаяСсылка());
	Контекст.Вставить("РелизКорреспондента", Справочники.Релизы.ПустаяСсылка());

	// Новой единице ссылка выдаётся заранее, до её записи: теги регистрации и строки
	// состава внутри той же транзакции ссылаются на единицу до того, как шапка будет
	// записана (Объект.УстановитьСсылкуНового(Контекст.Единица) — задача 6). Пустая
	// заготовка строки под эту ссылку пишется в Загрузить сразу после начала транзакции
	// (см. НаписатьЗаготовкуЕдиницы) — здесь, до транзакции, писать нельзя: отказ
	// на следующем шаге (ПроверитьВладельцев) должен оставить базу нетронутой.
	Если Контекст.НоваяЕдиница Тогда
		Если СнимокДиска.Вид = "Регистрация" Тогда
			ИмяСправочникаЕдиницы = "Регистрации";
		Иначе
			ИмяСправочникаЕдиницы = "Конвертации";
		КонецЕсли;
		Контекст.Единица = Справочники[ИмяСправочникаЕдиницы].ПолучитьСсылку(Новый УникальныйИдентификатор);
	КонецЕсли;

	Шапка = Описатели[""];
	Если ЗначениеЗаполнено(Единица) Тогда
		Если СнимокДиска.Вид = "Регистрация" Тогда
			Контекст.РелизИсточника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, "Конфигурация");
			Контекст.РелизКорреспондента = Контекст.РелизИсточника;
		Иначе
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Единица, "Конфигурация, КонфигурацияКорреспондент");
			Контекст.РелизИсточника = Реквизиты.Конфигурация;
			Контекст.РелизКорреспондента = Реквизиты.КонфигурацияКорреспондент;
		КонецЕсли;
	Иначе
		Контекст.РелизИсточника = РелизПоОписанию(Шапка.Данные["Конфигурация"], "Конфигурация", Результат);
		Если СнимокДиска.Вид = "Регистрация" Тогда
			Контекст.РелизКорреспондента = Контекст.РелизИсточника;
		Иначе
			Контекст.РелизКорреспондента = РелизПоОписанию(Шапка.Данные["КонфигурацияКорреспондент"],
				"КонфигурацияКорреспондент", Результат);
		КонецЕсли;
	КонецЕсли;

	Контекст.Вставить("Конфигурация",
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контекст.РелизИсточника, "КонфигурацияВладелец"));

	Возврат Контекст;

КонецФункции

// Пустая строка новой единицы под заранее выданную ссылку (см. КонтекстЕдиницы): без неё
// платформа отвергает подчинённые объекты, записанные до шапки (теги регистрации), —
// «Владелец не заполнен или заполнен неверно», потому что владельца ещё нет в базе.
// Вызывается из Загрузить сразу после начала транзакции — откат при последующей ошибке
// уберёт и эту строку. ЗаписатьОбъект перезапишет её финальными данными той же ссылкой
// (УстановитьСсылкуНового на уже существующую ссылку — обновление, а не вставка).
Процедура НаписатьЗаготовкуЕдиницы(Контекст)

	Если Не Контекст.НоваяЕдиница Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Вид = "Регистрация" Тогда
		ИмяСправочника = "Регистрации";
	Иначе
		ИмяСправочника = "Конвертации";
	КонецЕсли;

	Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
	Объект.УстановитьСсылкуНового(Контекст.Единица);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

КонецПроцедуры

// Релиз по {"Конфигурация", "Версия"}: по имени конфигурации и версии; версии нет,
// но релиз единственный — он, с предупреждением; иначе ошибка.
Функция РелизПоОписанию(Описание, ИмяРеквизита, Результат)

	Пустая = Справочники.Релизы.ПустаяСсылка();
	Если ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Результат, "", СтрШаблон(НСтр("ru = 'В шапке не заполнено %1'"), ИмяРеквизита));
		Возврат Пустая;
	КонецЕсли;

	ИмяКонфигурации = Описание["Конфигурация"];
	Версия = Описание["Версия"];
	Конфигурация = Справочники.Конфигурации.НайтиПоНаименованию(ИмяКонфигурации, Истина);
	Если Не ЗначениеЗаполнено(Конфигурация) Тогда
		ДобавитьОшибку(Результат, "", СтрШаблон(НСтр("ru = 'Конфигурация %1 не загружена в базу'"), ИмяКонфигурации));
		Возврат Пустая;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Релизы.Ссылка КАК Ссылка,
		|	Релизы.Версия КАК Версия
		|ИЗ
		|	Справочник.Релизы КАК Релизы
		|ГДЕ
		|	Релизы.КонфигурацияВладелец = &Конфигурация
		|	И НЕ Релизы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Конфигурация", Конфигурация);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Единственный = Пустая;
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Версия = Версия Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Единственный = Выборка.Ссылка;
		Количество = Количество + 1;
	КонецЦикла;

	Если Количество = 1 Тогда
		Результат.Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Предупреждение", "",
			СтрШаблон(НСтр("ru = 'Релиз %1 версии %2 не найден, взят единственный релиз конфигурации'"),
				ИмяКонфигурации, Версия)));
		Возврат Единственный;
	КонецЕсли;

	ДобавитьОшибку(Результат, "",
		СтрШаблон(НСтр("ru = 'Релиз %1 версии %2 не найден (релизов конфигурации: %3)'"), ИмяКонфигурации, Версия, Количество));
	Возврат Пустая;

КонецФункции

#КонецОбласти

#Область РазрешениеСсылок

// Значения реквизитов, строки ТЧ и деревья описателей — в типах базы. Ошибки — в Результат.
Процедура РазрешитьСсылки(Применяемые, Описатели, СнимокБазы, Контекст, Результат)

	Для Каждого Описатель Из Применяемые Цикл
		Профиль = Описатель.Профиль;
		МетаданныеСправочника = Метаданные.Справочники[Профиль.Справочник];

		Для Каждого Ключ Из Описатель.Данные Цикл
			Имя = Ключ.Ключ;
			Если Имя = "ВерсияФормата" Или Имя = "Код" Или Имя = "Наименование" Тогда
				Продолжить;
			КонецЕсли;
			// Релизы единицы берутся из контекста (см. КонтекстЕдиницы), расхождение с файлом —
			// предупреждение сверки, а не ошибка загрузки.
			Если Описатель.ЭтоЕдиница И (Имя = "Конфигурация" Или Имя = "КонфигурацияКорреспондент") Тогда
				Продолжить;
			КонецЕсли;
			Если Профиль.Деревья.Найти(Имя) <> Неопределено Тогда
				Описатель.Деревья.Вставить(Имя, dev_tools_СнимокПравил.ДеревоОтбораИзJSON(Ключ.Значение, Имя));
				Продолжить;
			КонецЕсли;
			ТабличнаяЧасть = МетаданныеСправочника.ТабличныеЧасти.Найти(Имя);
			Если ТабличнаяЧасть <> Неопределено Тогда
				Описатель.Табличные.Вставить(Имя,
					РазрешитьСтрокиТЧ(Ключ.Значение, ТабличнаяЧасть, Описатель, Описатели, СнимокБазы, Контекст, Результат));
				Продолжить;
			КонецЕсли;
			Реквизит = МетаданныеСправочника.Реквизиты.Найти(Имя);
			Описатель.Значения.Вставить(Имя,
				ЗначениеИзJSON(Ключ.Значение, Реквизит.Тип, Имя, Описатель, Описатели, СнимокБазы, Контекст, Результат));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция РазрешитьСтрокиТЧ(СтрокиJSON, ТабличнаяЧасть, Описатель, Описатели, СнимокБазы, Контекст, Результат)

	Строки = Новый Массив;
	Если ТипЗнч(СтрокиJSON) <> Тип("Массив") Тогда
		ДобавитьОшибку(Результат, Описатель.Путь, СтрШаблон(НСтр("ru = 'ТЧ %1 должна быть массивом'"), ТабличнаяЧасть.Имя));
		Возврат Строки;
	КонецЕсли;

	Для Каждого СтрокаJSON Из СтрокиJSON Цикл
		Строка = Новый Соответствие;
		Для Каждого Ключ Из СтрокаJSON Цикл
			Колонка = ТабличнаяЧасть.Реквизиты.Найти(Ключ.Ключ);
			Если Колонка = Неопределено Тогда
				ДобавитьОшибку(Результат, Описатель.Путь,
					СтрШаблон(НСтр("ru = 'Неизвестная колонка %1 в ТЧ %2'"), Ключ.Ключ, ТабличнаяЧасть.Имя));
				Продолжить;
			КонецЕсли;
			Строка.Вставить(Ключ.Ключ,
				ЗначениеИзJSON(Ключ.Значение, Колонка.Тип, Ключ.Ключ, Описатель, Описатели, СнимокБазы, Контекст, Результат));
		КонецЦикла;
		Строки.Добавить(Строка);
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Значение из JSON в тип реквизита: примитивы как есть, имена — в ссылки.
Функция ЗначениеИзJSON(ЗначениеJSON, ОписаниеТипов, ИмяРеквизита, Описатель, Описатели, СнимокБазы, Контекст, Результат)

	Если ТипЗнч(ЗначениеJSON) = Тип("Соответствие") Тогда
		Если ЗначениеJSON["Объект"] <> Неопределено Тогда
			Возврат ОбъектПоИмени(ЗначениеJSON["Объект"], ИмяРеквизита, Описатель, Контекст, Результат);
		ИначеЕсли ЗначениеJSON["Конфигурация"] <> Неопределено Тогда
			Возврат РелизПоОписанию(ЗначениеJSON, ИмяРеквизита, Результат);
		КонецЕсли;
		ДобавитьОшибку(Результат, Описатель.Путь, СтрШаблон(НСтр("ru = 'Неожиданный объект JSON в реквизите %1'"), ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(ЗначениеJSON) = Тип("Строка") И ОписаниеТипов.СодержитТип(Тип("Строка")) Тогда
		Возврат ЗначениеJSON;
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("СправочникСсылка.Объекты")) Тогда
		Возврат ОбъектПоИмени(ЗначениеJSON, ИмяРеквизита, Описатель, Контекст, Результат);
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("СправочникСсылка.Свойства")) Тогда
		Возврат СвойствоПоПути(ЗначениеJSON, ИмяРеквизита, Описатель, Описатели, СнимокБазы, Контекст, Результат);
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("СправочникСсылка.Теги")) Тогда
		Возврат ТегПоИмени(ЗначениеJSON, Контекст);
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("СправочникСсылка.УсловияПримененияПравил")) Тогда
		Возврат ЭлементПоНаименованию(Справочники.УсловияПримененияПравил, ЗначениеJSON, Неопределено,
			ИмяРеквизита, Описатель, Результат);
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("СправочникСсылка.ДополнительныеМодули")) Тогда
		Возврат ЭлементПоНаименованию(Справочники.ДополнительныеМодули, ЗначениеJSON, Контекст.Единица,
			ИмяРеквизита, Описатель, Результат);
	ИначеЕсли ОписаниеТипов.СодержитТип(Тип("СправочникСсылка.Релизы")) Тогда
		ДобавитьОшибку(Результат, Описатель.Путь,
			СтрШаблон(НСтр("ru = 'Реквизит %1 ожидает объект {""Конфигурация"", ""Версия""}'"), ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;

	ИмяПеречисления = ИмяПеречисленияТипа(ОписаниеТипов);
	Если ИмяПеречисления <> "" Тогда
		Возврат ЗначениеПеречисления(ИмяПеречисления, ЗначениеJSON, ИмяРеквизита, Описатель, Результат);
	КонецЕсли;

	// Симметрично dev_tools_СнимокПравил.ЗначениеДляJSON: дата в файле — строка ISO.
	Если ТипЗнч(ЗначениеJSON) = Тип("Строка") И ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
		Возврат ПрочитатьДатуJSON(ЗначениеJSON, ФорматДатыJSON.ISO);
	КонецЕсли;

	Возврат ОписаниеТипов.ПривестиЗначение(ЗначениеJSON);

КонецФункции

Функция ИмяПеречисленияТипа(ОписаниеТипов)

	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(Тип);
		Если МетаданныеТипа <> Неопределено И Метаданные.Перечисления.Содержит(МетаданныеТипа) Тогда
			Возврат МетаданныеТипа.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения, ИмяРеквизита, Описатель, Результат)

	Если Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		ДобавитьОшибку(Результат, Описатель.Путь,
			СтрШаблон(НСтр("ru = 'У перечисления %1 нет значения %2 (реквизит %3)'"), ИмяПеречисления, ИмяЗначения, ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];

КонецФункции

// Объект метаданных по полному имени в релизе источника или корреспондента.
Функция ОбъектПоИмени(Имя, ИмяРеквизита, Описатель, Контекст, Результат)

	Релиз = Контекст.РелизИсточника;
	Если СтрНайти(ИмяРеквизита, "Корреспондент") > 0 Тогда
		Релиз = Контекст.РелизКорреспондента;
	КонецЕсли;

	Объект = Справочники.Объекты.НайтиПоНаименованию(Имя, Истина, , Релиз);
	Если Не ЗначениеЗаполнено(Объект) Тогда
		ДобавитьОшибку(Результат, Описатель.Путь,
			СтрШаблон(НСтр("ru = 'Объект метаданных %1 не найден в релизе %2 (реквизит %3)'"), Имя, Релиз, ИмяРеквизита));
	КонецЕсли;

	Возврат Объект;

КонецФункции

// Свойство по пути внутри объекта ПКО-владельца: "Артикул" или "Товары.Номенклатура".
Функция СвойствоПоПути(Путь, ИмяРеквизита, Описатель, Описатели, СнимокБазы, Контекст, Результат)

	Правило = Описатель.Профиль.Ссылки[ИмяРеквизита];
	ИмяРеквизитаОбъекта = "ОбъектКонфигурации";
	Если Правило = "ВладелецКорреспондент" Тогда
		ИмяРеквизитаОбъекта = "ОбъектКонфигурацииКорреспондент";
	КонецЕсли;

	Объект = ЗначениеРеквизитаОбъектаПоПути(Описатель.Владелец, ИмяРеквизитаОбъекта, Описатели, СнимокБазы);
	Если Не ЗначениеЗаполнено(Объект) Тогда
		ДобавитьОшибку(Результат, Описатель.Путь,
			СтрШаблон(НСтр("ru = 'У владельца %1 не заполнен %2 — свойство %3 не к чему привязать'"),
				Описатель.Владелец, ИмяРеквизитаОбъекта, Путь));
		Возврат Неопределено;
	КонецЕсли;

	// Имя свойства — идентификатор без точек; всё до последней точки — группа (табличная часть).
	Позиция = СтрНайти(Путь, ".", НаправлениеПоиска.СКонца);
	ИмяГруппы = Лев(Путь, Позиция - 1);
	Имя = Сред(Путь, Позиция + 1);
	Если Позиция = 0 Тогда
		ИмяГруппы = "";
		Имя = Путь;
	КонецЕсли;

	Родитель = Справочники.Свойства.ПустаяСсылка();
	Если Не ПустаяСтрока(ИмяГруппы) Тогда
		Родитель = НайтиСвойство(Объект, Справочники.Свойства.ПустаяСсылка(), ИмяГруппы, Истина);
		Если Не ЗначениеЗаполнено(Родитель) Тогда
			ДобавитьОшибку(Результат, Описатель.Путь,
				СтрШаблон(НСтр("ru = 'Табличная часть %1 не найдена у объекта %2'"), ИмяГруппы, Объект));
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Свойство = НайтиСвойство(Объект, Родитель, Имя, Описатель.ЭтоГруппа);
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		ДобавитьОшибку(Результат, Описатель.Путь,
			СтрШаблон(НСтр("ru = 'Свойство %1 не найдено у объекта %2 (реквизит %3)'"), Путь, Объект, ИмяРеквизита));
	КонецЕсли;

	Возврат Свойство;

КонецФункции

Функция НайтиСвойство(Объект, Родитель, Имя, ЭтоГруппа)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Свойства.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Свойства КАК Свойства
		|ГДЕ
		|	Свойства.Владелец = &Владелец
		|	И Свойства.Родитель = &Родитель
		|	И Свойства.Наименование = &Наименование
		|	И Свойства.ЭтоГруппа = &ЭтоГруппа
		|
		|УПОРЯДОЧИТЬ ПО
		|	Свойства.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Объект);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("Наименование", Имя);
	Запрос.УстановитьПараметр("ЭтоГруппа", ЭтоГруппа);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Свойства.ПустаяСсылка();

КонецФункции

// Значение реквизита объекта по пути: из применяемого описателя (уже разрешено — ПКО идут
// раньше ПКС) либо из базы по ссылке из снимка базы.
Функция ЗначениеРеквизитаОбъектаПоПути(Путь, ИмяРеквизита, Описатели, СнимокБазы)

	Описатель = Описатели[Путь];
	Если Описатель <> Неопределено И Описатель.Значения[ИмяРеквизита] <> Неопределено Тогда
		Возврат Описатель.Значения[ИмяРеквизита];
	КонецЕсли;

	Ссылка = СнимокБазы.Объекты[Путь];
	Если Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);

КонецФункции

// Тег по наименованию у владельца — конфигурации или регистрации; отсутствующий создаётся:
// это метка разработчика, а не структура конфигурации.
Функция ТегПоИмени(Имя, Контекст)

	Владелец = Контекст.Конфигурация;
	Если Контекст.Вид = "Регистрация" Тогда
		Владелец = Контекст.Единица;
	КонецЕсли;

	Тег = Справочники.Теги.НайтиПоНаименованию(Имя, Истина, , Владелец);
	Если ЗначениеЗаполнено(Тег) Тогда
		Возврат Тег;
	КонецЕсли;

	ТегОбъект = Справочники.Теги.СоздатьЭлемент();
	ТегОбъект.Владелец = Владелец;
	ТегОбъект.Наименование = Имя;
	ТегОбъект.Записать();

	Возврат ТегОбъект.Ссылка;

КонецФункции

Функция ЭлементПоНаименованию(Менеджер, Имя, Владелец, ИмяРеквизита, Описатель, Результат)

	Ссылка = Менеджер.НайтиПоНаименованию(Имя, Истина, , Владелец);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ДобавитьОшибку(Результат, Описатель.Путь,
			СтрШаблон(НСтр("ru = 'Элемент %1 не найден (реквизит %2)'"), Имя, ИмяРеквизита));
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область Запись

Процедура ЗаписатьИзменения(Применяемые, Удаляемые, Описатели, СнимокБазы, Контекст, Результат)

	Записанные = Новый Соответствие;
	// Карты для защиты от двух каталогов на одно правило строятся один раз: проверка в
	// ЗаписатьОбъект должна быть O(1), транзакция уже открыта.
	Карты = Новый Структура;
	Карты.Вставить("ПутиПоСсылке", Новый Соответствие);
	Для Каждого Элемент Из СнимокБазы.Объекты Цикл
		Карты.ПутиПоСсылке.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	Карты.Вставить("ПрименяемыеПути", Новый Соответствие);
	Для Каждого Описатель Из Применяемые Цикл
		Карты.ПрименяемыеПути.Вставить(Описатель.Путь, Истина);
	КонецЦикла;
	Карты.Вставить("ЧислоОдноименных", ЧислоОдноименныхВФайлах(Описатели));

	Для Каждого Описатель Из Применяемые Цикл
		ЗаписатьОбъект(Описатель, Описатели, СнимокБазы, Контекст, Результат, Записанные, Карты);
		Если ЕстьОшибки(Результат) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ПометитьУдаляемые(Удаляемые, СнимокБазы, Контекст, Результат, Записанные);

КонецПроцедуры

// Сколько описателей в файлах разделяют ключ «справочник, владелец, родитель, наименование,
// вид»: для ПКС и ПРО это близнецы, различимые только кодом.
Функция ЧислоОдноименныхВФайлах(Описатели)

	Количества = Новый Соответствие;
	Для Каждого Элемент Из Описатели Цикл
		Описатель = Элемент.Значение;
		Если ПустаяСтрока(Описатель.Профиль.ВторичныйКлюч) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючИмениВФайлах(Описатель);
		Текущее = Количества[Ключ];
		Если Текущее = Неопределено Тогда
			Текущее = 0;
		КонецЕсли;
		Количества.Вставить(Ключ, Текущее + 1);
	КонецЦикла;

	Возврат Количества;

КонецФункции

Функция КлючИмениВФайлах(Описатель)

	Возврат Описатель.Профиль.Справочник + "|" + Описатель.Владелец + "|" + Описатель.Родитель + "|"
		+ НРег(dev_tools_СверкаПравил.НормализоватьИмяКаталога(Описатель.Идентичность)) + "|"
		+ Строка(Описатель.ЭтоГруппа);

КонецФункции

Процедура ЗаписатьОбъект(Описатель, Описатели, СнимокБазы, Контекст, Результат, Записанные, Карты)

	Существующий = СуществующийОбъект(Описатель, Описатели, СнимокБазы, Контекст, Результат, Карты);
	Если ЕстьОшибки(Результат) Тогда
		Возврат;
	КонецЕсли;
	// Два каталога с одним Код (скопировали каталог и забыли убрать Код из JSON) дали бы одно
	// правило: второй описатель молча затёр бы первый. Применяемый каталог ловит Записанные,
	// неизменённый (в Применяемые не входит, но остаётся в файлах) — карта путей снимка базы.
	// Переименованный или перенесённый каталог (старого пути в файлах нет) — не конфликт.
	ЗанятоДругимКаталогом = Ложь;
	Если Существующий <> Неопределено И Не Описатель.ЭтоЕдиница Тогда
		ПутьВБазе = Карты.ПутиПоСсылке[Существующий.Ссылка];
		ЗанятоДругимКаталогом = Записанные[Существующий.Ссылка] <> Неопределено
			Или (ПутьВБазе <> Неопределено И ПутьВБазе <> Описатель.Путь
				И Описатели[ПутьВБазе] <> Неопределено И Карты.ПрименяемыеПути[ПутьВБазе] = Неопределено);
	КонецЕсли;
	Если ЗанятоДругимКаталогом Тогда
		ДобавитьОшибку(Результат, Описатель.Путь, СтрШаблон(
			НСтр("ru = 'Каталог %1 указывает на правило, уже применённое из другого каталога: уберите Код из JSON копии или перенумеруйте правило'"),
			Описатель.Путь));
		Возврат;
	КонецЕсли;
	Если Существующий = Неопределено Тогда
		Объект = НовыйОбъект(Описатель, Описатели, СнимокБазы, Контекст);
		Результат.Создано = Результат.Создано + 1;
	Иначе
		// У единицы строка в базе есть всегда (у новой — заготовка от НаписатьЗаготовкуЕдиницы),
		// но для новой это по смыслу создание, а не обновление — считаем по Контекст.НоваяЕдиница,
		// а не по факту наличия строки.
		Объект = Существующий.Ссылка.ПолучитьОбъект();
		Если Описатель.ЭтоЕдиница И Контекст.НоваяЕдиница Тогда
			Результат.Создано = Результат.Создано + 1;
		Иначе
			Результат.Обновлено = Результат.Обновлено + 1;
		КонецЕсли;
	КонецЕсли;

	// Как штатный загрузчик: обработчики записи, версионирование БСП и захват не срабатывают.
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ПометкаУдаления = Ложь;
	Если Описатель.Профиль.Иерархический И Не Описатель.ЭтоЕдиница Тогда
		Объект.Родитель = РодительПоОписателю(Описатель, Описатели, СнимокБазы, Контекст);
	КонецЕсли;
	ОчиститьРеквизиты(Объект, Описатель);
	ЗаполнитьРеквизиты(Объект, Описатель);
	Если Описатель.ЭтоЕдиница Тогда
		// Релизы — из контекста: у существующей единицы это релизы базы, у новой — по шапке.
		Объект.Конфигурация = Контекст.РелизИсточника;
		Если Контекст.Вид = "Конвертация" Тогда
			Объект.КонфигурацияКорреспондент = Контекст.РелизКорреспондента;
		КонецЕсли;
		Если Контекст.НоваяЕдиница Тогда
			// Заготовка — пустой элемент без родителя и без типа конвертации; довершаем
			// инициализацию, которую раньше (до записи заготовки) делал НовыйОбъект.
			Если Метаданные.Справочники[Описатель.Профиль.Справочник].Реквизиты.Найти("ТипКонвертации") <> Неопределено Тогда
				Объект.ТипКонвертации = Перечисления.ТипыКонвертаций.XML;
			КонецЕсли;
			Если Контекст.Вид = "Конвертация" Тогда
				Объект.Родитель = Справочники.Конвертации.ФорматXML;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Объект.Записать();

	Описатель.Ссылка = Объект.Ссылка;
	Записанные.Вставить(Объект.Ссылка, Истина);

	Если Описатель.ЭтоЕдиница Тогда
		Контекст.Единица = Объект.Ссылка;
		Контекст.НоваяЕдиница = Ложь;
	ИначеЕсли Описатель.Профиль.ВСоставе Тогда
		ВключитьВСостав(Контекст.Единица, Объект.Ссылка, Существующий);
	КонецЕсли;

КонецПроцедуры

// Существующий объект: шапка — ссылка из контекста (у существующей единицы это её ссылка;
// у новой — заготовка от НаписатьЗаготовкуЕдиницы, строка в базе уже есть к этому моменту,
// поэтому объект получается через ПолучитьОбъект, а не СоздатьЭлемент — иначе платформа
// отвергает повторную вставку той же ссылки); изменённый — по пути из снимка базы; новый
// по сверке — по идентичности, включая помеченные и отключённые в составе.
// Возвращает Структура (Ссылка, Состав) или Неопределено.
Функция СуществующийОбъект(Описатель, Описатели, СнимокБазы, Контекст, Результат, Карты)

	Если Описатель.ЭтоЕдиница Тогда
		Возврат Новый Структура("Ссылка, Состав", Контекст.Единица, Неопределено);
	КонецЕсли;

	Ссылка = СнимокБазы.Объекты[Описатель.Путь];
	Если Ссылка <> Неопределено Тогда
		Возврат Новый Структура("Ссылка, Состав", Ссылка, Неопределено);
	КонецЕсли;

	Если Описатель.Профиль.ВСоставе Тогда
		Возврат НайтиВСоставе(Контекст.Единица, Описатель.Профиль, Описатель.Идентичность);
	КонецЕсли;

	Возврат НайтиПодчиненный(Описатель, Описатели, СнимокБазы, Контекст, Результат, Карты);

КонецФункции

Функция НайтиВСоставе(Конвертация, Профиль, Идентичность)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Составы.Ссылка КАК Состав,
		|	Составы.ЭлементКонвертации КАК Правило
		|ИЗ
		|	Справочник.СоставыКонвертаций КАК Составы
		|ГДЕ
		|	Составы.Владелец = &Конвертация
		|	И ВЫРАЗИТЬ(Составы.ЭлементКонвертации КАК Справочник." + Профиль.Справочник + ")." + Профиль.Идентичность + " = &Идентичность
		|
		|УПОРЯДОЧИТЬ ПО
		|	Составы.Отключить,
		|	Составы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("Идентичность", Идентичность);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Ссылка, Состав", Выборка.Правило, Выборка.Состав);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиПодчиненный(Описатель, Описатели, СнимокБазы, Контекст, Результат, Карты)

	Профиль = Описатель.Профиль;
	Владелец = СсылкаПоПути(Описатель.Владелец, Описатели, СнимокБазы, Контекст);

	Если ЗначениеЗаполнено(Описатель.Код) Тогда
		ПоКоду = ПодчиненныеПоКоду(Профиль, Владелец, Описатель.Код);
		Если ПоКоду.Количество() > 1 Тогда
			ДобавитьОшибку(Результат, Описатель.Путь, СтрШаблон(
				НСтр("ru = 'В базе несколько правил с кодом %1 у этого владельца: исправьте нумерацию в базе'"),
				Описатель.Код));
			Возврат Неопределено;
		КонецЕсли;
		Если ПоКоду.Количество() = 1 Тогда
			Если ПоКоду[0].ЭтоГруппа <> Описатель.ЭтоГруппа Тогда
				ДобавитьОшибку(Результат, Описатель.Путь, СтрШаблон(
					НСтр("ru = 'Код %1 у этого владельца занят объектом %2 другого вида: перенумеруйте правило'"),
					Описатель.Код, ПоКоду[0].Ссылка));
				Возврат Неопределено;
			КонецЕсли;
			Возврат Новый Структура("Ссылка, Состав", ПоКоду[0].Ссылка, Неопределено);
		КонецЕсли;
		// Код в базе не найден, а имя в файлах не уникально: это близнецы, и поиск по имени
		// подсунул бы правило соседа. Правило создаётся с кодом из файла.
		ЧислоВФайлах = Карты.ЧислоОдноименных[КлючИмениВФайлах(Описатель)];
		Если ЧислоВФайлах <> Неопределено И ЧислоВФайлах > 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Родитель = Справочники[Профиль.Справочник].ПустаяСсылка();
	Если Не ПустаяСтрока(Описатель.Родитель) Тогда
		Родитель = СсылкаПоПути(Описатель.Родитель, Описатели, СнимокБазы, Контекст);
	КонецЕсли;

	Одноименные = ПодчиненныеПоНаименованию(Профиль, Владелец, Родитель, Описатель);
	Если Одноименные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Одноименные.Количество() > 1 Тогда
		Коды = Новый Массив;
		Для Каждого СтрокаКода Из Одноименные Цикл
			Коды.Добавить(Строка(СтрокаКода.Код));
		КонецЦикла;
		ДобавитьОшибку(Результат, Описатель.Путь, СтрШаблон(
			НСтр("ru = 'В базе несколько правил с наименованием «%1» (коды: %2): укажите Код в файле'"),
			Описатель.Идентичность, СтрСоединить(Коды, ", ")));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Ссылка, Состав", Одноименные[0].Ссылка, Неопределено);

КонецФункции

// Код уникален в пределах владельца по контролю платформы, поэтому родитель в отборе
// не участвует: правило могло переехать между группами, код при этом не меняется.
Функция ПодчиненныеПоКоду(Профиль, Владелец, Код)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.ЭтоГруппа КАК ЭтоГруппа
		|ИЗ
		|	Справочник." + Профиль.Справочник + " КАК Элементы
		|ГДЕ
		|	Элементы.Владелец = &Владелец
		|	И Элементы.Код = &Код";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Код", Код);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

Функция ПодчиненныеПоНаименованию(Профиль, Владелец, Родитель, Описатель)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.Код КАК Код
		|ИЗ
		|	Справочник." + Профиль.Справочник + " КАК Элементы
		|ГДЕ
		|	Элементы.Владелец = &Владелец
		|	И Элементы.Родитель = &Родитель
		|	И Элементы.Наименование = &Наименование
		|	И Элементы.ЭтоГруппа = &ЭтоГруппа
		|
		|УПОРЯДОЧИТЬ ПО
		|	Элементы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("Наименование", Описатель.Идентичность);
	Запрос.УстановитьПараметр("ЭтоГруппа", Описатель.ЭтоГруппа);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// Ссылка объекта по пути: единица для "", записанный в этой загрузке описатель, иначе база.
Функция СсылкаПоПути(Путь, Описатели, СнимокБазы, Контекст)

	Если ПустаяСтрока(Путь) Тогда
		Возврат Контекст.Единица;
	КонецЕсли;
	Описатель = Описатели[Путь];
	Если Описатель <> Неопределено И Описатель.Ссылка <> Неопределено Тогда
		Возврат Описатель.Ссылка;
	КонецЕсли;

	Возврат СнимокБазы.Объекты[Путь];

КонецФункции

// Родитель из пути каталога: пустая ссылка для объекта в корне коллекции.
Функция РодительПоОписателю(Описатель, Описатели, СнимокБазы, Контекст)

	Если ПустаяСтрока(Описатель.Родитель) Тогда
		Возврат Справочники[Описатель.Профиль.Справочник].ПустаяСсылка();
	КонецЕсли;

	Возврат СсылкаПоПути(Описатель.Родитель, Описатели, СнимокБазы, Контекст);

КонецФункции

// Только для не-единиц: у единицы строка в базе уже есть (заготовка или существующая),
// см. СуществующийОбъект — сюда она не попадает.
Функция НовыйОбъект(Описатель, Описатели, СнимокБазы, Контекст)

	Профиль = Описатель.Профиль;
	Менеджер = Справочники[Профиль.Справочник];
	Если Описатель.ЭтоГруппа Тогда
		Объект = Менеджер.СоздатьГруппу();
	Иначе
		Объект = Менеджер.СоздатьЭлемент();
	КонецЕсли;

	Если Профиль.Справочник = "ПравилаКонвертацииСвойств" Или Профиль.Справочник = "ПравилаРегистрацииОбъектов" Тогда
		Объект.Владелец = СсылкаПоПути(Описатель.Владелец, Описатели, СнимокБазы, Контекст);
	КонецЕсли;
	Если Профиль.Иерархический Тогда
		Объект.Родитель = РодительПоОписателю(Описатель, Описатели, СнимокБазы, Контекст);
	КонецЕсли;
	// Запись идёт с ОбменДанными.Загрузка: автонумерации нет, поэтому правило из файла без
	// ключа Код получает код здесь — после владельца, номер в пределах владельца.
	Если Не ПустаяСтрока(Профиль.ВторичныйКлюч) И Не ЗначениеЗаполнено(Описатель.Код) Тогда
		Объект.УстановитьНовыйКод();
	КонецЕсли;

	Если Метаданные.Справочники[Профиль.Справочник].Реквизиты.Найти("ТипКонвертации") <> Неопределено Тогда
		Объект.ТипКонвертации = Перечисления.ТипыКонвертаций.XML;
	КонецЕсли;

	Возврат Объект;

КонецФункции

// Реквизиты иерархических справочников (ПКС, ПРО) могут быть объявлены только для элемента
// или только для группы («Использование» в метаданных) — запись в недоступный для текущего
// вида объекта реквизит бросает исключение платформы («Реквизит недоступен для группы»);
// чтение — нет, поэтому сериализация снимка той же метаданной не задевает.
Функция РеквизитДоступенДляОбъекта(Использование, ЭтоГруппа)

	Если ЭтоГруппа Тогда
		Возврат Использование <> Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента;
	КонецЕсли;

	Возврат Использование <> Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы;

КонецФункции

// Отсутствие ключа в JSON означает пустое значение: все хранимые реквизиты и ТЧ обнуляются
// перед заполнением. Релизы существующей единицы — истина базы, их не трогаем.
Процедура ОчиститьРеквизиты(Объект, Описатель)

	Профиль = Описатель.Профиль;
	МетаданныеСправочника = Объект.Метаданные();

	Для Каждого Реквизит Из МетаданныеСправочника.Реквизиты Цикл
		Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Описатель.ЭтоЕдиница И (Реквизит.Имя = "Конфигурация" Или Реквизит.Имя = "КонфигурацияКорреспондент") Тогда
			Продолжить;
		КонецЕсли;
		Если Не РеквизитДоступенДляОбъекта(Реквизит.Использование, Описатель.ЭтоГруппа) Тогда
			Продолжить;
		КонецЕсли;
		Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			// ОписаниеТипов.ПривестиЗначение(Неопределено) для ХранилищеЗначения не даёт
			// пустого хранилища (платформенный факт) — строим его явно.
			Объект[Реквизит.Имя] = Новый ХранилищеЗначения(Неопределено);
		Иначе
			Объект[Реквизит.Имя] = Реквизит.Тип.ПривестиЗначение(Неопределено);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из МетаданныеСправочника.ТабличныеЧасти Цикл
		Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Не РеквизитДоступенДляОбъекта(ТабличнаяЧасть.Использование, Описатель.ЭтоГруппа) Тогда
			Продолжить;
		КонецЕсли;
		Объект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;

	// У ПКО, ПКПД, Алгоритмов и Запросов «Наименование» не является хранимым реквизитом
	// (ДлинаНаименования = 0 в метаданных) — обращение к нему бросает исключение платформы.
	Если Профиль.Идентичность <> "Наименование" И МетаданныеСправочника.ДлинаНаименования > 0
		И Не dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, "Наименование") Тогда
		Объект.Наименование = "";
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизиты(Объект, Описатель)

	Объект[Описатель.Профиль.Идентичность] = Описатель.Идентичность;
	// У ПКО, ПКПД, Алгоритмов и Запросов «Наименование» не является хранимым реквизитом
	// (ДлинаНаименования = 0) — присваивание бросает исключение платформы, даже если ключ
	// зачем-то попал в JSON (например, задан вручную, а не снимком: снимок его не пишет).
	Если Описатель.Данные["Наименование"] <> Неопределено И Объект.Метаданные().ДлинаНаименования > 0 Тогда
		Объект.Наименование = Описатель.Данные["Наименование"];
	КонецЕсли;
	Если Описатель.Данные["Код"] <> Неопределено Тогда
		Объект.Код = Описатель.Данные["Код"];
	КонецЕсли;

	Для Каждого Значение Из Описатель.Значения Цикл
		Объект[Значение.Ключ] = Значение.Значение;
	КонецЦикла;

	Для Каждого Табличная Из Описатель.Табличные Цикл
		Таблица = Объект[Табличная.Ключ];
		Для Каждого СтрокаЗначений Из Табличная.Значение Цикл
			НоваяСтрока = Таблица.Добавить();
			Для Каждого Колонка Из СтрокаЗначений Цикл
				НоваяСтрока[Колонка.Ключ] = Колонка.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Обработчик Из Описатель.Обработчики Цикл
		Объект[Обработчик.Ключ] = Обработчик.Значение;
	КонецЦикла;

	Для Каждого Дерево Из Описатель.Деревья Цикл
		Объект[Дерево.Ключ] = Новый ХранилищеЗначения(Дерево.Значение);
	КонецЦикла;

КонецПроцедуры

// Новому правилу — строка состава; найденному по идентичности с отключённой или
// помеченной строкой — строка включается обратно.
Процедура ВключитьВСостав(Конвертация, Правило, Существующий)

	Если Существующий <> Неопределено И Существующий.Состав = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Существующий <> Неопределено Тогда
		Состав = Существующий.Состав.ПолучитьОбъект();
	Иначе
		Состав = Справочники.СоставыКонвертаций.СоздатьЭлемент();
		Состав.Владелец = Конвертация;
		Состав.ЭлементКонвертации = Правило;
	КонецЕсли;

	Состав.Отключить = Ложь;
	Состав.ПометкаУдаления = Ложь;
	Состав.ОбменДанными.Загрузка = Истина;
	Состав.Записать();

КонецПроцедуры

// «Нет в файлах»: правило состава отключается в составе и, если больше нигде не состоит,
// помечается на удаление вместе с подчинёнными ПКС; ПКС, ПРО и группы — помечаются сразу.
// Разделяемое правило (состоит и в другом составе) не удаляется и сохраняет свои ПКС —
// пути внутри его каталога пропускаются целиком, даже если сверка перечислила их отдельно.
// Объекты, записанные этой же загрузкой (переезд между каталогами), не трогаются.
Процедура ПометитьУдаляемые(Удаляемые, СнимокБазы, Контекст, Результат, Записанные)

	Сохраняемые = Новый Массив;

	Для Каждого Путь Из Удаляемые Цикл
		Если ПустаяСтрока(Путь) Или ПутьВнутриСохраняемого(Путь, Сохраняемые) Тогда
			Продолжить;
		КонецЕсли;
		Ссылка = СнимокБазы.Объекты[Путь];
		Если Ссылка = Неопределено Или Записанные[Ссылка] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Профиль = dev_tools_ПрофилиПравил.Профиль(Ссылка.Метаданные().Имя);
		Результат.Удалено = Результат.Удалено + 1;

		Если Профиль.ВСоставе Тогда
			ОтключитьВСоставе(Контекст.Единица, Ссылка);
			Если ПравилоВДругихСоставах(Ссылка, Контекст.Единица) Тогда
				Сохраняемые.Добавить(Путь);
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Объект = Ссылка.ПолучитьОбъект();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.УстановитьПометкуУдаления(Истина, Ложь);
		ПометитьПодчиненныеПКС(Объект.Ссылка, Профиль, Записанные);
	КонецЦикла;

КонецПроцедуры

// Путь лежит внутри одного из сохранённых (разделяемых) каталогов — сверка перечисляет
// ПКС такого ПКО отдельными строками «Нет в файлах», но трогать их нельзя (см. ПометитьУдаляемые).
Функция ПутьВнутриСохраняемого(Путь, Сохраняемые)

	Для Каждого Сохраняемый Из Сохраняемые Цикл
		Если СтрНачинаетсяС(Путь, Сохраняемый + "/") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Подчинённые ПКС удаляемого ПКО помечаются явно и каждый со своим флагом «Загрузка»:
// платформенный каскад УстановитьПометкуУдаления(<Пометка>, Истина) пишет подчинённые
// без ОбменДанными.Загрузка — сработали бы ПередЗаписью справочника ПКС и подписки.
// Только у ПКО есть подчинённые (Профиль.Дочерние) — для остальных видов процедура — no-op.
Процедура ПометитьПодчиненныеПКС(Правило, Профиль, Записанные)

	Если Профиль.Дочерние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	// Имя справочника — из профиля (имя метаданных, не пользовательский ввод); параметризовать
	// его нельзя, это допустимое исключение из правила о конкатенации в тексте запроса.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Подчиненные.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + Профиль.Дочерние.Справочник + " КАК Подчиненные
		|ГДЕ
		|	Подчиненные.Владелец = &Правило
		|	И НЕ Подчиненные.ПометкаУдаления";
	Запрос.УстановитьПараметр("Правило", Правило);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Записанные[Выборка.Ссылка] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Подчиненный = Выборка.Ссылка.ПолучитьОбъект();
		Подчиненный.ОбменДанными.Загрузка = Истина;
		Подчиненный.УстановитьПометкуУдаления(Истина, Ложь);
		Записанные.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ОтключитьВСоставе(Конвертация, Правило)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Составы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СоставыКонвертаций КАК Составы
		|ГДЕ
		|	Составы.Владелец = &Конвертация
		|	И Составы.ЭлементКонвертации = &Правило
		|	И НЕ Составы.Отключить";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("Правило", Правило);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Состав = Выборка.Ссылка.ПолучитьОбъект();
		Состав.Отключить = Истина;
		Состав.ОбменДанными.Загрузка = Истина;
		Состав.Записать();
	КонецЦикла;

КонецПроцедуры

Функция ПравилоВДругихСоставах(Правило, Конвертация)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Составы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СоставыКонвертаций КАК Составы
		|ГДЕ
		|	Составы.ЭлементКонвертации = &Правило
		|	И Составы.Владелец <> &Конвертация
		|	И НЕ Составы.Отключить
		|	И НЕ Составы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.УстановитьПараметр("Конвертация", Конвертация);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

#КонецОбласти

#Область Предупреждения

Процедура ДобавитьПредупрежденияОРелизах(Сообщения, СнимокДиска, Единица)

	ТекстШапки = СнимокДиска.Файлы[СнимокДиска.Вид + ".json"];
	Если ТекстШапки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Шапка = Неопределено;
	Попытка
		Шапка = dev_tools_СнимокПравил.ДанныеИзJSON(ТекстШапки);
	Исключение
		Возврат; // Ошибку формата покажет загрузка.
	КонецПопытки;
	Если ТипЗнч(Шапка) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = Новый Массив;
	Реквизиты.Добавить("Конфигурация");
	Если СнимокДиска.Вид = "Конвертация" Тогда
		Реквизиты.Добавить("КонфигурацияКорреспондент");
	КонецЕсли;

	Для Каждого Имя Из Реквизиты Цикл
		ВФайле = Шапка[Имя];
		Если ТипЗнч(ВФайле) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		ВБазе = dev_tools_СнимокПравил.ОписаниеРелиза(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Единица, Имя));
		Если ВФайле["Конфигурация"] <> ВБазе.Конфигурация Или ВФайле["Версия"] <> ВБазе.Версия Тогда
			Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Предупреждение", "",
				СтрШаблон(НСтр("ru = '%1: файлы собраны против %2 %3, в базе %4 %5 — ссылки разрешаются в релизе базы'"),
					Имя, ВФайле["Конфигурация"], ВФайле["Версия"], ВБазе.Конфигурация, ВБазе.Версия)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Снимок базы передаётся вызывающим, если уже построен для сверки, — иначе строится здесь.
Процедура ДобавитьПредупрежденияОРазделяемых(Сообщения, СнимокДиска, Единица, СнимокБазы)

	Если СнимокДиска.Вид <> "Конвертация" Тогда
		Возврат;
	КонецЕсли;

	СнимокЕдиницы = СнимокБазы;
	Если СнимокЕдиницы = Неопределено Тогда
		СнимокЕдиницы = dev_tools_СнимокПравил.СнимокКонвертации(Единица);
	КонецЕсли;
	Для Каждого Объект Из СнимокЕдиницы.Объекты Цикл
		Если ПустаяСтрока(Объект.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Профиль = dev_tools_ПрофилиПравил.Профиль(Объект.Значение.Метаданные().Имя);
		Если Не Профиль.ВСоставе Тогда
			Продолжить;
		КонецЕсли;
		Если ПравилоВДругихСоставах(Объект.Значение, Единица) Тогда
			Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Предупреждение", Объект.Ключ,
				НСтр("ru = 'Правило входит в состав и других конвертаций: перезапись затронет и их'")));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

Процедура ДобавитьОшибку(Результат, Объект, Текст)

	Результат.Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Ошибка", Объект, Текст));

КонецПроцедуры

#КонецОбласти
