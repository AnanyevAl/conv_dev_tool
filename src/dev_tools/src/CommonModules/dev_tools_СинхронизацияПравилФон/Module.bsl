#Область ПрограммныйИнтерфейс

// Фоновая сверка единиц (спека 2026-10-31-background-operations, §2.4).
//
// Снимок с диска приходит значением в задании: временное хранилище сеанса формы
// сеансу фонового задания недоступно.
//
// Параметры:
//  Задания - Массив из Структура - Репозиторий, Вид, Единица, ИмяКаталога,
//            СнимокДиска (см. dev_tools_СверкаПравил.НовыйСнимок), Ветка, Представление.
//
// Возвращаемое значение:
//  Массив из Структура - ответы dev_tools_СинхронизацияПравилВызовСервера.Сверить в порядке заданий.
Функция Сверить(Задания) Экспорт

	Ответы = Новый Массив;
	Для Индекс = 0 По Задания.ВГраница() Цикл
		Задание = Задания[Индекс];
		СообщитьПрогресс(НСтр("ru = 'Сверка'"), Индекс, Задания.Количество(), Задание.Представление);
		Ответы.Добавить(dev_tools_СинхронизацияПравилВызовСервера.Сверить(Задание.Репозиторий,
			Задание.Вид, Задание.Единица, Задание.ИмяКаталога, Задание.СнимокДиска, Задание.Ветка));
	КонецЦикла;

	Возврат Ответы;

КонецФункции

// Фоновая загрузка единиц: каждая — своей транзакцией фасада; исключение одной единицы
// становится её неуспешным результатом, остальные загружаются.
//
// Параметры:
//  Задания - Массив из Структура - поля задания сверки плюс ОтмеченныеПути.
//
// Возвращаемое значение:
//  Массив из Структура - см. dev_tools_ЗагрузкаПравил.НовыйРезультат, в порядке заданий.
Функция Загрузить(Задания) Экспорт

	Результаты = Новый Массив;
	Для Индекс = 0 По Задания.ВГраница() Цикл
		Задание = Задания[Индекс];
		СообщитьПрогресс(НСтр("ru = 'Загрузка'"), Индекс, Задания.Количество(), Задание.Представление);
		Попытка
			Результат = dev_tools_СинхронизацияПравилВызовСервера.Загрузить(Задание.Репозиторий,
				Задание.Вид, Задание.Единица, Задание.ИмяКаталога, Задание.СнимокДиска,
				Задание.ОтмеченныеПути, Задание.Ветка);
		Исключение
			Результат = dev_tools_ЗагрузкаПравил.НовыйРезультат();
			Результат.Сообщения.Добавить(dev_tools_СверкаПравил.НовоеСообщение("Ошибка", "",
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		Результаты.Добавить(Результат);
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Фоновая подготовка выгрузки: снимок базы, его хеши и объекты, которые выгрузка затрёт.
//
// Параметры:
//  Задания - Массив из Структура - Репозиторий, Вид, Единица, ИмяКаталога,
//            СнимокДиска (см. dev_tools_СверкаПравил.НовыйСнимок), Представление.
//
// Возвращаемое значение:
//  Массив из Структура - Снимок (см. dev_tools_СверкаПравил.НовыйСнимок, без карты объектов),
//   Хеши (Соответствие), Пути (Массив из Строка, см. dev_tools_СверкаПравил.НеЗагруженныеОбъекты).
Функция ПодготовитьВыгрузку(Задания) Экспорт

	Результаты = Новый Массив;
	Для Индекс = 0 По Задания.ВГраница() Цикл
		Задание = Задания[Индекс];
		СообщитьПрогресс(НСтр("ru = 'Подготовка выгрузки'"), Индекс, Задания.Количество(),
			Задание.Представление);
		Снимок = СнимокЕдиницы(Задание.Вид, Задание.Единица);
		Снимок.Объекты = Новый Соответствие;
		Хеши = dev_tools_СверкаПравил.ХешиФайлов(Снимок);
		Пути = dev_tools_СверкаПравил.НеЗагруженныеОбъекты(Хеши,
			dev_tools_СверкаПравил.ХешиФайлов(Задание.СнимокДиска),
			dev_tools_ТочкиСинхронизации.ХешиТочки(Задание.Репозиторий, Задание.Единица, Задание.ИмяКаталога));
		Результаты.Добавить(Новый Структура("Снимок, Хеши, Пути", Снимок, Хеши, Пути));
	КонецЦикла;

	Возврат Результаты;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьПрогресс(Операция, Индекс, Всего, Представление)

	ДлительныеОперации.СообщитьПрогресс(Цел(Индекс * 100 / Всего),
		СтрШаблон(НСтр("ru = '%1: %2 из %3 — %4'"), Операция, Индекс + 1, Всего, Представление));

КонецПроцедуры

Функция СнимокЕдиницы(Вид, Единица)

	Если Вид = "Регистрация" Тогда
		Возврат dev_tools_СнимокПравил.СнимокРегистрации(Единица);
	КонецЕсли;

	Возврат dev_tools_СнимокПравил.СнимокКонвертации(Единица);

КонецФункции

#КонецОбласти
