#Область ПрограммныйИнтерфейс

// Точка синхронизации единицы в репозитории (спека 2026-10-31, §3.3; спека
// 2026-10-31-point-directory-and-edt-path, А.2).
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
//  ИмяКаталога - Строка - каталог единицы, с которым идёт работа; точка другого каталога
//                не применяется.
//
// Возвращаемое значение:
//  Структура, Неопределено - Хеши (Соответствие, см. dev_tools_СверкаПравил.ТочкаПослеСверки),
//   Дата (Дата), Ветка (Строка), ИмяКаталога (Строка); Неопределено — точки нет, хранилище
//   нечитаемо или точка записана для другого каталога: худший исход — строки «неизвестно»,
//   а не исключение.
Функция Прочитать(Репозиторий, Единица, ИмяКаталога) Экспорт

	Запись = РегистрыСведений.dev_tools_ТочкиСинхронизации.СоздатьМенеджерЗаписи();
	Запись.Репозиторий = Репозиторий;
	Запись.Единица = Единица;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НРег(Запись.ИмяКаталога) <> НРег(ИмяКаталога) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Хеши = Запись.Хеши.Получить();
	Исключение
		Хеши = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Хеши) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Хеши, Дата, Ветка, ИмяКаталога", Хеши, Запись.Дата, Запись.Ветка,
		Запись.ИмяКаталога);

КонецФункции

// Записывает точку, заменяя прежнюю; дата — текущая дата сеанса.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
//  ИмяКаталога - Строка - каталог единицы, для которого записана точка.
//  Хеши - Соответствие - путь файла → хеш или dev_tools_СверкаПравил.НеизвестнаяВерсия().
//  Ветка - Строка - ветка рабочей копии; пусто — не определена.
Процедура Записать(Репозиторий, Единица, ИмяКаталога, Хеши, Ветка) Экспорт

	Запись = РегистрыСведений.dev_tools_ТочкиСинхронизации.СоздатьМенеджерЗаписи();
	Запись.Репозиторий = Репозиторий;
	Запись.Единица = Единица;
	Запись.Хеши = Новый ХранилищеЗначения(Хеши, Новый СжатиеДанных(9));
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Ветка = Ветка;
	Запись.ИмяКаталога = ИмяКаталога;
	Запись.Записать();

КонецПроцедуры

// Удаляет точку единицы в репозитории; отсутствие точки — не ошибка.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации
Процедура Удалить(Репозиторий, Единица) Экспорт

	Набор = РегистрыСведений.dev_tools_ТочкиСинхронизации.СоздатьНаборЗаписей();
	Набор.Отбор.Репозиторий.Установить(Репозиторий);
	Набор.Отбор.Единица.Установить(Единица);
	Набор.Записать();

КонецПроцедуры

// Даты и ветки точек всех единиц репозитория — для колонки «Точка» таблицы единиц.
// Хеши не читаются: на каждой единице это сотни килобайт.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//
// Возвращаемое значение:
//  Соответствие - единица → Структура: Дата (Дата), Ветка (Строка), ИмяКаталога (Строка).
Функция ТочкиРепозитория(Репозиторий) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Точки.Единица КАК Единица,
		|	Точки.Дата КАК Дата,
		|	Точки.Ветка КАК Ветка,
			|	Точки.ИмяКаталога КАК ИмяКаталога
		|ИЗ
		|	РегистрСведений.dev_tools_ТочкиСинхронизации КАК Точки
		|ГДЕ
		|	Точки.Репозиторий = &Репозиторий";
	Запрос.УстановитьПараметр("Репозиторий", Репозиторий);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Точки = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Точки.Вставить(Выборка.Единица, Новый Структура("Дата, Ветка, ИмяКаталога", Выборка.Дата, Выборка.Ветка,
			Выборка.ИмяКаталога));
	КонецЦикла;

	Возврат Точки;

КонецФункции

// Хеши общей версии, с которыми сверяется единица (спека 2026-10-31, §3.1): единица, которой
// в базе нет, — с пустой точкой; без репозитория или без точки — Неопределено.
//
// Параметры:
//  Репозиторий - СправочникСсылка.dev_tools_РепозиторииПравил
//  Единица - СправочникСсылка.Конвертации, СправочникСсылка.Регистрации, Неопределено
//  ИмяКаталога - Строка
//
// Возвращаемое значение:
//  Соответствие, Неопределено
Функция ХешиТочки(Репозиторий, Единица, ИмяКаталога) Экспорт

	Если Не ЗначениеЗаполнено(Единица) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Репозиторий) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сохранённая = Прочитать(Репозиторий, Единица, ИмяКаталога);
	Если Сохранённая = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сохранённая.Хеши;

КонецФункции

