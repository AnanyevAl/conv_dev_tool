#Область ПрограммныйИнтерфейс

// Снимок конвертации из базы: шапка, обработчики, правила состава с дочерними ПКС.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
Функция СнимокКонвертации(Конвертация) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Конвертация, "Наименование");

	Снимок = dev_tools_СверкаПравил.НовыйСнимок("Конвертация", Реквизиты.Наименование);
	Раскладка = НоваяРаскладка();

	ДобавитьОбъект(Снимок, Раскладка, "", Конвертация.ПолучитьОбъект(),
		dev_tools_ПрофилиПравил.Профиль("Конвертации"));
	ДобавитьПравилаКонвертации(Снимок, Раскладка, Конвертация);
	ПроверитьРаскладку(Раскладка);

	Возврат Снимок;

КонецФункции

// Снимок регистрации из базы: шапка и ПРО с группами.
//
// Параметры:
//  Регистрация - СправочникСсылка.Регистрации
//
// Возвращаемое значение:
//  Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
Функция СнимокРегистрации(Регистрация) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Регистрация, "Наименование");

	Снимок = dev_tools_СверкаПравил.НовыйСнимок("Регистрация", Реквизиты.Наименование);
	Раскладка = НоваяРаскладка();

	ДобавитьОбъект(Снимок, Раскладка, "", Регистрация.ПолучитьОбъект(),
		dev_tools_ПрофилиПравил.Профиль("Регистрации"));
	ДобавитьПравилаРегистрации(Снимок, Раскладка, Регистрация);
	ПроверитьРаскладку(Раскладка);

	Возврат Снимок;

КонецФункции

// Текст JSON с переносами и отступами, переводы строк LF, перевод строки в конце файла.
//
// Параметры:
//  Данные - Структура, Соответствие, Массив - сериализуемые данные.
//
// Возвращаемое значение:
//  Строка
Функция ТекстJSON(Данные) Экспорт

	Запись = Новый ЗаписьJSON;
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ", Истина, ЭкранированиеСимволовJSON.Нет);
	Запись.УстановитьСтроку(Параметры);
	ЗаписатьJSON(Запись, Данные);

	Возврат dev_tools_СверкаПравил.НормализоватьПереводыСтрок(Запись.Закрыть()) + Символы.ПС;

КонецФункции

// Разбор JSON в соответствие (ключи — как в файле, вложенные объекты — соответствия).
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Соответствие
Функция ДанныеИзJSON(Текст) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

// Имя значения перечисления по метаданным.
//
// Параметры:
//  Значение - ПеречислениеСсылка
//
// Возвращаемое значение:
//  Строка
Функция ИмяЗначенияПеречисления(Значение) Экспорт

	МетаданныеПеречисления = Значение.Метаданные();
	Индекс = Перечисления[МетаданныеПеречисления.Имя].Индекс(Значение);

	Возврат МетаданныеПеречисления.ЗначенияПеречисления.Получить(Индекс).Имя;

КонецФункции

// Значение реквизита в представлении для JSON. Пустые значения — Неопределено (не пишутся).
//
// Параметры:
//  Значение - Произвольный
//  ОписаниеТипов - ОписаниеТипов - тип реквизита; у составного типа ссылка на объект
//                  метаданных заворачивается в {"Объект": имя}, чтобы отличаться от строки.
//
// Возвращаемое значение:
//  Строка, Число, Булево, Структура, Неопределено
Функция ЗначениеДляJSON(Значение, ОписаниеТипов) Экспорт

	Тип = ТипЗнч(Значение);

	// ЗначениеЗаполнено() считает Булево заполненным всегда, включая Ложь (платформенный
	// факт, проверено на этой машине) — здесь действует другое правило: Ложь не пишется,
	// как и остальные пустые значения, поэтому Булево обрабатывается отдельно.
	Если Тип = Тип("Булево") Тогда
		Если Значение Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Тип = Тип("Строка") Или Тип = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат ЗаписатьДатуJSON(Значение, ФорматДатыJSON.ISO);
	ИначеЕсли Тип = Тип("СправочникСсылка.Релизы") Тогда
		Возврат ОписаниеРелиза(Значение);
	ИначеЕсли Тип = Тип("СправочникСсылка.Объекты") Тогда
		Имя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "Наименование");
		Если ОписаниеТипов.Типы().Количество() > 1 Тогда
			Возврат Новый Структура("Объект", Имя);
		КонецЕсли;
		Возврат Имя;
	ИначеЕсли Тип = Тип("СправочникСсылка.Свойства") Тогда
		Возврат ПутьСвойства(Значение);
	ИначеЕсли Тип = Тип("СправочникСсылка.Теги")
		Или Тип = Тип("СправочникСсылка.УсловияПримененияПравил")
		Или Тип = Тип("СправочникСсылка.ДополнительныеМодули") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "Наименование");
	ИначеЕсли Метаданные.Перечисления.Содержит(Значение.Метаданные()) Тогда
		Возврат ИмяЗначенияПеречисления(Значение);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Сериализация значений типа %1 не поддерживается'"), Тип);

КонецФункции

// Дерево из хранилища значения в массив строк для JSON; Неопределено — дерева нет.
//
// Параметры:
//  Хранилище - ХранилищеЗначения - хранилище с деревом отбора или иным значением.
//
// Возвращаемое значение:
//  Массив, Неопределено
Функция ДеревоВJSON(Хранилище) Экспорт

	// Групповые объекты не заполняют реквизит-дерево: значение остаётся Неопределено,
	// а не пустым ХранилищеЗначения (платформенный факт, проверено на этой машине).
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Дерево = Хранилище.Получить();
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Или Дерево.Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокиДереваВJSON(Дерево.Строки, Дерево.Колонки);

КонецФункции

// Дерево отбора ПРО из массива строк JSON. Колонки — как хранит форма правила регистрации.
//
// Параметры:
//  Строки - Массив из Соответствие - строки дерева из JSON (вложенные — в ключе "Строки").
//  ИмяРеквизита - Строка - "ОтборПоСвойствамОбъекта" или "ОтборПоСвойствамПланаОбмена".
//
// Возвращаемое значение:
//  ДеревоЗначений
Функция ДеревоОтбораИзJSON(Строки, ИмяРеквизита) Экспорт

	Дерево = Новый ДеревоЗначений;
	Колонки = Дерево.Колонки;
	Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Если ИмяРеквизита = "ОтборПоСвойствамПланаОбмена" Тогда
		Колонки.Добавить("СвойствоОбъекта");
		Колонки.Добавить("ЭтоСтрокаКонстанты", Новый ОписаниеТипов("Булево"));
		Колонки.Добавить("СвойствоПланаОбмена", Новый ОписаниеТипов("Строка"));
	Иначе
		Колонки.Добавить("СвойствоОбъекта", Новый ОписаниеТипов("Строка"));
		Колонки.Добавить("ВидЭлементаОтбора", Новый ОписаниеТипов("Строка"));
		Колонки.Добавить("ЗначениеКонстанты");
	КонецЕсли;
	Колонки.Добавить("ВидСравнения", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСравнения"));
	Колонки.Добавить("БулевоЗначениеГруппы", Новый ОписаниеТипов("ПеречислениеСсылка.БулевыОперации"));
	Колонки.Добавить("ТипСвойстваОбъекта", Новый ОписаниеТипов("Строка"));

	ЗаполнитьСтрокиДерева(Дерево.Строки, Строки, Колонки);

	Возврат Дерево;

КонецФункции

// Описание релиза для файла: имя конфигурации и версия.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Структура - Конфигурация, Версия.
Функция ОписаниеРелиза(Релиз) Экспорт

	// Ключ структуры — псевдоним поля результата, значение — путь к полю (БСП допускает точку).
	Поля = Новый Структура("Конфигурация, Версия", "КонфигурацияВладелец.Наименование", "Версия");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Релиз, Поля);

	Возврат Новый Структура("Конфигурация, Версия", Реквизиты.Конфигурация, Реквизиты.Версия);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кладёт в снимок JSON объекта и файлы его обработчиков; проверяет коллизию имён каталогов.
//
// Параметры:
//  Снимок - Структура - см. dev_tools_СверкаПравил.НовыйСнимок.
//  Раскладка - Структура - занятые каталоги и накопленные конфликты; общая на весь снимок,
//              в снимок не входит (см. НоваяРаскладка).
//  КаталогОбъекта - Строка - каталог объекта относительно единицы.
//  Объект - СправочникОбъект - объект правил.
//  Профиль - Структура - см. dev_tools_ПрофилиПравил.НовыйПрофиль.
Процедура ДобавитьОбъект(Снимок, Раскладка, КаталогОбъекта, Объект, Профиль)

	ПроверитьКоллизиюКаталога(Раскладка, КаталогОбъекта, Объект);

	Описание = ОписаниеОбъектаJSON(Объект, Профиль);

	ИмяJSON = Профиль.Вид;
	Если Профиль.Иерархический И Объект.ЭтоГруппа Тогда
		ИмяJSON = "Группа";
	КонецЕсли;

	Снимок.Файлы.Вставить(dev_tools_СверкаПравил.СоединитьПуть(КаталогОбъекта, ИмяJSON + ".json"),
		ТекстJSON(Описание.Данные));
	Для Каждого Обработчик Из Описание.Обработчики Цикл
		Снимок.Файлы.Вставить(dev_tools_СверкаПравил.СоединитьПуть(КаталогОбъекта, Обработчик.Ключ),
			Обработчик.Значение);
	КонецЦикла;
	Снимок.Объекты.Вставить(КаталогОбъекта, Объект.Ссылка);

КонецПроцедуры

// Раскладка снимка: занятые каталоги и накопленные конфликты. Конфликты копятся,
// а не бросаются сразу, чтобы пользователь увидел их все за один прогон.
Функция НоваяРаскладка()

	Возврат Новый Структура("Каталоги, Коллизии", Новый Соответствие, Новый Массив);

КонецФункции

Процедура ПроверитьРаскладку(Раскладка)

	Если Раскладка.Коллизии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Разные объекты попадают в один каталог — переименуйте их:'")
		+ Символы.ПС + СтрСоединить(Раскладка.Коллизии, Символы.ПС);

КонецПроцедуры

// Каталоги — соответствие «каталог в нижнем регистре → ссылка»: один поиск и вставка
// вместо перебора всех занятых каталогов.
Процедура ПроверитьКоллизиюКаталога(Раскладка, КаталогОбъекта, Объект)

	Ключ = НРег(КаталогОбъекта);
	Существующий = Раскладка.Каталоги[Ключ];
	Если Существующий <> Неопределено Тогда
		Раскладка.Коллизии.Добавить(СтрШаблон(НСтр("ru = '%1: %2 и %3'"),
			КаталогОбъекта, Существующий, Объект.Ссылка));
		Возврат;
	КонецЕсли;
	Раскладка.Каталоги.Вставить(Ключ, Объект.Ссылка);

КонецПроцедуры

// Реквизиты и ТЧ объекта в структуру для JSON, обработчики — отдельно.
Функция ОписаниеОбъектаJSON(Объект, Профиль)

	МетаданныеОбъекта = Объект.Метаданные();
	Данные = Новый Структура;
	Обработчики = Новый Соответствие;

	Если Профиль.Единица Тогда
		Данные.Вставить("ВерсияФормата", 2);
	КонецЕсли;

	Данные.Вставить(Профиль.Идентичность, Объект[Профиль.Идентичность]);
	Если Профиль.Идентичность = "Код" Тогда
		// У ПКО, ПКПД, Алгоритмов и Запросов реквизита «Наименование» нет вовсе (длина 0
		// в метаданных) — обращение к несуществующему реквизиту бросает исключение платформы.
		Если МетаданныеОбъекта.ДлинаНаименования > 0 Тогда
			ДобавитьЗначение(Данные, "Наименование", Объект.Наименование, Профиль);
		КонецЕсли;
	Иначе
		ДобавитьЗначение(Данные, "Код", Объект.Код, Профиль);
	КонецЕсли;

	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Значение = Объект[Реквизит.Имя];

		ИмяФайла = Профиль.Обработчики[Реквизит.Имя];
		Если ИмяФайла <> Неопределено Тогда
			Текст = dev_tools_СверкаПравил.НормализоватьПереводыСтрок(Значение);
			Если Не ПустаяСтрока(Текст) Тогда
				Обработчики.Вставить(ИмяФайла, Текст);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Профиль.Деревья.Найти(Реквизит.Имя) <> Неопределено Тогда
			Дерево = ДеревоВJSON(Значение);
			Если Дерево <> Неопределено Тогда
				Данные.Вставить(Реквизит.Имя, Дерево);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		ЗначениеJSON = ЗначениеДляJSON(Значение, Реквизит.Тип);
		Если ЗначениеJSON <> Неопределено Тогда
			Данные.Вставить(Реквизит.Имя, ЗначениеJSON);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Для Каждого Строка Из Объект[ТабличнаяЧасть.Имя] Цикл
			СтрокаJSON = Новый Структура;
			Для Каждого Колонка Из ТабличнаяЧасть.Реквизиты Цикл
				Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, Колонка.Имя) Тогда
					Продолжить;
				КонецЕсли;
				ЗначениеJSON = ЗначениеДляJSON(Строка[Колонка.Имя], Колонка.Тип);
				Если ЗначениеJSON <> Неопределено Тогда
					СтрокаJSON.Вставить(Колонка.Имя, ЗначениеJSON);
				КонецЕсли;
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Если Строки.Количество() > 0 Тогда
			Данные.Вставить(ТабличнаяЧасть.Имя, Строки);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Данные, Обработчики", Данные, Обработчики);

КонецФункции

Процедура ДобавитьЗначение(Данные, Имя, Значение, Профиль)

	Если dev_tools_ПрофилиПравил.ПропускатьРеквизит(Профиль, Имя) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) Тогда
		Данные.Вставить(Имя, Значение);
	КонецЕсли;

КонецПроцедуры

// Путь свойства внутри объекта: "Артикул" или "Товары.Номенклатура".
Функция ПутьСвойства(Свойство)

	Поля = Новый Структура("Наименование, Группа", "Наименование", "Родитель.Наименование");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Свойство, Поля);
	Если Не ЗначениеЗаполнено(Реквизиты.Группа) Тогда
		Возврат Реквизиты.Наименование;
	КонецЕсли;

	Возврат Реквизиты.Группа + "." + Реквизиты.Наименование;

КонецФункции

Функция СтрокиДереваВJSON(Строки, Колонки)

	// Порядок колонок в самом ДеревоЗначений после ХранилищеЗначения.Получить() не совпадает
	// с порядком их объявления (платформенный факт, проверено на этой машине) — без
	// стабильной сортировки один и тот же снимок сериализовался бы по-разному от раза
	// к разу, что ломает детерминизм снимка и побайтовую сверку.
	ИменаКолонок = Новый СписокЗначений;
	Для Каждого Колонка Из Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	ИменаКолонок.СортироватьПоЗначению();

	Результат = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Элемент = Новый Структура;
		Для Каждого ЭлементИмени Из ИменаКолонок Цикл
			ИмяКолонки = ЭлементИмени.Значение;
			ЗначениеJSON = ЗначениеДляJSON(Строка[ИмяКолонки], Колонки.Найти(ИмяКолонки).ТипЗначения);
			Если ЗначениеJSON <> Неопределено Тогда
				Элемент.Вставить(ИмяКолонки, ЗначениеJSON);
			КонецЕсли;
		КонецЦикла;
		Если Строка.Строки.Количество() > 0 Тогда
			Элемент.Вставить("Строки", СтрокиДереваВJSON(Строка.Строки, Колонки));
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьСтрокиДерева(СтрокиДерева, СтрокиJSON, Колонки)

	Если СтрокиJSON = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЭтоДеревоПланаОбмена = Колонки.Найти("ЭтоСтрокаКонстанты") <> Неопределено;
	Для Каждого СтрокаJSON Из СтрокиJSON Цикл
		Строка = СтрокиДерева.Добавить();
		ТипКонстанты = Неопределено;
		Если СтрокаСодержитКонстанту(СтрокаJSON, ЭтоДеревоПланаОбмена) Тогда
			ТипКонстанты = СтрокаJSON["ТипСвойстваОбъекта"];
		КонецЕсли;
		Для Каждого Колонка Из Колонки Цикл
			Значение = СтрокаJSON[Колонка.Имя];
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Строка[Колонка.Имя] = ЗначениеКолонкиДерева(Значение, Колонка, ТипКонстанты);
		КонецЦикла;
		ЗаполнитьСтрокиДерева(Строка.Строки, СтрокаJSON["Строки"], Колонки);
	КонецЦикла;

КонецПроцедуры

// ТипСвойстваОбъекта — тип реквизита объекта, а не значения нетипизированной колонки:
// типом значения он становится только у строки-константы. Иначе в колонке строка —
// имя реквизита (дерево плана обмена, ЭтоСтрокаКонстанты = Ложь) или текст алгоритма
// (дерево объекта, ВидЭлементаОтбора = "АлгоритмЗначения"). Пустой вид элемента штатная
// загрузка считает константой — ЗагрузкаПравилРегистрацииОбъектов/ObjectModule.bsl:530-547.
Функция СтрокаСодержитКонстанту(СтрокаJSON, ЭтоДеревоПланаОбмена)

	Если ЭтоДеревоПланаОбмена Тогда
		Возврат СтрокаJSON["ЭтоСтрокаКонстанты"] = Истина;
	КонецЕсли;

	ВидЭлемента = СтрокаJSON["ВидЭлементаОтбора"];
	Возврат ВидЭлемента = Неопределено Или ВидЭлемента = "" Или ВидЭлемента = "ЗначениеКонстанты";

КонецФункции

// Константы отбора — примитивы; дата в JSON — строка ISO, восстанавливается по типу константы.
// ТипКонстанты - Строка, Неопределено - Неопределено, если строка дерева константы не содержит.
Функция ЗначениеКолонкиДерева(Значение, Колонка, ТипКонстанты)

	Если Колонка.ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.ВидыСравнения")) Тогда
		Возврат Перечисления.ВидыСравнения[Значение];
	ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.БулевыОперации")) Тогда
		Возврат Перечисления.БулевыОперации[Значение];
	КонецЕсли;

	// Дата — только у колонки-константы без объявленного типа: "ЗначениеКонстанты" в дереве
	// объекта, "СвойствоОбъекта" в дереве плана обмена (штатная выгрузка форматирует
	// Правило.СвойствоОбъекта как Булево/Число/Дату — ВыгрузкаРегистрации/ManagerModule.bsl:596-620).
	// Одноимённая "СвойствоОбъекта" дерева объекта типизирована Строкой и под правило не
	// попадает — платформенный факт, проверено на этой машине
	// ("Представление даты имеет неверный формат").
	Если Колонка.ТипЗначения.Типы().Количество() = 0 И ТипЗнч(Значение) = Тип("Строка") И ТипКонстанты = "Дата" Тогда
		Возврат ПрочитатьДатуJSON(Значение, ФорматДатыJSON.ISO);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Правила действующего состава конвертации и их дочерние ПКС.
Процедура ДобавитьПравилаКонвертации(Снимок, Раскладка, Конвертация)

	Для Каждого Правило Из ПравилаСостава(Конвертация) Цикл
		Профиль = dev_tools_ПрофилиПравил.Профиль(Правило.Метаданные().Имя);
		Объект = Правило.ПолучитьОбъект();
		Каталог = dev_tools_СверкаПравил.СоединитьПуть(Профиль.Каталог,
			dev_tools_СверкаПравил.НормализоватьИмяКаталога(Объект[Профиль.Идентичность]));
		ДобавитьОбъект(Снимок, Раскладка, Каталог, Объект, Профиль);

		Если Профиль.Дочерние <> Неопределено Тогда
			ПрофильДочерних = dev_tools_ПрофилиПравил.Профиль(Профиль.Дочерние.Справочник);
			ДобавитьЭлементыИерархии(Снимок, Раскладка,
				dev_tools_СверкаПравил.СоединитьПуть(Каталог, Профиль.Дочерние.Каталог),
				Правило, Справочники[ПрофильДочерних.Справочник].ПустаяСсылка(), ПрофильДочерних);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ссылки правил действующего состава: не отключённые, не помеченные на удаление.
Функция ПравилаСостава(Конвертация)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Составы.ЭлементКонвертации КАК Правило
		|ИЗ
		|	Справочник.СоставыКонвертаций КАК Составы
		|ГДЕ
		|	Составы.Владелец = &Конвертация
		|	И НЕ Составы.Отключить
		|	И НЕ Составы.ПометкаУдаления
		|	И НЕ Составы.ЭлементКонвертации.ПометкаУдаления";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Правила = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Правило) Тогда
			Правила.Добавить(Выборка.Правило);
		КонецЕсли;
	КонецЦикла;

	Возврат Правила;

КонецФункции

// Элементы иерархического справочника по владельцу и родителю: элементы и группы,
// группы — рекурсивно в свои подкаталоги.
Процедура ДобавитьЭлементыИерархии(Снимок, Раскладка, Каталог, Владелец, Родитель, Профиль)

	Запрос = Новый Запрос;
	// Имя справочника — из профиля (имя метаданных, не пользовательский ввод); параметризовать
	// его нельзя, это допустимое исключение из правила о конкатенации в тексте запроса.
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Элементы.Ссылка КАК Ссылка,
		|	Элементы.ЭтоГруппа КАК ЭтоГруппа,
		|	Элементы.Наименование КАК Наименование,
		|	Элементы.Код КАК Код
		|ИЗ
		|	Справочник." + Профиль.Справочник + " КАК Элементы
		|ГДЕ
		|	Элементы.Владелец = &Владелец
		|	И Элементы.Родитель = &Родитель
		|	И НЕ Элементы.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Элементы.Наименование";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Родитель", Родитель);

	РезультатЗапроса = Запрос.Выполнить();
	Соседи = РезультатЗапроса.Выгрузить();
	ИменаКаталогов = ИменаКаталоговСоседей(Соседи, Профиль);

	Для Каждого Сосед Из Соседи Цикл
		Объект = Сосед.Ссылка.ПолучитьОбъект();
		КаталогОбъекта = dev_tools_СверкаПравил.СоединитьПуть(Каталог, ИменаКаталогов[Сосед.Ссылка]);
		ДобавитьОбъект(Снимок, Раскладка, КаталогОбъекта, Объект, Профиль);
		Если Сосед.ЭтоГруппа Тогда
			ДобавитьЭлементыИерархии(Снимок, Раскладка, КаталогОбъекта, Владелец, Сосед.Ссылка, Профиль);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Имена каталогов соседей одного уровня: нормализованное наименование, а у совпавших —
// с суффиксом кода. Сравнение без учёта регистра: файловая система Windows регистр
// не различает. Нечем развести (нет вторичного ключа или код пуст) — имя остаётся
// совпадающим, и конфликт поймает проверка коллизий.
Функция ИменаКаталоговСоседей(Соседи, Профиль)

	Количество = Новый Соответствие;
	Для Каждого Сосед Из Соседи Цикл
		Ключ = НРег(dev_tools_СверкаПравил.НормализоватьИмяКаталога(Сосед.Наименование));
		Текущее = Количество[Ключ];
		Если Текущее = Неопределено Тогда
			Количество.Вставить(Ключ, 1);
		Иначе
			Количество.Вставить(Ключ, Текущее + 1);
		КонецЕсли;
	КонецЦикла;

	Имена = Новый Соответствие;
	Для Каждого Сосед Из Соседи Цикл
		Имя = dev_tools_СверкаПравил.НормализоватьИмяКаталога(Сосед.Наименование);
		Если Количество[НРег(Имя)] > 1 И Не ПустаяСтрока(Профиль.ВторичныйКлюч) Тогда
			Имя = dev_tools_СверкаПравил.ИмяКаталогаОбъекта(Сосед.Наименование, Сосед.Код);
		КонецЕсли;
		Имена.Вставить(Сосед.Ссылка, Имя);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// ПРО регистрации с группами.
Процедура ДобавитьПравилаРегистрации(Снимок, Раскладка, Регистрация)

	Профиль = dev_tools_ПрофилиПравил.Профиль("ПравилаРегистрацииОбъектов");
	ДобавитьЭлементыИерархии(Снимок, Раскладка, Профиль.Каталог, Регистрация,
		Справочники.ПравилаРегистрацииОбъектов.ПустаяСсылка(), Профиль);

КонецПроцедуры

#КонецОбласти
